                        AppStateChirho.chapter-selector-visible-chirho = false;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: ThemeChirho.divider-chirho;
            }

            ScrollView {
                vertical-stretch: 1;

                // Grid of chapter buttons (10 per row)
                VerticalLayout {
                    spacing: 6px;

                    for row-chirho in 16: HorizontalLayout {
                        spacing: 6px;

                        for col-chirho in 10: Rectangle {
                            property <int> chapter-num-chirho: row-chirho * 10 + col-chirho + 1;
                            property <bool> is-valid-chirho: chapter-num-chirho <= AppStateChirho.current-book-chapter-count-chirho;
                            property <bool> is-current-chirho: chapter-num-chirho == AppStateChirho.current-chapter-chirho;

                            width: 32px;
                            height: 32px;
                            background: !is-valid-chirho ? transparent :
                                (is-current-chirho ? ThemeChirho.accent-chirho :
                                (ch-touch-chirho.has-hover ? ThemeChirho.background-elevated-chirho : ThemeChirho.background-tertiary-chirho));
                            border-radius: ThemeChirho.radius-sm-chirho;
                            border-width: is-valid-chirho ? 1px : 0px;
                            border-color: is-current-chirho ? ThemeChirho.accent-chirho : ThemeChirho.border-subtle-chirho;

                            if is-valid-chirho: Text {
                                text: chapter-num-chirho;
                                font-size: ThemeChirho.font-size-sm-chirho;
                                font-weight: is-current-chirho ? 600 : 400;
                                color: is-current-chirho ? white : ThemeChirho.text-primary-chirho;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            ch-touch-chirho := TouchArea {
                                enabled: is-valid-chirho;
                                clicked => {
                                    AppStateChirho.navigate-to-chirho(
                                        AppStateChirho.current-book-chirho,
                                        chapter-num-chirho,
                                        1
                                    );
                                    AppStateChirho.chapter-selector-visible-chirho = false;
                                }
                                mouse-cursor: is-valid-chirho ? pointer : default;
                            }
                        }
                    }
                }
            }
        }
    }

    // Close when clicking outside
    TouchArea {
        enabled: visible-chirho;
        clicked => {
            root.visible-chirho = false;
        }
    }
}

// Note editor dialog component
component NoteDialogChirho inherits Rectangle {
    in-out property <bool> visible-chirho: false;

    width: 100%;
    height: 100%;
    background: visible-chirho ? #00000080 : transparent;

    animate background { duration: 200ms; }

    if visible-chirho: Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 480px;
        height: 320px;
        background: ThemeChirho.background-secondary-chirho;
        border-radius: ThemeChirho.radius-lg-chirho;
        border-width: 1px;
        border-color: ThemeChirho.border-chirho;
        drop-shadow-blur: 20px;
        drop-shadow-color: #00000040;

        VerticalLayout {
            padding: ThemeChirho.spacing-lg-chirho;
            spacing: ThemeChirho.spacing-md-chirho;

            HorizontalLayout {
                Text {
                    text: "Note - " + AppStateChirho.note-verse-ref-chirho;
                    font-size: ThemeChirho.font-size-lg-chirho;
                    font-weight: 600;
                    color: ThemeChirho.text-primary-chirho;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                IconButtonChirho {
                    icon-chirho: LabelsChirho.close-icon-chirho;
                    clicked-chirho => {
                        AppStateChirho.note-dialog-visible-chirho = false;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: ThemeChirho.divider-chirho;
            }

            // Note text area
            Rectangle {
                vertical-stretch: 1;
                background: ThemeChirho.background-tertiary-chirho;
                border-radius: ThemeChirho.radius-md-chirho;
                border-width: 1px;
                border-color: ThemeChirho.border-subtle-chirho;

                VerticalLayout {
                    padding: ThemeChirho.spacing-md-chirho;

                    LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "Enter your note here...";
                        text <=> AppStateChirho.note-content-chirho;
                    }
                }
            }

            HorizontalLayout {
                spacing: ThemeChirho.spacing-md-chirho;
                alignment: end;

                // Delete button
                Rectangle {
                    width: 80px;
                    height: 36px;
                    background: delete-touch-chirho.has-hover ? ThemeChirho.error-chirho : ThemeChirho.background-tertiary-chirho;
                    border-radius: ThemeChirho.radius-md-chirho;
                    border-width: 1px;
                    border-color: ThemeChirho.error-chirho;

                    Text {
                        text: "Delete";
                        font-size: ThemeChirho.font-size-md-chirho;
                        font-weight: 500;
                        color: delete-touch-chirho.has-hover ? white : ThemeChirho.error-chirho;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    delete-touch-chirho := TouchArea {
                        clicked => {
                            AppStateChirho.note-content-chirho = "";
                            AppStateChirho.save-note-chirho(AppStateChirho.note-verse-ref-chirho, "");
                            AppStateChirho.note-dialog-visible-chirho = false;
                        }
                        mouse-cursor: pointer;
                    }
                }

                // Save button
                Rectangle {
                    width: 80px;
                    height: 36px;
                    background: ThemeChirho.accent-chirho;
                    border-radius: ThemeChirho.radius-md-chirho;

                    Text {
                        text: "Save";
                        font-size: ThemeChirho.font-size-md-chirho;
                        font-weight: 500;
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => {
                            AppStateChirho.save-note-chirho(AppStateChirho.note-verse-ref-chirho, AppStateChirho.note-content-chirho);
                            AppStateChirho.note-dialog-visible-chirho = false;
                        }
                        mouse-cursor: pointer;
                    }
                }
            }
        }
    }

    // Close when clicking outside
    TouchArea {
        enabled: visible-chirho;
        clicked => {
            root.visible-chirho = false;
        }
    }
}

// Bookmarks panel component
// History panel component
component HistoryPanelChirho inherits Rectangle {
    in-out property <bool> visible-chirho: false;

    width: 100%;
    height: 100%;
    background: visible-chirho ? #00000080 : transparent;

    animate background { duration: 200ms; }

    if visible-chirho: Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 400px;
        height: 360px;
        background: ThemeChirho.background-secondary-chirho;
        border-radius: ThemeChirho.radius-lg-chirho;
        border-width: 1px;
        border-color: ThemeChirho.border-chirho;
        drop-shadow-blur: 20px;
        drop-shadow-color: #00000040;

        VerticalLayout {
            padding: ThemeChirho.spacing-lg-chirho;
            spacing: ThemeChirho.spacing-md-chirho;

            HorizontalLayout {
                Text {
                    text: "📖 Recent Reading";
                    font-size: ThemeChirho.font-size-lg-chirho;
                    font-weight: 600;
                    color: ThemeChirho.text-primary-chirho;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                IconButtonChirho {
                    icon-chirho: LabelsChirho.close-icon-chirho;
                    clicked-chirho => {
                        AppStateChirho.history-visible-chirho = false;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: ThemeChirho.divider-chirho;
            }

            if AppStateChirho.history-entries-chirho.length == 0: VerticalLayout {
                vertical-stretch: 1;
                alignment: center;

                Text {
                    text: "No reading history yet";
                    font-size: ThemeChirho.font-size-md-chirho;
                    color: ThemeChirho.text-muted-chirho;
                    horizontal-alignment: center;
                }
            }

            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: ThemeChirho.spacing-sm-chirho;

                    for entry-chirho in AppStateChirho.history-entries-chirho: Rectangle {
                        height: 48px;
                        background: hist-touch-chirho.has-hover ? ThemeChirho.background-elevated-chirho : ThemeChirho.background-tertiary-chirho;
                        border-radius: ThemeChirho.radius-md-chirho;

                        animate background { duration: 150ms; }

                        hist-touch-chirho := TouchArea {
                            clicked => {
                                AppStateChirho.navigate-to-chirho(
                                    entry-chirho.book-chirho,
                                    entry-chirho.chapter-chirho,
                                    1
                                );
                                AppStateChirho.history-visible-chirho = false;
                            }
                            mouse-cursor: pointer;
                        }

                        HorizontalLayout {
                            padding: ThemeChirho.spacing-md-chirho;
                            spacing: ThemeChirho.spacing-md-chirho;

                            Text {
                                text: entry-chirho.book-chirho + " " + entry-chirho.chapter-chirho;
                                font-size: ThemeChirho.font-size-md-chirho;
                                font-weight: 500;
                                color: ThemeChirho.text-primary-chirho;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: entry-chirho.timestamp-chirho;
                                font-size: ThemeChirho.font-size-xs-chirho;
                                color: ThemeChirho.text-muted-chirho;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }

    // Close when clicking outside
    TouchArea {
        enabled: visible-chirho;
        clicked => {
            root.visible-chirho = false;
        }
    }
}

// Bookmarks panel component
component BookmarksPanelChirho inherits Rectangle {
    in-out property <bool> visible-chirho: false;

    width: visible-chirho ? 280px : 0px;
    background: ThemeChirho.background-secondary-chirho;
    clip: true;

    animate width { duration: 200ms; easing: ease-out; }

    Rectangle {
        width: 1px;
        height: 100%;
        background: ThemeChirho.border-chirho;
    }

    VerticalLayout {
        padding: ThemeChirho.spacing-lg-chirho;
        spacing: ThemeChirho.spacing-md-chirho;

        HorizontalLayout {
            Text {
                text: "Bookmarks";
                font-size: ThemeChirho.font-size-lg-chirho;
                font-weight: 600;
                color: ThemeChirho.text-primary-chirho;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            IconButtonChirho {
                icon-chirho: LabelsChirho.close-icon-chirho;
                clicked-chirho => {
                    AppStateChirho.bookmarks-visible-chirho = false;
                }
            }
        }

        Rectangle {
            height: 1px;
            background: ThemeChirho.divider-chirho;
        }

        if AppStateChirho.bookmarks-chirho.length == 0: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;

            Text {
                text: "No bookmarks yet";
                font-size: ThemeChirho.font-size-md-chirho;
                color: ThemeChirho.text-muted-chirho;
                horizontal-alignment: center;
            }

            Text {
                text: "Click the bookmark icon on a verse to add one";
                font-size: ThemeChirho.font-size-sm-chirho;
                color: ThemeChirho.text-disabled-chirho;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: ThemeChirho.spacing-sm-chirho;

                for bookmark-chirho in AppStateChirho.bookmarks-chirho: Rectangle {
                    height: 64px;
                    background: bm-touch-chirho.has-hover ? ThemeChirho.background-elevated-chirho : ThemeChirho.background-tertiary-chirho;
                    border-radius: ThemeChirho.radius-md-chirho;

                    animate background { duration: 150ms; easing: ease-out; }

                    bm-touch-chirho := TouchArea {
                        clicked => {
                            AppStateChirho.navigate-to-chirho(
                                bookmark-chirho.book-chirho,
                                bookmark-chirho.chapter-chirho,
                                bookmark-chirho.verse-chirho
                            );
                        }
                        mouse-cursor: pointer;
                    }

                    VerticalLayout {
                        padding: ThemeChirho.spacing-md-chirho;
                        spacing: ThemeChirho.spacing-xs-chirho;

                        HorizontalLayout {
                            Text {
                                text: LabelsChirho.bookmark-icon-chirho;
                                font-size: 14px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: bookmark-chirho.reference-chirho;
                                font-size: ThemeChirho.font-size-md-chirho;
                                font-weight: 600;
                                color: ThemeChirho.accent-chirho;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }

                        if bookmark-chirho.label-chirho != "": Text {
                            text: bookmark-chirho.label-chirho;
                            font-size: ThemeChirho.font-size-sm-chirho;
                            color: ThemeChirho.text-secondary-chirho;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}

// Main application window
export component MainWindowChirho inherits Window {
    title: "Codex Lux";
    preferred-width: 1280px;
    preferred-height: 820px;
    background: ThemeChirho.background-primary-chirho;

    // Keyboard shortcuts
    FocusScope {
        key-pressed(event-chirho) => {
            // Left arrow: Previous chapter
            if (event-chirho.text == Key.LeftArrow && !event-chirho.modifiers.control) {
                if (AppStateChirho.current-chapter-chirho > 1) {
                    AppStateChirho.navigate-to-chirho(
                        AppStateChirho.current-book-chirho,
                        AppStateChirho.current-chapter-chirho - 1,
                        1
                    );
                }
                return accept;
            }
            // Right arrow: Next chapter
            if (event-chirho.text == Key.RightArrow && !event-chirho.modifiers.control) {
                AppStateChirho.navigate-to-chirho(
                    AppStateChirho.current-book-chirho,
                    AppStateChirho.current-chapter-chirho + 1,
                    1
                );
                return accept;
            }
            // Ctrl+F: Toggle search
            if (event-chirho.text == "f" && event-chirho.modifiers.control) {
                AppStateChirho.search-active-chirho = !AppStateChirho.search-active-chirho;
                return accept;
            }
            // Ctrl+G: Goto verse
            if (event-chirho.text == "g" && event-chirho.modifiers.control) {
                AppStateChirho.goto-dialog-visible-chirho = !AppStateChirho.goto-dialog-visible-chirho;
                return accept;
            }
            // Ctrl+T: Toggle theme
            if (event-chirho.text == "t" && event-chirho.modifiers.control) {
                ThemeChirho.is-dark-mode-chirho = !ThemeChirho.is-dark-mode-chirho;
                return accept;
            }
            // Escape: Close dialogs
            if (event-chirho.text == Key.Escape) {
                if (AppStateChirho.goto-dialog-visible-chirho) {
                    AppStateChirho.goto-dialog-visible-chirho = false;
                    return accept;
                }
                if (AppStateChirho.search-active-chirho) {
                    AppStateChirho.search-active-chirho = false;
                    return accept;
                }
            }
            // Ctrl+B: Toggle sidebar (books panel)
            if (event-chirho.text == "b" && event-chirho.modifiers.control) {
                AppStateChirho.sidebar-visible-chirho = !AppStateChirho.sidebar-visible-chirho;
                return accept;
            }
            // Ctrl+D: Toggle bookmarks panel
            if (event-chirho.text == "d" && event-chirho.modifiers.control) {
                AppStateChirho.bookmarks-visible-chirho = !AppStateChirho.bookmarks-visible-chirho;
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            ToolbarChirho {}

            SearchPanelChirho {
                visible-chirho: AppStateChirho.search-active-chirho;
            }

            HorizontalLayout {
                vertical-stretch: 1;

                if AppStateChirho.sidebar-visible-chirho: SidebarChirho {
                    animate width { duration: 200ms; easing: ease-out; }
                }

                BibleViewChirho {
                    horizontal-stretch: 1;
                }

                BookmarksPanelChirho {
                    visible-chirho: AppStateChirho.bookmarks-visible-chirho;
                }
            }

            StatusBarChirho {}
        }

        // Overlay dialogs
        ChapterSelectorChirho {
            visible-chirho: AppStateChirho.chapter-selector-visible-chirho;
        }

        GotoDialogChirho {
            visible-chirho: AppStateChirho.goto-dialog-visible-chirho;
        }

        NoteDialogChirho {
            visible-chirho: AppStateChirho.note-dialog-visible-chirho;
        }

        HistoryPanelChirho {
            visible-chirho: AppStateChirho.history-visible-chirho;
        }

        SettingsPanelChirho {
            visible-chirho: AppStateChirho.settings-visible-chirho;
        }
    }
}
