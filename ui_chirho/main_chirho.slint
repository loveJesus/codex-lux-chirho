}

// Professional color theme - supports dark, light, sepia, and high contrast modes
// Theme index: 0 = dark, 1 = light, 2 = sepia, 3 = high contrast
export global ThemeChirho {
    // Theme state - index for 4 themes
    in-out property <int> theme-index-chirho: 0;

    // Convenience property for backwards compatibility
    out property <bool> is-dark-mode-chirho: theme-index-chirho == 0 || theme-index-chirho == 3;

    // Core backgrounds - conditional on theme (dark, light, sepia, high contrast)
    out property <color> background-primary-chirho:
        theme-index-chirho == 0 ? #1e1e2e :
        theme-index-chirho == 1 ? #f8f9fa :
        theme-index-chirho == 2 ? #f4ecd8 :
        #000000; // high contrast

    out property <color> background-secondary-chirho:
        theme-index-chirho == 0 ? #252536 :
        theme-index-chirho == 1 ? #ffffff :
        theme-index-chirho == 2 ? #f9f3e3 :
        #0a0a0a; // high contrast

    out property <color> background-tertiary-chirho:
        theme-index-chirho == 0 ? #2d2d44 :
        theme-index-chirho == 1 ? #f0f1f3 :
        theme-index-chirho == 2 ? #efe6d5 :
        #1a1a1a; // high contrast

    out property <color> background-elevated-chirho:
        theme-index-chirho == 0 ? #363650 :
        theme-index-chirho == 1 ? #e9ecef :
        theme-index-chirho == 2 ? #e8dcc8 :
        #2a2a2a; // high contrast

    // Text hierarchy
    out property <color> text-primary-chirho:
        theme-index-chirho == 0 ? #e8e8f0 :
        theme-index-chirho == 1 ? #1a1a2e :
        theme-index-chirho == 2 ? #3d3225 :
        #ffffff; // high contrast - pure white

    out property <color> text-secondary-chirho:
        theme-index-chirho == 0 ? #b8b8c8 :
        theme-index-chirho == 1 ? #4a4a5a :
        theme-index-chirho == 2 ? #5c5040 :
        #e0e0e0; // high contrast

    out property <color> text-muted-chirho:
        theme-index-chirho == 0 ? #7878a0 :
        theme-index-chirho == 1 ? #7a7a8a :
        theme-index-chirho == 2 ? #8b7b65 :
        #a0a0a0; // high contrast

    out property <color> text-disabled-chirho:
        theme-index-chirho == 0 ? #505068 :
        theme-index-chirho == 1 ? #b0b0c0 :
        theme-index-chirho == 2 ? #b5a890 :
        #606060; // high contrast

    // Accent colors - brighter yellow for high contrast
    out property <color> accent-chirho:
        theme-index-chirho == 3 ? #ffff00 : #8b5cf6;
    out property <color> accent-hover-chirho:
        theme-index-chirho == 3 ? #ffff66 : #a78bfa;
    out property <color> accent-secondary-chirho:
        theme-index-chirho == 0 ? #3b4a6b :
        theme-index-chirho == 1 ? #e8e0ff :
        theme-index-chirho == 2 ? #d4c8b0 :
        #333300; // high contrast

    // Semantic colors
    out property <color> highlight-chirho:
        theme-index-chirho == 0 ? #fbbf24 :
        theme-index-chirho == 1 ? #f59e0b :
        theme-index-chirho == 2 ? #d4a020 :
        #ffff00; // high contrast - bright yellow

    out property <color> success-chirho: #34d399;
    out property <color> warning-chirho: #fb923c;
    out property <color> error-chirho: #f87171;

    // Borders and dividers - high contrast uses visible borders
    out property <color> border-chirho:
        theme-index-chirho == 0 ? #3d3d5c :
        theme-index-chirho == 1 ? #d0d5dd :
        theme-index-chirho == 2 ? #c5b8a0 :
        #ffffff; // high contrast - white borders

    out property <color> border-subtle-chirho:
        theme-index-chirho == 0 ? #2d2d44 :
        theme-index-chirho == 1 ? #e0e5eb :
        theme-index-chirho == 2 ? #d8ccb5 :
        #808080; // high contrast

    out property <color> divider-chirho:
        theme-index-chirho == 0 ? #3535505a :
        theme-index-chirho == 1 ? #d0d5dd5a :
        theme-index-chirho == 2 ? #c5b8a05a :
        #ffffff; // high contrast - solid white

    // Scripture language colors
    out property <color> hebrew-chirho:
        theme-index-chirho == 3 ? #00ffff : // high contrast - cyan
        (theme-index-chirho == 0 ? #fcd34d : #d97706);

    out property <color> greek-chirho:
        theme-index-chirho == 3 ? #00ff00 : // high contrast - green
        (theme-index-chirho == 0 ? #67e8f9 : #0891b2);

    out property <color> verse-number-chirho:
        theme-index-chirho == 0 ? #a78bfa :
        theme-index-chirho == 1 ? #7c3aed :
        theme-index-chirho == 2 ? #8b5cf6 :
        #ffff00; // high contrast - yellow

    // Red letter color for words of Jesus
    out property <color> red-letter-chirho:
        theme-index-chirho == 0 ? #ef4444 :  // dark: bright red
        theme-index-chirho == 1 ? #dc2626 :  // light: darker red
        theme-index-chirho == 2 ? #b91c1c :  // sepia: deep red
        #ff6666;  // high contrast: light red

    // Section heading color
    out property <color> section-heading-chirho:
        theme-index-chirho == 0 ? #94a3b8 :  // dark: slate gray
        theme-index-chirho == 1 ? #475569 :  // light: dark slate
        theme-index-chirho == 2 ? #64748b :  // sepia: medium slate
        #ffff00;  // high contrast: yellow

    // Poetry text color (slightly muted)
    out property <color> poetry-text-chirho:
        theme-index-chirho == 0 ? #cbd5e1 :  // dark: light slate
        theme-index-chirho == 1 ? #334155 :  // light: slate
        theme-index-chirho == 2 ? #475569 :  // sepia: medium slate
        #e0e0e0;  // high contrast: light gray

    // Typography
    out property <length> font-size-xs-chirho: 11px;
    out property <length> font-size-sm-chirho: 13px;
    out property <length> font-size-md-chirho: 15px;
    out property <length> font-size-lg-chirho: 18px;
    out property <length> font-size-xl-chirho: 22px;
    out property <length> font-size-scripture-chirho: 18px;

    // Spacing
    out property <length> spacing-xs-chirho: 4px;
    out property <length> spacing-sm-chirho: 8px;
    out property <length> spacing-md-chirho: 12px;
    out property <length> spacing-lg-chirho: 16px;
    out property <length> spacing-xl-chirho: 24px;

    // Border radius
    out property <length> radius-sm-chirho: 4px;
    out property <length> radius-md-chirho: 8px;
    out property <length> radius-lg-chirho: 12px;

    // Accessibility settings
    in-out property <bool> reduce-motion-chirho: false;
    in-out property <bool> focus-visible-chirho: true;

    // Animation duration (respects reduce-motion)
    out property <duration> animation-fast-chirho: reduce-motion-chirho ? 0ms : 150ms;
    out property <duration> animation-normal-chirho: reduce-motion-chirho ? 0ms : 200ms;
    out property <duration> animation-slow-chirho: reduce-motion-chirho ? 0ms : 300ms;

    // Focus indicator color (visible ring around focused elements)
    out property <color> focus-ring-chirho:
        theme-index-chirho == 3 ? #00ffff : // high contrast - cyan
        #8b5cf6; // purple accent
}

// Highlight color options
export struct HighlightColorChirho {
    name-chirho: string,
    color-chirho: color,
}

// Strong's word entry for interlinear display
export struct StrongsWordChirho {
    word-chirho: string,           // The word in the text
    strongs-number-chirho: string, // H1234 (Hebrew) or G5678 (Greek)
    lemma-chirho: string,          // Original language root word
    transliteration-chirho: string,// Romanized pronunciation
    definition-chirho: string,     // Brief definition
    morph-chirho: string,          // Morphology code
}

// Strong's definition entry for lexicon lookup
export struct StrongsEntryChirho {
    number-chirho: string,         // H1234 or G5678
    is-hebrew-chirho: bool,        // true for Hebrew (H), false for Greek (G)
    lemma-chirho: string,          // Original word
    transliteration-chirho: string,
    pronunciation-chirho: string,
    definition-chirho: string,     // Full definition
    usage-chirho: string,          // Usage notes
    occurrences-chirho: int,       // Number of occurrences in Bible
}

// Morphology entry for grammatical analysis
export struct MorphologyEntryChirho {
    code-chirho: string,           // Raw code (e.g., "V-AAI-3S" for Greek, "Ncmsa" for Hebrew)
    is-hebrew-chirho: bool,        // Hebrew or Greek morphology
    word-chirho: string,           // The analyzed word
    part-of-speech-chirho: string, // Noun, Verb, Adjective, etc.
    details-chirho: string,        // Full parsing (e.g., "Aorist Active Indicative, 3rd Person Singular")
    legend-chirho: string,         // Code legend explanation
}

// Cross-reference entry
export struct CrossRefChirho {
    reference-chirho: string,      // Target verse (e.g., "Romans 8:28")
    preview-chirho: string,        // First few words of the verse
    type-chirho: string,           // "parallel", "quote", "allusion", "thematic"
}

// Footnote entry
export struct FootnoteChirho {
    marker-chirho: string,         // Letter or symbol (a, b, *, †)
    content-chirho: string,        // Footnote text
    footnote-type-chirho: string,  // "translator", "textual", "alternative", "explanation"
}

// Commentary entry for display
export struct CommentaryEntryChirho {
    verse-ref-chirho: string,      // Verse reference
    content-chirho: string,        // Commentary text
    module-name-chirho: string,    // Commentary module name
    author-chirho: string,         // Commentary author (if known)
}

// Lexicon/Dictionary entry
export struct LexiconEntryChirho {
    key-chirho: string,            // Entry key/word
    content-chirho: string,        // Entry definition
    module-name-chirho: string,    // Lexicon module name
    related-chirho: [string],      // Related entries
}

// Interlinear word data structure (CLX-051)
export struct InterlinearWordChirho {
    original-chirho: string,       // Original Hebrew/Greek word
    transliteration-chirho: string, // Romanized transliteration
    morphology-chirho: string,     // Morphology code (e.g., "V-AAI-3S")
    strongs-chirho: string,        // Strong's number (e.g., "H1234" or "G5678")
    gloss-chirho: string,          // English gloss/meaning
    part-of-speech-chirho: string, // Part of speech (Noun, Verb, etc.)
    is-hebrew-chirho: bool,        // Hebrew (true) or Greek (false)
}

// Verse data structure
export struct VerseChirho {
    reference-chirho: string,
    text-chirho: string,
    is-highlighted-chirho: bool,
    highlight-color-chirho: string,
    has-note-chirho: bool,
    // Red letter text support (words of Jesus)
    is-red-letter-chirho: bool,
    // Section heading (appears before verse)
    section-heading-chirho: string,
    // Poetry/verse formatting (indentation level 0-3)
    poetry-indent-chirho: int,
    // Is this the start of a paragraph (for pilcrow markers)
    is-paragraph-start-chirho: bool,
    // Strong's numbers text (display format, e.g., "In <H7225> beginning <H430>")
    strongs-text-chirho: string,
    // Has Strong's data available
    has-strongs-chirho: bool,
}

