                                font-size: ThemeChirho.font-size-xs-chirho;
                                color: ThemeChirho.text-muted-chirho;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: note-chirho.preview-chirho;
                            font-size: ThemeChirho.font-size-sm-chirho;
                            color: ThemeChirho.text-secondary-chirho;
                            overflow: elide;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}

// Info Panel - contextual verse details sidebar
component InfoPanelChirho inherits Rectangle {
    in-out property <bool> visible-chirho: false;

    width: visible-chirho ? 320px : 0px;
    background: ThemeChirho.background-secondary-chirho;
    clip: true;

    animate width { duration: ThemeChirho.animation-normal-chirho; easing: ease-out; }

    Rectangle {
        width: 1px;
        height: 100%;
        background: ThemeChirho.border-chirho;
    }

    VerticalLayout {
        padding: ThemeChirho.spacing-lg-chirho;
        spacing: ThemeChirho.spacing-md-chirho;

        // Header
        HorizontalLayout {
            Text {
                text: "Verse Info";
                font-size: ThemeChirho.font-size-lg-chirho;
                font-weight: 700;
                color: ThemeChirho.text-primary-chirho;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            IconButtonChirho {
                icon-chirho: LabelsChirho.close-icon-chirho;
                clicked-chirho => {
                    AppStateChirho.info-panel-visible-chirho = false;
                }
            }
        }

        Rectangle {
            height: 1px;
            background: ThemeChirho.divider-chirho;
        }

        // Content when no verse selected
        if AppStateChirho.info-verse-ref-chirho == "": VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: ThemeChirho.spacing-sm-chirho;

            Text {
                text: "ℹ️";
                font-size: 32px;
                horizontal-alignment: center;
            }
            Text {
                text: "Click a verse to see details";
                font-size: ThemeChirho.font-size-md-chirho;
                color: ThemeChirho.text-muted-chirho;
                horizontal-alignment: center;
            }
        }

        // Verse details when selected
        if AppStateChirho.info-verse-ref-chirho != "": ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: ThemeChirho.spacing-lg-chirho;

                // Reference section
                VerticalLayout {
                    spacing: ThemeChirho.spacing-xs-chirho;

                    Text {
                        text: "REFERENCE";
                        font-size: ThemeChirho.font-size-xs-chirho;
                        font-weight: 600;
                        color: ThemeChirho.text-muted-chirho;
                    }
                    Text {
                        text: AppStateChirho.info-verse-ref-chirho;
                        font-size: ThemeChirho.font-size-lg-chirho;
                        font-weight: 600;
                        color: ThemeChirho.accent-chirho;
                    }
                }

                // Verse text section
                VerticalLayout {
                    spacing: ThemeChirho.spacing-xs-chirho;

                    Text {
                        text: "TEXT";
                        font-size: ThemeChirho.font-size-xs-chirho;
                        font-weight: 600;
                        color: ThemeChirho.text-muted-chirho;
                    }
                    Text {
                        text: AppStateChirho.info-verse-text-chirho;
                        font-size: ThemeChirho.font-size-md-chirho;
                        color: ThemeChirho.text-primary-chirho;
                        wrap: word-wrap;
                    }
                }

                Rectangle {
                    height: 1px;
                    background: ThemeChirho.divider-chirho;
                }

                // Status indicators section
                VerticalLayout {
                    spacing: ThemeChirho.spacing-xs-chirho;

                    Text {
                        text: "STATUS";
                        font-size: ThemeChirho.font-size-xs-chirho;
                        font-weight: 600;
                        color: ThemeChirho.text-muted-chirho;
                    }

                    // Highlight status
                    HorizontalLayout {
                        spacing: ThemeChirho.spacing-sm-chirho;
                        height: 28px;

                        Text {
                            text: AppStateChirho.info-has-highlight-chirho ? "*" : "o";
                            font-size: 16px;
                            color: AppStateChirho.info-has-highlight-chirho ?
                                (AppStateChirho.info-highlight-color-chirho == "yellow" ? #fbbf24 :
                                 AppStateChirho.info-highlight-color-chirho == "green" ? #34d399 :
                                 AppStateChirho.info-highlight-color-chirho == "blue" ? #60a5fa :
                                 AppStateChirho.info-highlight-color-chirho == "pink" ? #f472b6 :
                                 AppStateChirho.info-highlight-color-chirho == "orange" ? #fb923c :
                                 ThemeChirho.accent-chirho) :
                                ThemeChirho.text-muted-chirho;
                            vertical-alignment: center;
                        }
                        Text {
                            text: AppStateChirho.info-has-highlight-chirho ?
                                "Highlighted (" + AppStateChirho.info-highlight-color-chirho + ")" :
                                "Not highlighted";
                            font-size: ThemeChirho.font-size-sm-chirho;
                            color: ThemeChirho.text-secondary-chirho;
                            vertical-alignment: center;
                        }
                    }

                    // Bookmark status
                    HorizontalLayout {
                        spacing: ThemeChirho.spacing-sm-chirho;
                        height: 28px;

                        Text {
                            text: AppStateChirho.info-has-bookmark-chirho ? "Bk" : "o";
                            font-size: 16px;
                            color: AppStateChirho.info-has-bookmark-chirho ?
                                ThemeChirho.accent-chirho : ThemeChirho.text-muted-chirho;
                            vertical-alignment: center;
                        }
                        Text {
                            text: AppStateChirho.info-has-bookmark-chirho ? "Bookmarked" : "Not bookmarked";
                            font-size: ThemeChirho.font-size-sm-chirho;
                            color: ThemeChirho.text-secondary-chirho;
                            vertical-alignment: center;
                        }
                    }

                    // Note status
                    HorizontalLayout {
                        spacing: ThemeChirho.spacing-sm-chirho;
                        height: 28px;

                        Text {
                            text: AppStateChirho.info-has-note-chirho ? "📝" : "o";
                            font-size: 16px;
                            color: AppStateChirho.info-has-note-chirho ?
                                ThemeChirho.accent-chirho : ThemeChirho.text-muted-chirho;
                            vertical-alignment: center;
                        }
                        Text {
                            text: AppStateChirho.info-has-note-chirho ? "Has note" : "No note";
                            font-size: ThemeChirho.font-size-sm-chirho;
                            color: ThemeChirho.text-secondary-chirho;
                            vertical-alignment: center;
                        }
                    }
                }

                // Note preview if exists
                if AppStateChirho.info-has-note-chirho: VerticalLayout {
                    spacing: ThemeChirho.spacing-xs-chirho;

                    Rectangle {
                        height: 1px;
                        background: ThemeChirho.divider-chirho;
                    }

                    Text {
                        text: "NOTE";
                        font-size: ThemeChirho.font-size-xs-chirho;
                        font-weight: 600;
                        color: ThemeChirho.text-muted-chirho;
                    }

                    Rectangle {
                        background: ThemeChirho.background-tertiary-chirho;
                        border-radius: ThemeChirho.radius-md-chirho;

                        VerticalLayout {
                            padding: ThemeChirho.spacing-md-chirho;

                            Text {
                                text: AppStateChirho.info-note-preview-chirho;
                                font-size: ThemeChirho.font-size-sm-chirho;
                                color: ThemeChirho.text-secondary-chirho;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                Rectangle { height: 48px; }
            }
        }
    }
}

// Statistics Panel - reading progress and study stats
component StatisticsPanelChirho inherits Rectangle {
    in-out property <bool> visible-chirho: false;

    width: visible-chirho ? 360px : 0px;
    background: ThemeChirho.background-secondary-chirho;
    clip: true;

    animate width { duration: ThemeChirho.animation-normal-chirho; easing: ease-out; }

    Rectangle {
        width: 1px;
        height: 100%;
        background: ThemeChirho.border-chirho;
    }

    VerticalLayout {
        padding: ThemeChirho.spacing-lg-chirho;
        spacing: ThemeChirho.spacing-md-chirho;

        // Header
        HorizontalLayout {
            height: 32px;
            spacing: ThemeChirho.spacing-sm-chirho;
            alignment: space-between;

            HorizontalLayout {
                spacing: ThemeChirho.spacing-sm-chirho;

                Text {
                    text: "St";
                    font-size: 18px;
                    vertical-alignment: center;
                }
                Text {
                    text: "Statistics";
                    font-size: ThemeChirho.font-size-lg-chirho;
                    font-weight: 700;
                    color: ThemeChirho.text-primary-chirho;
                    vertical-alignment: center;
                }
            }

            // Close button
            Rectangle {
                width: 28px;
                height: 28px;
                background: close-touch-chirho.has-hover ? ThemeChirho.background-tertiary-chirho : transparent;
                border-radius: ThemeChirho.radius-sm-chirho;

                Text {
                    text: "x";
                    font-size: 14px;
                    color: ThemeChirho.text-secondary-chirho;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                close-touch-chirho := TouchArea {
                    clicked => { AppStateChirho.stats-panel-visible-chirho = false; }
                    mouse-cursor: pointer;
                }
            }
        }

        Rectangle {
            height: 1px;
            background: ThemeChirho.divider-chirho;
        }

        // Stats content
        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: ThemeChirho.spacing-lg-chirho;

                // Reading progress section
                VerticalLayout {
                    spacing: ThemeChirho.spacing-sm-chirho;

                    Text {
                        text: "READING PROGRESS";
                        font-size: ThemeChirho.font-size-xs-chirho;
                        font-weight: 600;
                        color: ThemeChirho.text-muted-chirho;
                    }

                    // Stats cards grid
                    GridLayout {
                        spacing: ThemeChirho.spacing-sm-chirho;

                        // Chapters read
                        Rectangle {
                            row: 0;
                            col: 0;
                            background: ThemeChirho.background-tertiary-chirho;
                            border-radius: ThemeChirho.radius-md-chirho;
                            height: 80px;

                            VerticalLayout {
                                padding: ThemeChirho.spacing-md-chirho;
                                alignment: center;

                                Text {
                                    text: AppStateChirho.stats-total-chapters-chirho;
                                    font-size: 28px;
                                    font-weight: 700;
                                    color: ThemeChirho.accent-chirho;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Chapters Read";
                                    font-size: ThemeChirho.font-size-xs-chirho;
                                    color: ThemeChirho.text-secondary-chirho;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        // Unique chapters
                        Rectangle {
                            row: 0;
                            col: 1;
                            background: ThemeChirho.background-tertiary-chirho;
                            border-radius: ThemeChirho.radius-md-chirho;
                            height: 80px;

                            VerticalLayout {
                                padding: ThemeChirho.spacing-md-chirho;
                                alignment: center;

                                Text {
                                    text: AppStateChirho.stats-unique-chapters-chirho;
                                    font-size: 28px;
                                    font-weight: 700;
                                    color: #34d399;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Unique Chapters";
                                    font-size: ThemeChirho.font-size-xs-chirho;
                                    color: ThemeChirho.text-secondary-chirho;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        // Reading time
                        Rectangle {
                            row: 1;
                            col: 0;
                            background: ThemeChirho.background-tertiary-chirho;
                            border-radius: ThemeChirho.radius-md-chirho;
                            height: 80px;

                            VerticalLayout {
                                padding: ThemeChirho.spacing-md-chirho;
                                alignment: center;

                                Text {
                                    text: AppStateChirho.stats-reading-time-chirho;
                                    font-size: 28px;
                                    font-weight: 700;
                                    color: #60a5fa;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Reading Time";
                                    font-size: ThemeChirho.font-size-xs-chirho;
                                    color: ThemeChirho.text-secondary-chirho;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        // Books started
                        Rectangle {
                            row: 1;
                            col: 1;
                            background: ThemeChirho.background-tertiary-chirho;
                            border-radius: ThemeChirho.radius-md-chirho;
                            height: 80px;

                            VerticalLayout {
                                padding: ThemeChirho.spacing-md-chirho;
                                alignment: center;

                                Text {
                                    text: AppStateChirho.stats-books-started-chirho;
                                    font-size: 28px;
                                    font-weight: 700;
                                    color: #f472b6;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Books Started";
                                    font-size: ThemeChirho.font-size-xs-chirho;
                                    color: ThemeChirho.text-secondary-chirho;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: ThemeChirho.divider-chirho;
                }

                // Reading streaks section
                VerticalLayout {
                    spacing: ThemeChirho.spacing-sm-chirho;

                    Text {
                        text: "READING STREAKS";
                        font-size: ThemeChirho.font-size-xs-chirho;
                        font-weight: 600;
                        color: ThemeChirho.text-muted-chirho;
                    }

                    HorizontalLayout {
                        spacing: ThemeChirho.spacing-md-chirho;

                        // Current streak
                        Rectangle {
                            horizontal-stretch: 1;
                            background: ThemeChirho.background-tertiary-chirho;
                            border-radius: ThemeChirho.radius-md-chirho;
                            height: 90px;

                            VerticalLayout {
                                padding: ThemeChirho.spacing-md-chirho;
                                alignment: center;

                                Text {
                                    text: "🔥";
                                    font-size: 24px;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: AppStateChirho.stats-current-streak-chirho;
                                    font-size: 32px;
                                    font-weight: 700;
                                    color: #fb923c;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Current Streak";
                                    font-size: ThemeChirho.font-size-xs-chirho;
                                    color: ThemeChirho.text-secondary-chirho;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        // Longest streak
                        Rectangle {
                            horizontal-stretch: 1;
                            background: ThemeChirho.background-tertiary-chirho;
                            border-radius: ThemeChirho.radius-md-chirho;
                            height: 90px;

                            VerticalLayout {
                                padding: ThemeChirho.spacing-md-chirho;
                                alignment: center;

                                Text {
                                    text: "🏆";
                                    font-size: 24px;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: AppStateChirho.stats-longest-streak-chirho;
                                    font-size: 32px;
                                    font-weight: 700;
                                    color: #fbbf24;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Longest Streak";
                                    font-size: ThemeChirho.font-size-xs-chirho;
                                    color: ThemeChirho.text-secondary-chirho;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: ThemeChirho.divider-chirho;
                }

                // Study activity section
                VerticalLayout {
                    spacing: ThemeChirho.spacing-sm-chirho;

                    Text {
                        text: "STUDY ACTIVITY";
                        font-size: ThemeChirho.font-size-xs-chirho;
                        font-weight: 600;
                        color: ThemeChirho.text-muted-chirho;
                    }

                    // Highlights count
                    HorizontalLayout {
                        spacing: ThemeChirho.spacing-sm-chirho;
                        height: 32px;

                        Text {
                            text: "*";
                            font-size: 16px;
                            color: #fbbf24;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Highlights";
                            font-size: ThemeChirho.font-size-md-chirho;
                            color: ThemeChirho.text-secondary-chirho;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: AppStateChirho.stats-highlight-count-chirho;
                            font-size: ThemeChirho.font-size-md-chirho;
                            font-weight: 600;
                            color: ThemeChirho.text-primary-chirho;
                            vertical-alignment: center;
                        }
                    }

                    // Bookmarks count
                    HorizontalLayout {
                        spacing: ThemeChirho.spacing-sm-chirho;
                        height: 32px;

                        Text {
                            text: "Bk";
                            font-size: 16px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Bookmarks";
                            font-size: ThemeChirho.font-size-md-chirho;
                            color: ThemeChirho.text-secondary-chirho;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: AppStateChirho.stats-bookmark-count-chirho;
                            font-size: ThemeChirho.font-size-md-chirho;
                            font-weight: 600;
                            color: ThemeChirho.text-primary-chirho;
                            vertical-alignment: center;
                        }
                    }

                    // Notes count
                    HorizontalLayout {
                        spacing: ThemeChirho.spacing-sm-chirho;
                        height: 32px;

                        Text {
                            text: "📝";
                            font-size: 16px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Notes";
                            font-size: ThemeChirho.font-size-md-chirho;
                            color: ThemeChirho.text-secondary-chirho;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: AppStateChirho.stats-note-count-chirho;
                            font-size: ThemeChirho.font-size-md-chirho;
                            font-weight: 600;
                            color: ThemeChirho.text-primary-chirho;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { height: 48px; }
            }
        }
    }
}

// Reading Plan Panel - Bible reading plans and progress
component ReadingPlanPanelChirho inherits Rectangle {
    in-out property <bool> visible-chirho: false;

    width: visible-chirho ? 380px : 0px;
    background: ThemeChirho.background-secondary-chirho;

    // Left border (using a child rectangle)
    Rectangle {
        width: 1px;
        background: ThemeChirho.border-chirho;
    }

    animate width { duration: ThemeChirho.animation-normal-chirho; easing: ease-out; }

    VerticalLayout {
        padding: ThemeChirho.spacing-lg-chirho;
        spacing: ThemeChirho.spacing-md-chirho;

        // Header
        HorizontalLayout {
            spacing: ThemeChirho.spacing-sm-chirho;

            Text {
                text: "Reading Plans";
                font-size: ThemeChirho.font-size-lg-chirho;
                font-weight: 700;
                color: ThemeChirho.text-primary-chirho;
                horizontal-stretch: 1;
            }

            Rectangle {
                width: 28px;
                height: 28px;
                background: close-plan-touch-chirho.has-hover ? ThemeChirho.background-elevated-chirho : transparent;
                border-radius: 14px;

                Text {
                    text: LabelsChirho.close-icon-chirho;
                    font-size: ThemeChirho.font-size-md-chirho;
                    color: ThemeChirho.text-secondary-chirho;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                close-plan-touch-chirho := TouchArea {
                    clicked => { AppStateChirho.reading-plan-panel-visible-chirho = false; }
                    mouse-cursor: pointer;
                }
            }
        }

        // Today's Reading Section
        if AppStateChirho.active-plan-chirho.id-chirho > 0: Rectangle {
            background: ThemeChirho.accent-chirho.with-alpha(0.1);
            border-radius: ThemeChirho.radius-md-chirho;

            VerticalLayout {
                padding: ThemeChirho.spacing-md-chirho;
                spacing: ThemeChirho.spacing-sm-chirho;

                Text {
                    text: "Today's Reading";
                    font-size: ThemeChirho.font-size-sm-chirho;
                    font-weight: 600;
                    color: ThemeChirho.accent-chirho;
                }

                Text {
                    text: AppStateChirho.today-reading-chirho.readings-chirho;
                    font-size: ThemeChirho.font-size-md-chirho;
                    color: ThemeChirho.text-primary-chirho;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: ThemeChirho.spacing-sm-chirho;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 32px;
                        background: go-reading-touch-chirho.has-hover ? ThemeChirho.accent-chirho : ThemeChirho.accent-secondary-chirho;
                        border-radius: ThemeChirho.radius-sm-chirho;

                        Text {
                            text: "Start Reading";
                            font-size: ThemeChirho.font-size-sm-chirho;
                            color: ThemeChirho.text-primary-chirho;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        go-reading-touch-chirho := TouchArea {
                            clicked => {
                                AppStateChirho.navigate-to-reading-chirho(AppStateChirho.today-reading-chirho.readings-chirho);
                            }
                            mouse-cursor: pointer;
                        }
                    }

                    if !AppStateChirho.today-reading-chirho.is-completed-chirho: Rectangle {
                        width: 100px;
                        height: 32px;
                        background: mark-done-touch-chirho.has-hover ? ThemeChirho.success-chirho : ThemeChirho.success-chirho.with-alpha(0.7);
                        border-radius: ThemeChirho.radius-sm-chirho;

                        Text {
                            text: "✓ Done";
                            font-size: ThemeChirho.font-size-sm-chirho;
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        mark-done-touch-chirho := TouchArea {
                            clicked => {
                                AppStateChirho.mark-day-complete-chirho(
                                    AppStateChirho.active-plan-chirho.id-chirho,
                                    AppStateChirho.today-reading-chirho.day-number-chirho
                                );
                            }
                            mouse-cursor: pointer;
                        }
                    }

                    if AppStateChirho.today-reading-chirho.is-completed-chirho: Rectangle {
                        width: 100px;
                        height: 32px;
                        background: ThemeChirho.background-tertiary-chirho;
                        border-radius: ThemeChirho.radius-sm-chirho;

                        Text {
                            text: "✓ Complete";
                            font-size: ThemeChirho.font-size-sm-chirho;
                            color: ThemeChirho.success-chirho;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Active Plan Progress
        if AppStateChirho.active-plan-chirho.id-chirho > 0: Rectangle {
            background: ThemeChirho.background-tertiary-chirho;
            border-radius: ThemeChirho.radius-md-chirho;

            VerticalLayout {
                padding: ThemeChirho.spacing-md-chirho;
                spacing: ThemeChirho.spacing-sm-chirho;

                HorizontalLayout {
                    Text {
                        text: AppStateChirho.active-plan-chirho.name-chirho;
                        font-size: ThemeChirho.font-size-md-chirho;
                        font-weight: 600;
                        color: ThemeChirho.text-primary-chirho;
                        horizontal-stretch: 1;
                    }

                    Text {
                        text: "Day " + AppStateChirho.active-plan-chirho.current-day-chirho + "/" + AppStateChirho.active-plan-chirho.total-days-chirho;
                        font-size: ThemeChirho.font-size-sm-chirho;
                        color: ThemeChirho.text-secondary-chirho;
                    }
                }

                // Progress bar
                Rectangle {
                    height: 8px;
                    background: ThemeChirho.background-elevated-chirho;
                    border-radius: 4px;

                    Rectangle {
                        width: parent.width * AppStateChirho.active-plan-chirho.progress-percent-chirho / 100;
                        height: parent.height;
                        background: ThemeChirho.accent-chirho;
                        border-radius: 4px;
                    }
                }

                Text {
                    text: AppStateChirho.active-plan-chirho.progress-percent-chirho + "% complete";
                    font-size: ThemeChirho.font-size-xs-chirho;
                    color: ThemeChirho.text-muted-chirho;
                }
            }
        }

        // Available Plans Section
        Text {
            text: "Available Plans";
            font-size: ThemeChirho.font-size-sm-chirho;
            font-weight: 600;
            color: ThemeChirho.text-muted-chirho;
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: ThemeChirho.spacing-sm-chirho;

                for plan-chirho in AppStateChirho.reading-plans-chirho: Rectangle {
                    height: 80px;
                    background: plan-item-touch-chirho.has-hover ? ThemeChirho.background-tertiary-chirho : ThemeChirho.background-secondary-chirho;
                    border-radius: ThemeChirho.radius-md-chirho;
                    border-width: plan-chirho.is-active-chirho ? 2px : 1px;
                    border-color: plan-chirho.is-active-chirho ? ThemeChirho.accent-chirho : ThemeChirho.border-subtle-chirho;

                    HorizontalLayout {
                        padding: ThemeChirho.spacing-md-chirho;
                        spacing: ThemeChirho.spacing-md-chirho;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: ThemeChirho.spacing-xs-chirho;

                            Text {
                                text: plan-chirho.name-chirho;
                                font-size: ThemeChirho.font-size-md-chirho;
                                font-weight: 600;
                                color: ThemeChirho.text-primary-chirho;
                            }

                            Text {
                                text: plan-chirho.description-chirho;
                                font-size: ThemeChirho.font-size-sm-chirho;
                                color: ThemeChirho.text-secondary-chirho;
                                overflow: elide;
                            }

                            Text {
                                text: plan-chirho.total-days-chirho + " days";
                                font-size: ThemeChirho.font-size-xs-chirho;
                                color: ThemeChirho.text-muted-chirho;
                            }
                        }

                        if !plan-chirho.is-active-chirho: Rectangle {
                            width: 60px;
                            height: 28px;
                            background: start-plan-touch-chirho.has-hover ? ThemeChirho.accent-chirho : ThemeChirho.accent-secondary-chirho;
                            border-radius: ThemeChirho.radius-sm-chirho;

                            Text {
                                text: "Start";
                                font-size: ThemeChirho.font-size-sm-chirho;
                                color: ThemeChirho.text-primary-chirho;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            start-plan-touch-chirho := TouchArea {
                                clicked => {
                                    AppStateChirho.start-reading-plan-chirho(plan-chirho.id-chirho);
                                }
                                mouse-cursor: pointer;
                            }
                        }

                        if plan-chirho.is-active-chirho: Rectangle {
                            width: 60px;
                            height: 28px;

                            Text {
                                text: "Active";
                                font-size: ThemeChirho.font-size-sm-chirho;
                                color: ThemeChirho.success-chirho;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    plan-item-touch-chirho := TouchArea {
                        mouse-cursor: pointer;
                    }
                }

                // Empty state
                if AppStateChirho.reading-plans-chirho.length == 0: Rectangle {
                    height: 100px;

                    VerticalLayout {
                        alignment: center;

                        Text {
                            text: "Lx";
                            font-size: 32px;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "No reading plans yet";
                            font-size: ThemeChirho.font-size-md-chirho;
                            color: ThemeChirho.text-muted-chirho;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

// Journal Panel - personal Bible study journal
component JournalPanelChirho inherits Rectangle {
    in-out property <bool> visible-chirho: false;

    width: visible-chirho ? 400px : 0px;
    background: ThemeChirho.background-secondary-chirho;
    clip: true;

    animate width { duration: ThemeChirho.animation-normal-chirho; easing: ease-out; }

    Rectangle {
        width: 1px;
        height: 100%;
        background: ThemeChirho.border-chirho;
    }

    VerticalLayout {
        padding: ThemeChirho.spacing-lg-chirho;
        spacing: ThemeChirho.spacing-md-chirho;

        // Header
        HorizontalLayout {
            height: 32px;
            spacing: ThemeChirho.spacing-sm-chirho;
            alignment: space-between;

            HorizontalLayout {
                spacing: ThemeChirho.spacing-sm-chirho;

                Text {
                    text: "Jn";
                    font-size: 18px;
                    vertical-alignment: center;
                }
                Text {
                    text: "Study Journal";
                    font-size: ThemeChirho.font-size-lg-chirho;
                    font-weight: 700;
                    color: ThemeChirho.text-primary-chirho;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: ThemeChirho.spacing-sm-chirho;

                // New entry button
                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: new-touch-chirho.has-hover ? ThemeChirho.accent-chirho : ThemeChirho.background-tertiary-chirho;
                    border-radius: ThemeChirho.radius-sm-chirho;

                    Text {
                        text: "+";
                        font-size: 18px;
                        font-weight: 600;
                        color: ThemeChirho.text-primary-chirho;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    new-touch-chirho := TouchArea {
                        clicked => {
                            AppStateChirho.journal-edit-id-chirho = -1;
                            AppStateChirho.journal-edit-title-chirho = "";
                            AppStateChirho.journal-edit-content-chirho = "";
                            AppStateChirho.journal-edit-verse-ref-chirho = AppStateChirho.current-book-chirho + " " + AppStateChirho.current-chapter-chirho;
                            AppStateChirho.journal-edit-tags-chirho = "";
                            AppStateChirho.journal-editor-visible-chirho = true;
                        }
                        mouse-cursor: pointer;
                    }
                }

                // Close button
                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: close-touch-chirho.has-hover ? ThemeChirho.background-tertiary-chirho : transparent;
                    border-radius: ThemeChirho.radius-sm-chirho;

                    Text {
                        text: "x";
                        font-size: 14px;
                        color: ThemeChirho.text-secondary-chirho;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close-touch-chirho := TouchArea {
                        clicked => { AppStateChirho.journal-panel-visible-chirho = false; }
                        mouse-cursor: pointer;
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: ThemeChirho.divider-chirho;
        }

        // Journal entries list
        if !AppStateChirho.journal-editor-visible-chirho: ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: ThemeChirho.spacing-sm-chirho;

                if AppStateChirho.journal-entries-chirho.length == 0: VerticalLayout {
                    alignment: center;
                    spacing: ThemeChirho.spacing-md-chirho;
                    padding-top: 40px;

                    Text {
                        text: "Jn";
                        font-size: 48px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "No journal entries yet";
                        font-size: ThemeChirho.font-size-md-chirho;
                        color: ThemeChirho.text-secondary-chirho;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Click + to create your first entry";
                        font-size: ThemeChirho.font-size-sm-chirho;
                        color: ThemeChirho.text-muted-chirho;
                        horizontal-alignment: center;
                    }
                }

                for entry-chirho in AppStateChirho.journal-entries-chirho: Rectangle {
                    background: entry-touch-chirho.has-hover ? ThemeChirho.background-tertiary-chirho : ThemeChirho.background-elevated-chirho;
                    border-radius: ThemeChirho.radius-md-chirho;

                    animate background { duration: ThemeChirho.animation-fast-chirho; }

                    VerticalLayout {
                        padding: ThemeChirho.spacing-md-chirho;
                        spacing: ThemeChirho.spacing-xs-chirho;

                        // Title row
                        HorizontalLayout {
                            alignment: space-between;

                            Text {
                                text: entry-chirho.title-chirho;
                                font-size: ThemeChirho.font-size-md-chirho;
                                font-weight: 600;
                                color: ThemeChirho.text-primary-chirho;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            // Delete button
                            Rectangle {
                                width: 20px;
                                height: 20px;
                                background: del-touch-chirho.has-hover ? #ef4444 : transparent;
                                border-radius: 10px;

                                Text {
                                    text: "x";
                                    font-size: 10px;
                                    color: del-touch-chirho.has-hover ? white : ThemeChirho.text-muted-chirho;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                del-touch-chirho := TouchArea {
                                    clicked => { AppStateChirho.delete-journal-entry-chirho(entry-chirho.id-chirho); }
                                    mouse-cursor: pointer;
                                }
                            }
                        }

                        // Preview
                        Text {
                            text: entry-chirho.preview-chirho;
                            font-size: ThemeChirho.font-size-sm-chirho;
                            color: ThemeChirho.text-secondary-chirho;
                            overflow: elide;
                        }

                        // Metadata row
                        HorizontalLayout {
                            spacing: ThemeChirho.spacing-sm-chirho;

                            if entry-chirho.verse-ref-chirho != "": Text {
                                text: "" + entry-chirho.verse-ref-chirho;
                                font-size: ThemeChirho.font-size-xs-chirho;
                                color: ThemeChirho.accent-chirho;
                            }

                            Text {
                                text: entry-chirho.date-chirho;
                                font-size: ThemeChirho.font-size-xs-chirho;
                                color: ThemeChirho.text-muted-chirho;
                                horizontal-stretch: 1;
                                horizontal-alignment: right;
                            }
                        }

                        if entry-chirho.tags-chirho != "": HorizontalLayout {
                            spacing: 4px;

                            Text {
                                text: "🏷 " + entry-chirho.tags-chirho;
                                font-size: ThemeChirho.font-size-xs-chirho;
                                color: ThemeChirho.text-muted-chirho;
                            }
                        }
                    }

                    entry-touch-chirho := TouchArea {
                        clicked => {
                            // Edit entry - load it into the editor
                            AppStateChirho.journal-edit-id-chirho = entry-chirho.id-chirho;
                            AppStateChirho.journal-edit-title-chirho = entry-chirho.title-chirho;
                            AppStateChirho.journal-edit-content-chirho = entry-chirho.preview-chirho; // Note: this is preview only
                            AppStateChirho.journal-edit-verse-ref-chirho = entry-chirho.verse-ref-chirho;
                            AppStateChirho.journal-edit-tags-chirho = entry-chirho.tags-chirho;
                            AppStateChirho.journal-editor-visible-chirho = true;
                        }
                        mouse-cursor: pointer;
                    }
                }

                Rectangle { height: 48px; }
            }
        }

        // Journal editor
        if AppStateChirho.journal-editor-visible-chirho: VerticalLayout {
            vertical-stretch: 1;
            spacing: ThemeChirho.spacing-md-chirho;

            // Editor header
            HorizontalLayout {
                height: 28px;
                alignment: space-between;

                Text {
                    text: AppStateChirho.journal-edit-id-chirho < 0 ? "New Entry" : "Edit Entry";
                    font-size: ThemeChirho.font-size-md-chirho;
                    font-weight: 600;
                    color: ThemeChirho.text-primary-chirho;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 60px;
                    height: 24px;
                    background: back-touch-chirho.has-hover ? ThemeChirho.background-tertiary-chirho : transparent;
                    border-radius: ThemeChirho.radius-sm-chirho;

                    Text {
                        text: "← Back";
                        font-size: ThemeChirho.font-size-xs-chirho;
                        color: ThemeChirho.text-secondary-chirho;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    back-touch-chirho := TouchArea {
                        clicked => { AppStateChirho.journal-editor-visible-chirho = false; }
                        mouse-cursor: pointer;
                    }
                }
            }

            // Title input
            Rectangle {
                height: 40px;
                background: ThemeChirho.background-tertiary-chirho;
                border-radius: ThemeChirho.radius-md-chirho;

                HorizontalLayout {
                    padding-left: ThemeChirho.spacing-md-chirho;
                    padding-right: ThemeChirho.spacing-md-chirho;

                    title-input-chirho := TextInput {
                        text <=> AppStateChirho.journal-edit-title-chirho;
                        font-size: ThemeChirho.font-size-md-chirho;
                        color: ThemeChirho.text-primary-chirho;
                        horizontal-alignment: left;
                        vertical-alignment: center;

                        // Placeholder text via overwrite
                    }
                }
            }

            // Verse reference input
            Rectangle {
                height: 36px;
                background: ThemeChirho.background-tertiary-chirho;
                border-radius: ThemeChirho.radius-md-chirho;

                HorizontalLayout {
                    padding-left: ThemeChirho.spacing-md-chirho;
                    padding-right: ThemeChirho.spacing-md-chirho;
                    spacing: ThemeChirho.spacing-sm-chirho;

                    Text {
                        text: "Go";
                        font-size: 14px;
                        vertical-alignment: center;
                    }

                    ref-input-chirho := TextInput {
                        text <=> AppStateChirho.journal-edit-verse-ref-chirho;
                        font-size: ThemeChirho.font-size-sm-chirho;
                        color: ThemeChirho.text-primary-chirho;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                }
            }

            // Content input (multiline textarea simulation)
            Rectangle {
                vertical-stretch: 1;
                background: ThemeChirho.background-tertiary-chirho;
                border-radius: ThemeChirho.radius-md-chirho;

                VerticalLayout {
                    padding: ThemeChirho.spacing-md-chirho;

                    content-input-chirho := TextInput {
                        text <=> AppStateChirho.journal-edit-content-chirho;
                        font-size: ThemeChirho.font-size-sm-chirho;
                        color: ThemeChirho.text-primary-chirho;
                        wrap: word-wrap;
                        vertical-stretch: 1;
                    }
                }
            }

            // Tags input
            Rectangle {
                height: 36px;
                background: ThemeChirho.background-tertiary-chirho;
                border-radius: ThemeChirho.radius-md-chirho;

                HorizontalLayout {
                    padding-left: ThemeChirho.spacing-md-chirho;
                    padding-right: ThemeChirho.spacing-md-chirho;
                    spacing: ThemeChirho.spacing-sm-chirho;

                    Text {
                        text: "🏷";
                        font-size: 14px;
                        vertical-alignment: center;
                    }

                    tags-input-chirho := TextInput {
                        text <=> AppStateChirho.journal-edit-tags-chirho;
                        font-size: ThemeChirho.font-size-sm-chirho;
                        color: ThemeChirho.text-primary-chirho;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                }
            }

            // Save button
            Rectangle {
                height: 44px;
                background: save-touch-chirho.has-hover ? ThemeChirho.accent-chirho.brighter(20%) : ThemeChirho.accent-chirho;
                border-radius: ThemeChirho.radius-md-chirho;

                animate background { duration: ThemeChirho.animation-fast-chirho; }

                Text {
                    text: "💾 Save Entry";
                    font-size: ThemeChirho.font-size-md-chirho;
                    font-weight: 600;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                save-touch-chirho := TouchArea {
                    clicked => {
                        AppStateChirho.save-journal-entry-chirho(
                            AppStateChirho.journal-edit-id-chirho,
                            AppStateChirho.journal-edit-title-chirho,
                            AppStateChirho.journal-edit-content-chirho,
                            AppStateChirho.journal-edit-verse-ref-chirho,
                            AppStateChirho.journal-edit-tags-chirho
                        );
                        AppStateChirho.journal-editor-visible-chirho = false;
                    }
                    mouse-cursor: pointer;
                }
            }
        }
    }
}

// Prayer List Panel - prayer request tracking
component PrayerPanelChirho inherits Rectangle {
    in-out property <bool> visible-chirho: false;

    width: visible-chirho ? 380px : 0px;
    background: ThemeChirho.background-secondary-chirho;
    clip: true;

    animate width { duration: ThemeChirho.animation-normal-chirho; easing: ease-out; }

    Rectangle {
        width: 1px;
        height: 100%;
        background: ThemeChirho.border-chirho;
    }

    VerticalLayout {
        padding: ThemeChirho.spacing-lg-chirho;
        spacing: ThemeChirho.spacing-md-chirho;

        // Header
        HorizontalLayout {
            height: 32px;
            spacing: ThemeChirho.spacing-sm-chirho;
            alignment: space-between;

            HorizontalLayout {
                spacing: ThemeChirho.spacing-sm-chirho;

                Text {
                    text: "Pr";
                    font-size: 18px;
                    vertical-alignment: center;
                }
                Text {
                    text: "Prayer List";
                    font-size: ThemeChirho.font-size-lg-chirho;
                    font-weight: 700;
                    color: ThemeChirho.text-primary-chirho;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: ThemeChirho.spacing-sm-chirho;

                // New request button
                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: new-touch-chirho.has-hover ? ThemeChirho.accent-chirho : ThemeChirho.background-tertiary-chirho;
                    border-radius: ThemeChirho.radius-sm-chirho;

                    Text {
                        text: "+";
                        font-size: 18px;
                        font-weight: 600;
                        color: ThemeChirho.text-primary-chirho;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    new-touch-chirho := TouchArea {
                        clicked => {
                            AppStateChirho.prayer-edit-title-chirho = "";
                            AppStateChirho.prayer-edit-description-chirho = "";
                            AppStateChirho.prayer-edit-verse-ref-chirho = AppStateChirho.current-book-chirho + " " + AppStateChirho.current-chapter-chirho;
                            AppStateChirho.prayer-edit-category-chirho = "";
                            AppStateChirho.prayer-editor-visible-chirho = true;
                        }
                        mouse-cursor: pointer;
                    }
                }

                // Close button
                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: close-touch-chirho.has-hover ? ThemeChirho.background-tertiary-chirho : transparent;
                    border-radius: ThemeChirho.radius-sm-chirho;

                    Text {
                        text: "x";
                        font-size: 14px;
                        color: ThemeChirho.text-secondary-chirho;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close-touch-chirho := TouchArea {
                        clicked => { AppStateChirho.prayer-panel-visible-chirho = false; }
                        mouse-cursor: pointer;
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: ThemeChirho.divider-chirho;
        }

        // Prayer requests list
        if !AppStateChirho.prayer-editor-visible-chirho: ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: ThemeChirho.spacing-sm-chirho;

                if AppStateChirho.prayer-requests-chirho.length == 0: VerticalLayout {
                    alignment: center;
                    spacing: ThemeChirho.spacing-md-chirho;
                    padding-top: 40px;

                    Text {
                        text: "Pr";
                        font-size: 48px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "No prayer requests yet";
                        font-size: ThemeChirho.font-size-md-chirho;
                        color: ThemeChirho.text-secondary-chirho;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Click + to add a prayer request";
                        font-size: ThemeChirho.font-size-sm-chirho;
                        color: ThemeChirho.text-muted-chirho;
                        horizontal-alignment: center;
                    }
                }

                for prayer-chirho in AppStateChirho.prayer-requests-chirho: Rectangle {
                    background: prayer-chirho.is-answered-chirho ?
                        #34d399.with-alpha(0.1) :
                        (prayer-touch-chirho.has-hover ? ThemeChirho.background-tertiary-chirho : ThemeChirho.background-elevated-chirho);
                    border-radius: ThemeChirho.radius-md-chirho;
                    border-width: prayer-chirho.is-answered-chirho ? 1px : 0px;
                    border-color: #34d399.with-alpha(0.3);

                    animate background { duration: ThemeChirho.animation-fast-chirho; }

                    VerticalLayout {
                        padding: ThemeChirho.spacing-md-chirho;
                        spacing: ThemeChirho.spacing-xs-chirho;

                        // Title row with actions
                        HorizontalLayout {
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: ThemeChirho.spacing-xs-chirho;

                                if prayer-chirho.is-answered-chirho: Text {
                                    text: "✓";
                                    font-size: 14px;
                                    color: #34d399;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: prayer-chirho.title-chirho;
                                    font-size: ThemeChirho.font-size-md-chirho;
                                    font-weight: 600;
                                    color: prayer-chirho.is-answered-chirho ? #34d399 : ThemeChirho.text-primary-chirho;
                                    overflow: elide;
                                }
                            }

                            HorizontalLayout {
                                spacing: 4px;

                                // Mark as answered button (if not answered)
                                if !prayer-chirho.is-answered-chirho: Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    background: answer-touch-chirho.has-hover ? #34d399 : transparent;
                                    border-radius: 10px;

                                    Text {
                                        text: "✓";
                                        font-size: 12px;
                                        color: answer-touch-chirho.has-hover ? white : ThemeChirho.text-muted-chirho;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    answer-touch-chirho := TouchArea {
                                        clicked => { AppStateChirho.mark-prayer-answered-chirho(prayer-chirho.id-chirho); }
                                        mouse-cursor: pointer;
                                    }
                                }

                                // Delete button
                                Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    background: del-touch-chirho.has-hover ? #ef4444 : transparent;
                                    border-radius: 10px;

                                    Text {
                                        text: "x";
                                        font-size: 10px;
                                        color: del-touch-chirho.has-hover ? white : ThemeChirho.text-muted-chirho;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    del-touch-chirho := TouchArea {
                                        clicked => { AppStateChirho.delete-prayer-request-chirho(prayer-chirho.id-chirho); }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }
                        }

                        // Description
                        if prayer-chirho.description-chirho != "": Text {
                            text: prayer-chirho.description-chirho;
                            font-size: ThemeChirho.font-size-sm-chirho;
                            color: ThemeChirho.text-secondary-chirho;
                            overflow: elide;
                        }

                        // Metadata row
                        HorizontalLayout {
                            spacing: ThemeChirho.spacing-sm-chirho;

                            if prayer-chirho.verse-ref-chirho != "": Text {
                                text: "" + prayer-chirho.verse-ref-chirho;
                                font-size: ThemeChirho.font-size-xs-chirho;
                                color: ThemeChirho.accent-chirho;
                            }

                            if prayer-chirho.category-chirho != "": Text {
                                text: "📁 " + prayer-chirho.category-chirho;
                                font-size: ThemeChirho.font-size-xs-chirho;
                                color: ThemeChirho.text-muted-chirho;
                            }

                            Text {
                                text: prayer-chirho.date-chirho;
                                font-size: ThemeChirho.font-size-xs-chirho;
                                color: ThemeChirho.text-muted-chirho;
                                horizontal-stretch: 1;
                                horizontal-alignment: right;
                            }
                        }
                    }

                    prayer-touch-chirho := TouchArea {
                        mouse-cursor: pointer;
                    }
                }

                Rectangle { height: 48px; }
            }
        }

        // Prayer editor
        if AppStateChirho.prayer-editor-visible-chirho: VerticalLayout {
            vertical-stretch: 1;
            spacing: ThemeChirho.spacing-md-chirho;

            // Editor header
            HorizontalLayout {
                height: 28px;
                alignment: space-between;

                Text {
                    text: "New Prayer Request";
                    font-size: ThemeChirho.font-size-md-chirho;
                    font-weight: 600;
                    color: ThemeChirho.text-primary-chirho;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 60px;
                    height: 24px;
                    background: back-touch-chirho.has-hover ? ThemeChirho.background-tertiary-chirho : transparent;
                    border-radius: ThemeChirho.radius-sm-chirho;

                    Text {
                        text: "← Back";
                        font-size: ThemeChirho.font-size-xs-chirho;
                        color: ThemeChirho.text-secondary-chirho;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    back-touch-chirho := TouchArea {
                        clicked => { AppStateChirho.prayer-editor-visible-chirho = false; }
                        mouse-cursor: pointer;
                    }
                }
            }

            // Title input
            Rectangle {
                height: 40px;
                background: ThemeChirho.background-tertiary-chirho;
                border-radius: ThemeChirho.radius-md-chirho;

                HorizontalLayout {
                    padding-left: ThemeChirho.spacing-md-chirho;
                    padding-right: ThemeChirho.spacing-md-chirho;

                    title-input-chirho := TextInput {
                        text <=> AppStateChirho.prayer-edit-title-chirho;
                        font-size: ThemeChirho.font-size-md-chirho;
                        color: ThemeChirho.text-primary-chirho;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                    }
                }
            }

            // Description input
            Rectangle {
                height: 80px;
                background: ThemeChirho.background-tertiary-chirho;
                border-radius: ThemeChirho.radius-md-chirho;

                VerticalLayout {
                    padding: ThemeChirho.spacing-md-chirho;

                    desc-input-chirho := TextInput {
                        text <=> AppStateChirho.prayer-edit-description-chirho;
                        font-size: ThemeChirho.font-size-sm-chirho;
                        color: ThemeChirho.text-primary-chirho;
                        wrap: word-wrap;
                        vertical-stretch: 1;
                    }
                }
            }

            // Verse reference input
            Rectangle {
                height: 36px;
                background: ThemeChirho.background-tertiary-chirho;
                border-radius: ThemeChirho.radius-md-chirho;

                HorizontalLayout {
                    padding-left: ThemeChirho.spacing-md-chirho;
                    padding-right: ThemeChirho.spacing-md-chirho;
                    spacing: ThemeChirho.spacing-sm-chirho;

                    Text {
                        text: "Go";
                        font-size: 14px;
                        vertical-alignment: center;
                    }

                    ref-input-chirho := TextInput {
                        text <=> AppStateChirho.prayer-edit-verse-ref-chirho;
                        font-size: ThemeChirho.font-size-sm-chirho;
                        color: ThemeChirho.text-primary-chirho;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                }
            }

            // Category input
            Rectangle {
                height: 36px;
                background: ThemeChirho.background-tertiary-chirho;
                border-radius: ThemeChirho.radius-md-chirho;

                HorizontalLayout {
                    padding-left: ThemeChirho.spacing-md-chirho;
                    padding-right: ThemeChirho.spacing-md-chirho;
                    spacing: ThemeChirho.spacing-sm-chirho;

                    Text {
                        text: "📁";
                        font-size: 14px;
                        vertical-alignment: center;
                    }

                    cat-input-chirho := TextInput {
                        text <=> AppStateChirho.prayer-edit-category-chirho;
                        font-size: ThemeChirho.font-size-sm-chirho;
                        color: ThemeChirho.text-primary-chirho;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }

            // Save button
            Rectangle {
                height: 44px;
                background: save-touch-chirho.has-hover ? ThemeChirho.accent-chirho.brighter(20%) : ThemeChirho.accent-chirho;
                border-radius: ThemeChirho.radius-md-chirho;

                animate background { duration: ThemeChirho.animation-fast-chirho; }

                Text {
                    text: "Add Prayer";
                    font-size: ThemeChirho.font-size-md-chirho;
                    font-weight: 600;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                save-touch-chirho := TouchArea {
                    clicked => {
                        AppStateChirho.save-prayer-request-chirho(
                            AppStateChirho.prayer-edit-title-chirho,
                            AppStateChirho.prayer-edit-description-chirho,
                            AppStateChirho.prayer-edit-verse-ref-chirho,
                            AppStateChirho.prayer-edit-category-chirho
                        );
                        AppStateChirho.prayer-editor-visible-chirho = false;
                    }
                    mouse-cursor: pointer;
                }
            }
        }
    }
}

// Commentary Panel - display commentary content for current verse
component CommentaryPanelChirho inherits Rectangle {
    in-out property <bool> visible-chirho: false;

    width: visible-chirho ? 380px : 0px;
    background: ThemeChirho.background-secondary-chirho;
    clip: true;

    // Left border
    Rectangle {
        width: 1px;
        background: ThemeChirho.border-chirho;
    }

    animate width { duration: ThemeChirho.animation-normal-chirho; easing: ease-out; }

    VerticalLayout {
        padding: ThemeChirho.spacing-lg-chirho;
        spacing: ThemeChirho.spacing-md-chirho;

        // Header
        HorizontalLayout {
            spacing: ThemeChirho.spacing-sm-chirho;

            Text {
                text: "Commentary";
                font-size: ThemeChirho.font-size-lg-chirho;
                font-weight: 700;
                color: ThemeChirho.text-primary-chirho;
                horizontal-stretch: 1;
            }

            IconButtonChirho {
                icon-chirho: LabelsChirho.close-icon-chirho;
                clicked-chirho => {
                    AppStateChirho.commentary-panel-visible-chirho = false;
                }
            }
        }

        // Current verse reference
        Text {
            text: AppStateChirho.commentary-verse-ref-chirho;
            font-size: ThemeChirho.font-size-md-chirho;
            font-weight: 600;
            color: ThemeChirho.accent-chirho;
        }

        // Commentary module selector (if multiple available)
        if AppStateChirho.commentary-modules-chirho.length > 1: HorizontalLayout {
            spacing: ThemeChirho.spacing-sm-chirho;

            Text {
                text: "Source:";
                font-size: ThemeChirho.font-size-sm-chirho;
                color: ThemeChirho.text-secondary-chirho;
                vertical-alignment: center;
            }

            for module-chirho in AppStateChirho.commentary-modules-chirho: Rectangle {
                width: 80px;
                height: 28px;
                background: AppStateChirho.commentary-module-chirho == module-chirho ?
                    ThemeChirho.accent-chirho : ThemeChirho.background-tertiary-chirho;
                border-radius: ThemeChirho.radius-sm-chirho;

                Text {
                    text: module-chirho;
                    font-size: ThemeChirho.font-size-xs-chirho;
                    color: AppStateChirho.commentary-module-chirho == module-chirho ?
                        white : ThemeChirho.text-secondary-chirho;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => {
                        AppStateChirho.select-commentary-module-chirho(module-chirho);
                    }
                    mouse-cursor: pointer;
                }
            }
        }

        Rectangle {
            height: 1px;
            background: ThemeChirho.divider-chirho;
        }

        // Commentary content
        if AppStateChirho.commentary-content-chirho == "": VerticalLayout {
            vertical-stretch: 1;
            alignment: center;

            Text {
                text: "No commentary available";
                font-size: ThemeChirho.font-size-md-chirho;
                color: ThemeChirho.text-muted-chirho;
                horizontal-alignment: center;
            }

            Text {
                text: "Install commentary modules to see verse explanations";
                font-size: ThemeChirho.font-size-sm-chirho;
                color: ThemeChirho.text-disabled-chirho;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: ThemeChirho.spacing-md-chirho;

                Text {
                    text: AppStateChirho.commentary-content-chirho;
                    font-size: ThemeChirho.font-size-md-chirho;
                    color: ThemeChirho.text-primary-chirho;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// Lexicon/Dictionary Panel - word lookup and definitions
component LexiconPanelChirho inherits Rectangle {
    in-out property <bool> visible-chirho: false;

    width: visible-chirho ? 380px : 0px;
    background: ThemeChirho.background-secondary-chirho;
    clip: true;

    // Left border
    Rectangle {
        width: 1px;
        background: ThemeChirho.border-chirho;
    }

    animate width { duration: ThemeChirho.animation-normal-chirho; easing: ease-out; }

    VerticalLayout {
        padding: ThemeChirho.spacing-lg-chirho;
        spacing: ThemeChirho.spacing-md-chirho;

        // Header
        HorizontalLayout {
            spacing: ThemeChirho.spacing-sm-chirho;

            Text {
                text: "Lexicon";
                font-size: ThemeChirho.font-size-lg-chirho;
                font-weight: 700;
                color: ThemeChirho.text-primary-chirho;
                horizontal-stretch: 1;
            }

            IconButtonChirho {
                icon-chirho: LabelsChirho.close-icon-chirho;
                clicked-chirho => {
                    AppStateChirho.lexicon-panel-visible-chirho = false;
                }
            }
        }

        // Search input
        Rectangle {
            height: 36px;
            background: ThemeChirho.background-tertiary-chirho;
            border-radius: ThemeChirho.radius-md-chirho;

            HorizontalLayout {
                padding-left: ThemeChirho.spacing-md-chirho;
                padding-right: ThemeChirho.spacing-md-chirho;
                spacing: ThemeChirho.spacing-sm-chirho;

                Text {
                    text: LabelsChirho.search-icon-chirho;
                    font-size: ThemeChirho.font-size-md-chirho;
                    color: ThemeChirho.text-muted-chirho;
                    vertical-alignment: center;
                }

                lexicon-search-input-chirho := LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: "Search lexicon...";
                    text <=> AppStateChirho.lexicon-search-query-chirho;
                    accepted => {
                        AppStateChirho.search-lexicon-chirho(AppStateChirho.lexicon-search-query-chirho);
                    }
                }
            }
        }

        // Alphabet browse bar
        HorizontalLayout {
            spacing: 2px;
            alignment: center;

            for letter-chirho in ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K", "L", "M"]: Rectangle {
                width: 22px;
                height: 24px;
                background: letter-touch-chirho.has-hover ? ThemeChirho.accent-chirho : transparent;
                border-radius: ThemeChirho.radius-sm-chirho;

                Text {
                    text: letter-chirho;
                    font-size: ThemeChirho.font-size-xs-chirho;
                    color: letter-touch-chirho.has-hover ? white : ThemeChirho.text-secondary-chirho;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                letter-touch-chirho := TouchArea {
                    clicked => {
                        AppStateChirho.browse-lexicon-chirho(letter-chirho);
                    }
                    mouse-cursor: pointer;
                }
            }
        }

        HorizontalLayout {
            spacing: 2px;
            alignment: center;

            for letter-chirho in ["N", "O", "P", "Q", "R", "S", "T", "U", "V", "W", "X", "Y", "Z"]: Rectangle {
                width: 22px;
                height: 24px;
                background: letter-touch2-chirho.has-hover ? ThemeChirho.accent-chirho : transparent;
                border-radius: ThemeChirho.radius-sm-chirho;

                Text {
                    text: letter-chirho;
                    font-size: ThemeChirho.font-size-xs-chirho;
                    color: letter-touch2-chirho.has-hover ? white : ThemeChirho.text-secondary-chirho;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                letter-touch2-chirho := TouchArea {
                    clicked => {
                        AppStateChirho.browse-lexicon-chirho(letter-chirho);
                    }
                    mouse-cursor: pointer;
                }
            }
        }

        Rectangle {
            height: 1px;
            background: ThemeChirho.divider-chirho;
        }

        // Current entry display
        if AppStateChirho.lexicon-current-entry-chirho != "": Rectangle {
            background: ThemeChirho.accent-chirho.with-alpha(0.1);
            border-radius: ThemeChirho.radius-md-chirho;

            VerticalLayout {
                padding: ThemeChirho.spacing-md-chirho;
                spacing: ThemeChirho.spacing-sm-chirho;

                Text {
                    text: AppStateChirho.lexicon-current-entry-chirho;
                    font-size: ThemeChirho.font-size-lg-chirho;
                    font-weight: 700;
                    color: ThemeChirho.accent-chirho;
                }
            }
        }

        // Entry content
        if AppStateChirho.lexicon-entry-content-chirho == "": VerticalLayout {
            vertical-stretch: 1;
            alignment: center;

            Text {
                text: "Search for a word";
                font-size: ThemeChirho.font-size-md-chirho;
                color: ThemeChirho.text-muted-chirho;
                horizontal-alignment: center;
            }

            Text {
                text: "Enter a word above or browse by letter";
                font-size: ThemeChirho.font-size-sm-chirho;
                color: ThemeChirho.text-disabled-chirho;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: ThemeChirho.spacing-md-chirho;

                Text {
                    text: AppStateChirho.lexicon-entry-content-chirho;
                    font-size: ThemeChirho.font-size-md-chirho;
                    color: ThemeChirho.text-primary-chirho;
                    wrap: word-wrap;
                }
            }
        }

        // History section
        if AppStateChirho.lexicon-history-chirho.length > 0: Rectangle {
            background: ThemeChirho.background-tertiary-chirho;
            border-radius: ThemeChirho.radius-md-chirho;

            VerticalLayout {
                padding: ThemeChirho.spacing-sm-chirho;
                spacing: ThemeChirho.spacing-xs-chirho;

                Text {
                    text: "Recent:";
                    font-size: ThemeChirho.font-size-xs-chirho;
                    color: ThemeChirho.text-muted-chirho;
                }

                HorizontalLayout {
                    spacing: ThemeChirho.spacing-xs-chirho;

                    for entry-chirho in AppStateChirho.lexicon-history-chirho: Rectangle {
                        height: 24px;
                        width: 60px;
                        background: hist-touch-chirho.has-hover ? ThemeChirho.background-elevated-chirho : transparent;
                        border-radius: ThemeChirho.radius-sm-chirho;

                        Text {
                            text: entry-chirho;
                            font-size: ThemeChirho.font-size-xs-chirho;
                            color: ThemeChirho.accent-chirho;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        hist-touch-chirho := TouchArea {
                            clicked => {
                                AppStateChirho.search-lexicon-chirho(entry-chirho);
                            }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }
        }
    }
}

// Interlinear Display Panel - word-by-word Hebrew/Greek analysis (CLX-051)
component InterlinearPanelChirho inherits Rectangle {
    in-out property <bool> visible-chirho: false;

    width: visible-chirho ? 420px : 0px;
    background: ThemeChirho.background-secondary-chirho;
    clip: true;

    // Left border
    Rectangle {
        width: 1px;
        background: ThemeChirho.border-chirho;
    }

    animate width { duration: ThemeChirho.animation-normal-chirho; easing: ease-out; }

    VerticalLayout {
        padding: ThemeChirho.spacing-lg-chirho;
        spacing: ThemeChirho.spacing-md-chirho;

        // Header
        HorizontalLayout {
            spacing: ThemeChirho.spacing-sm-chirho;

            Text {
                text: "≡ Interlinear";
                font-size: ThemeChirho.font-size-lg-chirho;
                font-weight: 700;
                color: ThemeChirho.text-primary-chirho;
                horizontal-stretch: 1;
            }

            IconButtonChirho {
                icon-chirho: LabelsChirho.close-icon-chirho;
                clicked-chirho => {
                    AppStateChirho.interlinear-visible-chirho = false;
                }
            }
        }

        // Current verse reference
        Text {
            text: AppStateChirho.interlinear-verse-ref-chirho;
            font-size: ThemeChirho.font-size-md-chirho;
            font-weight: 600;
            color: ThemeChirho.accent-chirho;
        }

        // Display toggles
        HorizontalLayout {
            spacing: ThemeChirho.spacing-xs-chirho;

            Rectangle {
                horizontal-stretch: 1;
                height: 28px;
                background: AppStateChirho.interlinear-show-transliteration-chirho ?
                    ThemeChirho.accent-chirho : ThemeChirho.background-tertiary-chirho;
                border-radius: ThemeChirho.radius-sm-chirho;

                Text {
                    text: "Translit";
                    font-size: ThemeChirho.font-size-xs-chirho;
                    color: AppStateChirho.interlinear-show-transliteration-chirho ?
                        white : ThemeChirho.text-secondary-chirho;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => {
                        AppStateChirho.interlinear-show-transliteration-chirho =
                            !AppStateChirho.interlinear-show-transliteration-chirho;
                    }
                    mouse-cursor: pointer;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                height: 28px;
                background: AppStateChirho.interlinear-show-morphology-chirho ?
                    ThemeChirho.accent-chirho : ThemeChirho.background-tertiary-chirho;
                border-radius: ThemeChirho.radius-sm-chirho;

                Text {
                    text: "Morph";
                    font-size: ThemeChirho.font-size-xs-chirho;
                    color: AppStateChirho.interlinear-show-morphology-chirho ?
                        white : ThemeChirho.text-secondary-chirho;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => {
                        AppStateChirho.interlinear-show-morphology-chirho =
                            !AppStateChirho.interlinear-show-morphology-chirho;
                    }
                    mouse-cursor: pointer;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                height: 28px;
                background: AppStateChirho.interlinear-show-strongs-chirho ?
                    ThemeChirho.accent-chirho : ThemeChirho.background-tertiary-chirho;
                border-radius: ThemeChirho.radius-sm-chirho;

                Text {
                    text: "Strong's";
                    font-size: ThemeChirho.font-size-xs-chirho;
                    color: AppStateChirho.interlinear-show-strongs-chirho ?
                        white : ThemeChirho.text-secondary-chirho;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => {
                        AppStateChirho.interlinear-show-strongs-chirho =
                            !AppStateChirho.interlinear-show-strongs-chirho;
                    }
                    mouse-cursor: pointer;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                height: 28px;
                background: AppStateChirho.interlinear-show-gloss-chirho ?
                    ThemeChirho.accent-chirho : ThemeChirho.background-tertiary-chirho;
                border-radius: ThemeChirho.radius-sm-chirho;

                Text {
                    text: "Gloss";
                    font-size: ThemeChirho.font-size-xs-chirho;
                    color: AppStateChirho.interlinear-show-gloss-chirho ?
                        white : ThemeChirho.text-secondary-chirho;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => {
                        AppStateChirho.interlinear-show-gloss-chirho =
                            !AppStateChirho.interlinear-show-gloss-chirho;
                    }
                    mouse-cursor: pointer;
                }
            }
        }

        Rectangle {
            height: 1px;
            background: ThemeChirho.divider-chirho;
        }

        // Interlinear content
        if AppStateChirho.interlinear-words-chirho.length == 0: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;

            Text {
                text: "Interlinear Display";
                font-size: ThemeChirho.font-size-md-chirho;
                color: ThemeChirho.text-muted-chirho;
                horizontal-alignment: center;
            }

            Text {
                text: "Click on a verse to see word-by-word analysis";
                font-size: ThemeChirho.font-size-sm-chirho;
                color: ThemeChirho.text-disabled-chirho;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: ThemeChirho.spacing-lg-chirho;

                // Word cards
                for word-chirho in AppStateChirho.interlinear-words-chirho: Rectangle {
                    background: ThemeChirho.background-tertiary-chirho;
                    border-radius: ThemeChirho.radius-md-chirho;

                    VerticalLayout {
                        padding: ThemeChirho.spacing-md-chirho;
                        spacing: ThemeChirho.spacing-xs-chirho;

                        // Original word (Hebrew/Greek)
                        Text {
                            text: word-chirho.original-chirho;
                            font-size: word-chirho.is-hebrew-chirho ? 24px : 20px;
                            font-weight: 600;
                            color: ThemeChirho.accent-chirho;
                            horizontal-alignment: word-chirho.is-hebrew-chirho ? right : left;
                        }

                        // Transliteration
                        if AppStateChirho.interlinear-show-transliteration-chirho: Text {
                            text: word-chirho.transliteration-chirho;
                            font-size: ThemeChirho.font-size-sm-chirho;
                            color: ThemeChirho.text-secondary-chirho;
                        }

                        // Part of speech & morphology
                        if AppStateChirho.interlinear-show-morphology-chirho: HorizontalLayout {
                            spacing: ThemeChirho.spacing-sm-chirho;

                            Rectangle {
                                background: ThemeChirho.accent-chirho.with-alpha(0.2);
                                border-radius: ThemeChirho.radius-sm-chirho;
                                height: 20px;

                                Text {
                                    text: word-chirho.part-of-speech-chirho;
                                    font-size: ThemeChirho.font-size-xs-chirho;
                                    font-weight: 600;
                                    color: ThemeChirho.accent-chirho;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                width: self.preferred-width + 12px;
                            }

                            Text {
                                text: word-chirho.morphology-chirho;
                                font-size: ThemeChirho.font-size-xs-chirho;
                                color: ThemeChirho.text-muted-chirho;
                                vertical-alignment: center;
                            }
                        }

                        // Strong's number
                        if AppStateChirho.interlinear-show-strongs-chirho && word-chirho.strongs-chirho != "": Rectangle {
                            background: word-chirho.is-hebrew-chirho ? #3b82f6.with-alpha(0.2) : #22c55e.with-alpha(0.2);
                            border-radius: ThemeChirho.radius-sm-chirho;
                            height: 20px;
                            width: 60px;

                            Text {
                                text: word-chirho.strongs-chirho;
                                font-size: ThemeChirho.font-size-xs-chirho;
                                font-weight: 600;
                                color: word-chirho.is-hebrew-chirho ? #3b82f6 : #22c55e;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // Gloss (English meaning)
                        if AppStateChirho.interlinear-show-gloss-chirho: Text {
                            text: word-chirho.gloss-chirho;
                            font-size: ThemeChirho.font-size-md-chirho;
                            font-weight: 500;
                            color: ThemeChirho.text-primary-chirho;
                        }
                    }
                }
            }
        }
    }
}

// Module Manager panel
component ModuleManagerPanelChirho inherits Rectangle {
    in-out property <bool> visible-chirho: false;

    width: visible-chirho ? 400px : 0px;
    background: ThemeChirho.background-secondary-chirho;
    clip: true;

    animate width { duration: ThemeChirho.animation-normal-chirho; easing: ease-out; }

    Rectangle {
        width: 1px;
        height: 100%;
        background: ThemeChirho.border-chirho;
    }

    VerticalLayout {
        padding: ThemeChirho.spacing-lg-chirho;
        spacing: ThemeChirho.spacing-md-chirho;

        HorizontalLayout {
            Text {
                text: "Module Manager";
                font-size: ThemeChirho.font-size-lg-chirho;
                font-weight: 600;
                color: ThemeChirho.text-primary-chirho;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            IconButtonChirho {
                icon-chirho: LabelsChirho.close-icon-chirho;
                clicked-chirho => {
                    AppStateChirho.module-manager-visible-chirho = false;
                }
            }
        }

        Rectangle {
            height: 1px;
            background: ThemeChirho.divider-chirho;
        }

        // Refresh button and status
        HorizontalLayout {
            spacing: ThemeChirho.spacing-sm-chirho;

            Rectangle {
                background: refresh-touch-chirho.has-hover ? ThemeChirho.accent-hover-chirho : ThemeChirho.accent-chirho;
                border-radius: ThemeChirho.radius-sm-chirho;
                height: 32px;
                width: 140px;

                animate background { duration: ThemeChirho.animation-fast-chirho; easing: ease-out; }

                refresh-touch-chirho := TouchArea {
                    clicked => {
                        if (!AppStateChirho.module-manager-loading-chirho) {
                            AppStateChirho.refresh-remote-modules-chirho();
                        }
                    }
                    mouse-cursor: pointer;
                }

                Text {
                    text: AppStateChirho.module-manager-loading-chirho ? "Loading..." : "🔄 Refresh List";
                    font-size: ThemeChirho.font-size-sm-chirho;
                    font-weight: 500;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                text: AppStateChirho.module-manager-status-chirho;
                font-size: ThemeChirho.font-size-xs-chirho;
                color: ThemeChirho.text-muted-chirho;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: 1px;
            background: ThemeChirho.divider-chirho;
        }

        // Module count
        Text {
            text: AppStateChirho.remote-modules-chirho.length > 0 ?
                "Available: " + AppStateChirho.remote-modules-chirho.length + " modules" :
                "Click Refresh to load available modules";
            font-size: ThemeChirho.font-size-sm-chirho;
            color: ThemeChirho.text-secondary-chirho;
        }

        // Module list
        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: ThemeChirho.spacing-sm-chirho;

                for mod-chirho in AppStateChirho.remote-modules-chirho: Rectangle {
                    height: 70px;
                    background: mod-touch-chirho.has-hover ? ThemeChirho.background-elevated-chirho : ThemeChirho.background-tertiary-chirho;
                    border-radius: ThemeChirho.radius-md-chirho;
                    border-width: mod-chirho.is-installed-chirho ? 1px : 0px;
                    border-color: ThemeChirho.success-chirho;

                    animate background { duration: ThemeChirho.animation-fast-chirho; easing: ease-out; }

                    mod-touch-chirho := TouchArea {
                        mouse-cursor: pointer;
                    }

                    HorizontalLayout {
                        padding: ThemeChirho.spacing-md-chirho;
                        spacing: ThemeChirho.spacing-md-chirho;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: ThemeChirho.spacing-xs-chirho;

                            HorizontalLayout {
                                spacing: ThemeChirho.spacing-sm-chirho;

                                Text {
                                    text: mod-chirho.name-chirho;
                                    font-size: ThemeChirho.font-size-md-chirho;
                                    font-weight: 600;
                                    color: ThemeChirho.text-primary-chirho;
                                    vertical-alignment: center;
                                }

                                if mod-chirho.is-installed-chirho: Rectangle {
                                    width: 60px;
                                    height: 18px;
                                    background: ThemeChirho.success-chirho;
                                    border-radius: 9px;

                                    Text {
                                        text: "Installed";
                                        font-size: ThemeChirho.font-size-xs-chirho;
                                        color: white;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Text {
                                text: mod-chirho.description-chirho;
                                font-size: ThemeChirho.font-size-sm-chirho;
                                color: ThemeChirho.text-secondary-chirho;
                                overflow: elide;
                            }

                            HorizontalLayout {
                                spacing: ThemeChirho.spacing-md-chirho;

                                Text {
                                    text: mod-chirho.language-chirho;
                                    font-size: ThemeChirho.font-size-xs-chirho;
                                    color: ThemeChirho.text-muted-chirho;
                                }
                                Text {
                                    text: mod-chirho.type-chirho;
                                    font-size: ThemeChirho.font-size-xs-chirho;
                                    color: ThemeChirho.text-muted-chirho;
                                }
                            }
                        }

                        // Install/Uninstall button
                        Rectangle {
                            width: 80px;
                            height: 28px;
                            background: mod-chirho.is-installed-chirho ?
                                (install-btn-touch-chirho.has-hover ? ThemeChirho.error-chirho : ThemeChirho.background-elevated-chirho) :
                                (install-btn-touch-chirho.has-hover ? ThemeChirho.accent-hover-chirho : ThemeChirho.accent-chirho);
                            border-radius: ThemeChirho.radius-sm-chirho;

                            animate background { duration: ThemeChirho.animation-fast-chirho; easing: ease-out; }

                            install-btn-touch-chirho := TouchArea {
                                clicked => {
                                    if (mod-chirho.is-installed-chirho) {
                                        AppStateChirho.uninstall-module-chirho(mod-chirho.name-chirho);
                                    } else {
                                        AppStateChirho.install-module-chirho(mod-chirho.name-chirho);
                                    }
                                }
                                mouse-cursor: pointer;
                            }

                            Text {
                                text: mod-chirho.is-installed-chirho ? "Remove" : "Install";
                                font-size: ThemeChirho.font-size-sm-chirho;
                                font-weight: 500;
                                color: mod-chirho.is-installed-chirho ? ThemeChirho.text-primary-chirho : white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}

// Quick Navigation dialog (Ctrl+K command palette)
component QuickNavDialogChirho inherits Rectangle {
    in-out property <bool> visible-chirho: false;

    width: 100%;
    height: 100%;
    background: visible-chirho ? #00000080 : transparent;

    animate background { duration: ThemeChirho.animation-normal-chirho; }

    if visible-chirho: Rectangle {
        x: (parent.width - self.width) / 2;
        y: 80px;
        width: 500px;
        height: 400px;
        background: ThemeChirho.background-secondary-chirho;
        border-radius: ThemeChirho.radius-lg-chirho;
        border-width: 1px;
        border-color: ThemeChirho.border-chirho;
        drop-shadow-blur: 30px;
        drop-shadow-color: #00000060;

        VerticalLayout {
            padding: ThemeChirho.spacing-md-chirho;
            spacing: ThemeChirho.spacing-sm-chirho;

            // Search input with icon
            HorizontalLayout {
                spacing: ThemeChirho.spacing-sm-chirho;
                height: 44px;

                Rectangle {
                    width: 36px;
                    height: 36px;

                    Text {
                        text: LabelsChirho.goto-icon-chirho;
                        font-size: 18px;
                        color: ThemeChirho.accent-chirho;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: "Type verse reference (John 3:16) or book name...";
                    text <=> AppStateChirho.quick-nav-query-chirho;
                    accepted => {
                        // Navigate to first result or try direct reference
                        if (AppStateChirho.quick-nav-results-chirho.length > 0) {
                            AppStateChirho.navigate-to-chirho(
                                AppStateChirho.quick-nav-results-chirho[0].book-chirho,
                                AppStateChirho.quick-nav-results-chirho[0].chapter-chirho,
                                1
                            );
                        } else {
                            AppStateChirho.goto-verse-chirho(AppStateChirho.quick-nav-query-chirho);
                        }
                        AppStateChirho.quick-nav-visible-chirho = false;
                        AppStateChirho.quick-nav-query-chirho = "";
                    }
                    edited => {
                        AppStateChirho.quick-nav-search-chirho(AppStateChirho.quick-nav-query-chirho);
                    }
                }

                IconButtonChirho {
                    icon-chirho: LabelsChirho.close-icon-chirho;
                    clicked-chirho => {
                        AppStateChirho.quick-nav-visible-chirho = false;
                        AppStateChirho.quick-nav-query-chirho = "";
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: ThemeChirho.divider-chirho;
            }

            // Hint text
            Text {
                text: "Quick navigation: Enter a verse reference or book name";
                font-size: ThemeChirho.font-size-xs-chirho;
                color: ThemeChirho.text-muted-chirho;
            }

            // Results list
            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 4px;

                    // Show matching books/recent locations
                    for result-chirho in AppStateChirho.quick-nav-results-chirho: Rectangle {
                        height: 48px;
                        background: qn-touch-chirho.has-hover ? ThemeChirho.background-elevated-chirho : ThemeChirho.background-tertiary-chirho;
                        border-radius: ThemeChirho.radius-md-chirho;

                        animate background { duration: ThemeChirho.animation-fast-chirho; easing: ease-out; }

                        qn-touch-chirho := TouchArea {
                            clicked => {
                                AppStateChirho.navigate-to-chirho(
                                    result-chirho.book-chirho,
                                    result-chirho.chapter-chirho,
                                    1
                                );
                                AppStateChirho.quick-nav-visible-chirho = false;
                                AppStateChirho.quick-nav-query-chirho = "";
                            }
                            mouse-cursor: pointer;
                        }

                        HorizontalLayout {
                            padding: ThemeChirho.spacing-md-chirho;
                            spacing: ThemeChirho.spacing-md-chirho;

                            Text {
                                text: "Go";
                                font-size: 16px;
                                vertical-alignment: center;
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;

                                Text {
                                    text: result-chirho.book-chirho + " " + result-chirho.chapter-chirho;
                                    font-size: ThemeChirho.font-size-md-chirho;
                                    font-weight: 500;
                                    color: ThemeChirho.text-primary-chirho;
                                    vertical-alignment: center;
                                }

                                if result-chirho.timestamp-chirho != "": Text {
                                    text: "Recent: " + result-chirho.timestamp-chirho;
                                    font-size: ThemeChirho.font-size-xs-chirho;
                                    color: ThemeChirho.text-muted-chirho;
                                }
                            }

                            Text {
                                text: "↵";
                                font-size: 14px;
                                color: ThemeChirho.text-disabled-chirho;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Empty state
                    if AppStateChirho.quick-nav-results-chirho.length == 0: VerticalLayout {
                        padding-top: ThemeChirho.spacing-xl-chirho;
                        spacing: ThemeChirho.spacing-sm-chirho;

                        Text {
                            text: AppStateChirho.quick-nav-query-chirho == "" ? "Start typing to search..." : "No matches found";
                            font-size: ThemeChirho.font-size-md-chirho;
                            color: ThemeChirho.text-muted-chirho;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Examples: John 3:16, Gen 1, Psalm 23";
                            font-size: ThemeChirho.font-size-sm-chirho;
                            color: ThemeChirho.text-disabled-chirho;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            // Keyboard hint
            HorizontalLayout {
                spacing: ThemeChirho.spacing-lg-chirho;
                alignment: center;

                HorizontalLayout {
                    spacing: 4px;
                    Rectangle {
                        width: 24px;
                        height: 20px;
                        background: ThemeChirho.background-tertiary-chirho;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: ThemeChirho.border-subtle-chirho;

                        Text {
                            text: "↵";
                            font-size: 11px;
                            color: ThemeChirho.text-muted-chirho;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: "Go";
                        font-size: ThemeChirho.font-size-xs-chirho;
                        color: ThemeChirho.text-muted-chirho;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 4px;
                    Rectangle {
                        width: 32px;
                        height: 20px;
                        background: ThemeChirho.background-tertiary-chirho;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: ThemeChirho.border-subtle-chirho;

                        Text {
                            text: "Esc";
                            font-size: 10px;
                            color: ThemeChirho.text-muted-chirho;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: "Close";
                        font-size: ThemeChirho.font-size-xs-chirho;
                        color: ThemeChirho.text-muted-chirho;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // Close when clicking outside
    TouchArea {
        enabled: visible-chirho;
        clicked => {
            root.visible-chirho = false;
            AppStateChirho.quick-nav-query-chirho = "";
        }
    }
}

// Onboarding Wizard component (first-run experience)
component OnboardingWizardChirho inherits Rectangle {
    in-out property <bool> visible-chirho: false;

    width: 100%;
    height: 100%;
    background: visible-chirho ? #000000cc : transparent;

    if visible-chirho: Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 600px;
        height: 500px;
        background: ThemeChirho.background-secondary-chirho;
        border-radius: ThemeChirho.radius-lg-chirho;
        border-width: 1px;
        border-color: ThemeChirho.border-chirho;
        drop-shadow-blur: 32px;
        drop-shadow-color: #00000040;
        clip: true;

        VerticalLayout {
            padding: ThemeChirho.spacing-xl-chirho;
            spacing: ThemeChirho.spacing-lg-chirho;

            // Header with app branding
            HorizontalLayout {
                alignment: center;
                spacing: ThemeChirho.spacing-md-chirho;

                Text {
                    text: "*";
                    font-size: 48px;
                    color: ThemeChirho.accent-chirho;
                }
            }

            // Step content area
            Rectangle {
                vertical-stretch: 1;
                background: transparent;

                // Welcome Step (step 0)
                if AppStateChirho.onboarding-step-chirho == 0: VerticalLayout {
                    alignment: center;
                    spacing: ThemeChirho.spacing-lg-chirho;
                    padding: ThemeChirho.spacing-xl-chirho;

                    Text {
                        text: "Welcome to Codex Lux";
                        font-size: ThemeChirho.font-size-xl-chirho;
                        font-weight: 700;
                        color: ThemeChirho.text-primary-chirho;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "\"For God so loved the world that he gave his only begotten Son,\nthat whoever believes in him should not perish but have eternal life.\"";
                        font-size: ThemeChirho.font-size-md-chirho;
                        color: ThemeChirho.text-secondary-chirho;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    Text {
                        text: "— John 3:16";
                        font-size: ThemeChirho.font-size-sm-chirho;
                        color: ThemeChirho.accent-chirho;
                        horizontal-alignment: center;
                    }

                    Rectangle { height: ThemeChirho.spacing-lg-chirho; }

                    Text {
                        text: "A beautiful, cross-platform Bible study application\nbuilt with love to help you explore Scripture.";
                        font-size: ThemeChirho.font-size-md-chirho;
                        color: ThemeChirho.text-muted-chirho;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                // Features Tour Step (step 1)
                if AppStateChirho.onboarding-step-chirho == 1: VerticalLayout {
                    alignment: start;
                    spacing: ThemeChirho.spacing-md-chirho;
                    padding: ThemeChirho.spacing-md-chirho;

                    Text {
                        text: "Key Features";
                        font-size: ThemeChirho.font-size-lg-chirho;
                        font-weight: 600;
                        color: ThemeChirho.text-primary-chirho;
                        horizontal-alignment: center;
                    }

                    Rectangle { height: ThemeChirho.spacing-sm-chirho; }

                    // Feature list grid
                    GridLayout {
                        spacing: ThemeChirho.spacing-md-chirho;

                        Row {
                            HorizontalLayout {
                                spacing: ThemeChirho.spacing-sm-chirho;
                                Text { text: "Go"; font-size: 20px; }
                                VerticalLayout {
                                    Text { text: "Multiple Translations"; font-size: 13px; font-weight: 600; color: ThemeChirho.text-primary-chirho; }
                                    Text { text: "Load SWORD Bible modules"; font-size: 11px; color: ThemeChirho.text-muted-chirho; }
                                }
                            }
                            HorizontalLayout {
                                spacing: ThemeChirho.spacing-sm-chirho;
                                Text { text: "?"; font-size: 20px; }
                                VerticalLayout {
                                    Text { text: "Full-Text Search"; font-size: 13px; font-weight: 600; color: ThemeChirho.text-primary-chirho; }
                                    Text { text: "Search across all text"; font-size: 11px; color: ThemeChirho.text-muted-chirho; }
                                }
                            }
                        }

                        Row {
                            HorizontalLayout {
                                spacing: ThemeChirho.spacing-sm-chirho;
                                Text { text: "*"; font-size: 20px; color: #fbbf24; }
                                VerticalLayout {
                                    Text { text: "Highlights"; font-size: 13px; font-weight: 600; color: ThemeChirho.text-primary-chirho; }
                                    Text { text: "Mark verses with colors"; font-size: 11px; color: ThemeChirho.text-muted-chirho; }
                                }
                            }
                            HorizontalLayout {
                                spacing: ThemeChirho.spacing-sm-chirho;
                                Text { text: "Bk"; font-size: 20px; }
                                VerticalLayout {
                                    Text { text: "Bookmarks"; font-size: 13px; font-weight: 600; color: ThemeChirho.text-primary-chirho; }
                                    Text { text: "Save favorite verses"; font-size: 11px; color: ThemeChirho.text-muted-chirho; }
                                }
                            }
                        }

                        Row {
                            HorizontalLayout {
                                spacing: ThemeChirho.spacing-sm-chirho;
                                Text { text: "📝"; font-size: 20px; }
                                VerticalLayout {
                                    Text { text: "Personal Notes"; font-size: 13px; font-weight: 600; color: ThemeChirho.text-primary-chirho; }
                                    Text { text: "Add notes to any verse"; font-size: 11px; color: ThemeChirho.text-muted-chirho; }
                                }
                            }
                            HorizontalLayout {
                                spacing: ThemeChirho.spacing-sm-chirho;
                                Text { text: "D"; font-size: 20px; }
                                VerticalLayout {
                                    Text { text: "Themes"; font-size: 13px; font-weight: 600; color: ThemeChirho.text-primary-chirho; }
                                    Text { text: "Dark, Light, and Sepia"; font-size: 11px; color: ThemeChirho.text-muted-chirho; }
                                }
                            }
                        }
                    }
                }

                // Keyboard Shortcuts Step (step 2)
                if AppStateChirho.onboarding-step-chirho == 2: VerticalLayout {
                    alignment: start;
                    spacing: ThemeChirho.spacing-sm-chirho;
                    padding: ThemeChirho.spacing-md-chirho;

                    Text {
                        text: "Keyboard Shortcuts";
                        font-size: ThemeChirho.font-size-lg-chirho;
                        font-weight: 600;
                        color: ThemeChirho.text-primary-chirho;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "Navigate quickly with these shortcuts";
                        font-size: ThemeChirho.font-size-sm-chirho;
                        color: ThemeChirho.text-muted-chirho;
                        horizontal-alignment: center;
                    }

                    Rectangle { height: ThemeChirho.spacing-sm-chirho; }

                    // Shortcuts list
                    GridLayout {
                        spacing: ThemeChirho.spacing-sm-chirho;

                        Row {
                            Rectangle {
                                width: 80px;
                                height: 28px;
                                background: ThemeChirho.background-tertiary-chirho;
                                border-radius: 4px;
                                Text { text: "Ctrl+K"; font-size: 12px; color: ThemeChirho.text-primary-chirho; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Text { text: "Quick navigation (command palette)"; font-size: 13px; color: ThemeChirho.text-secondary-chirho; vertical-alignment: center; }
                        }
                        Row {
                            Rectangle {
                                width: 80px;
                                height: 28px;
                                background: ThemeChirho.background-tertiary-chirho;
                                border-radius: 4px;
                                Text { text: "Ctrl+G"; font-size: 12px; color: ThemeChirho.text-primary-chirho; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Text { text: "Go to verse dialog"; font-size: 13px; color: ThemeChirho.text-secondary-chirho; vertical-alignment: center; }
                        }
                        Row {
                            Rectangle {
                                width: 80px;
                                height: 28px;
                                background: ThemeChirho.background-tertiary-chirho;
                                border-radius: 4px;
                                Text { text: "← / →"; font-size: 12px; color: ThemeChirho.text-primary-chirho; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Text { text: "Previous / Next chapter"; font-size: 13px; color: ThemeChirho.text-secondary-chirho; vertical-alignment: center; }
                        }
                        Row {
                            Rectangle {
                                width: 80px;
                                height: 28px;
                                background: ThemeChirho.background-tertiary-chirho;
                                border-radius: 4px;
                                Text { text: "Ctrl+F"; font-size: 12px; color: ThemeChirho.text-primary-chirho; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Text { text: "Toggle search panel"; font-size: 13px; color: ThemeChirho.text-secondary-chirho; vertical-alignment: center; }
                        }
                        Row {
                            Rectangle {
                                width: 80px;
                                height: 28px;
                                background: ThemeChirho.background-tertiary-chirho;
                                border-radius: 4px;
                                Text { text: "Ctrl+T"; font-size: 12px; color: ThemeChirho.text-primary-chirho; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Text { text: "Cycle themes (Dark → Light → Sepia)"; font-size: 13px; color: ThemeChirho.text-secondary-chirho; vertical-alignment: center; }
                        }
                        Row {
                            Rectangle {
                                width: 80px;
                                height: 28px;
                                background: ThemeChirho.background-tertiary-chirho;
                                border-radius: 4px;
                                Text { text: "Escape"; font-size: 12px; color: ThemeChirho.text-primary-chirho; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Text { text: "Close dialogs and panels"; font-size: 13px; color: ThemeChirho.text-secondary-chirho; vertical-alignment: center; }
                        }
                    }
                }

                // Get Started Step (step 3)
                if AppStateChirho.onboarding-step-chirho == 3: VerticalLayout {
                    alignment: center;
                    spacing: ThemeChirho.spacing-lg-chirho;
                    padding: ThemeChirho.spacing-xl-chirho;

                    Text {
                        text: "You're All Set!";
                        font-size: ThemeChirho.font-size-xl-chirho;
                        font-weight: 700;
                        color: ThemeChirho.text-primary-chirho;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "*";
                        font-size: 48px;
                        color: ThemeChirho.accent-chirho;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "Start exploring Scripture with Codex Lux.\nUse the sidebar to browse books, or press Ctrl+K\nto quickly navigate to any passage.";
                        font-size: ThemeChirho.font-size-md-chirho;
                        color: ThemeChirho.text-secondary-chirho;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    Text {
                        text: "Tip: Right-click any verse for quick actions!";
                        font-size: ThemeChirho.font-size-sm-chirho;
                        color: ThemeChirho.accent-chirho;
                        horizontal-alignment: center;
                    }
                }
            }

            // Step indicators
            HorizontalLayout {
                alignment: center;
                spacing: ThemeChirho.spacing-sm-chirho;

                for step-idx-chirho in 4: Rectangle {
                    width: step-idx-chirho == AppStateChirho.onboarding-step-chirho ? 24px : 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: step-idx-chirho == AppStateChirho.onboarding-step-chirho ? ThemeChirho.accent-chirho : ThemeChirho.background-elevated-chirho;

                    animate width { duration: ThemeChirho.animation-normal-chirho; easing: ease-out; }
                    animate background { duration: ThemeChirho.animation-normal-chirho; easing: ease-out; }
                }
            }

            // Navigation buttons
            HorizontalLayout {
                alignment: space-between;

                // Skip button
                Rectangle {
                    width: 80px;
                    height: 36px;
                    border-radius: ThemeChirho.radius-md-chirho;
                    background: skip-touch-chirho.has-hover ? ThemeChirho.background-elevated-chirho : transparent;

                    Text {
                        text: "Skip";
                        font-size: ThemeChirho.font-size-md-chirho;
                        color: ThemeChirho.text-muted-chirho;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    skip-touch-chirho := TouchArea {
                        clicked => {
                            AppStateChirho.onboarding-skip-chirho();
                        }
                        mouse-cursor: pointer;
                    }
                }

                // Next/Finish button
                Rectangle {
                    width: 120px;
                    height: 36px;
                    border-radius: ThemeChirho.radius-md-chirho;
                    background: next-touch-chirho.has-hover ? ThemeChirho.accent-hover-chirho : ThemeChirho.accent-chirho;

                    Text {
                        text: AppStateChirho.onboarding-step-chirho == 3 ? "Get Started" : "Next";
                        font-size: ThemeChirho.font-size-md-chirho;
                        font-weight: 500;
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    next-touch-chirho := TouchArea {
                        clicked => {
                            if (AppStateChirho.onboarding-step-chirho < 3) {
                                AppStateChirho.onboarding-step-chirho += 1;
                            } else {
                                AppStateChirho.onboarding-complete-chirho();
                            }
                        }
                        mouse-cursor: pointer;
                    }
                }
            }
        }
    }
}

// Main application window
export component MainWindowChirho inherits Window {
    title: "Codex Lux Chirho";
    preferred-width: 1280px;
    preferred-height: 820px;
    background: ThemeChirho.background-primary-chirho;

    // Keyboard shortcuts
    FocusScope {
        key-pressed(event-chirho) => {
            // Left arrow: Previous chapter
            if (event-chirho.text == Key.LeftArrow && !event-chirho.modifiers.control) {
                if (AppStateChirho.current-chapter-chirho > 1) {
                    AppStateChirho.navigate-to-chirho(
                        AppStateChirho.current-book-chirho,
                        AppStateChirho.current-chapter-chirho - 1,
                        1
                    );
                }
                return accept;
            }
            // Right arrow: Next chapter
            if (event-chirho.text == Key.RightArrow && !event-chirho.modifiers.control) {
                AppStateChirho.navigate-to-chirho(
                    AppStateChirho.current-book-chirho,
                    AppStateChirho.current-chapter-chirho + 1,
                    1
                );
                return accept;
            }
            // Ctrl+F: Toggle search
            if (event-chirho.text == "f" && event-chirho.modifiers.control) {
                AppStateChirho.search-active-chirho = !AppStateChirho.search-active-chirho;
                return accept;
            }
            // Ctrl+G: Goto verse
            if (event-chirho.text == "g" && event-chirho.modifiers.control) {
                AppStateChirho.goto-dialog-visible-chirho = !AppStateChirho.goto-dialog-visible-chirho;
                return accept;
            }
            // Ctrl+T: Toggle theme (cycles: Dark → Light → Sepia → High Contrast → Dark)
            if (event-chirho.text == "t" && event-chirho.modifiers.control) {
                ThemeChirho.theme-index-chirho = Math.mod(ThemeChirho.theme-index-chirho + 1, 4);
                return accept;
            }
            // Ctrl+K: Quick navigation
            if (event-chirho.text == "k" && event-chirho.modifiers.control) {
                AppStateChirho.quick-nav-visible-chirho = !AppStateChirho.quick-nav-visible-chirho;
                if (!AppStateChirho.quick-nav-visible-chirho) {
                    AppStateChirho.quick-nav-query-chirho = "";
                }
                return accept;
            }
            // Escape: Close dialogs
            if (event-chirho.text == Key.Escape) {
                if (AppStateChirho.context-menu-visible-chirho) {
                    AppStateChirho.context-menu-visible-chirho = false;
                    return accept;
                }
                if (AppStateChirho.quick-nav-visible-chirho) {
                    AppStateChirho.quick-nav-visible-chirho = false;
                    AppStateChirho.quick-nav-query-chirho = "";
                    return accept;
                }
                if (AppStateChirho.goto-dialog-visible-chirho) {
                    AppStateChirho.goto-dialog-visible-chirho = false;
                    return accept;
                }
                if (AppStateChirho.search-active-chirho) {
                    AppStateChirho.search-active-chirho = false;
                    return accept;
                }
            }
            // Ctrl+B: Toggle sidebar (books panel)
            if (event-chirho.text == "b" && event-chirho.modifiers.control) {
                AppStateChirho.sidebar-visible-chirho = !AppStateChirho.sidebar-visible-chirho;
                return accept;
            }
            // Ctrl+D: Toggle bookmarks panel
            if (event-chirho.text == "d" && event-chirho.modifiers.control) {
                AppStateChirho.bookmarks-visible-chirho = !AppStateChirho.bookmarks-visible-chirho;
                return accept;
            }
            // Ctrl+H: Toggle highlights panel
            if (event-chirho.text == "h" && event-chirho.modifiers.control) {
                AppStateChirho.highlights-visible-chirho = !AppStateChirho.highlights-visible-chirho;
                if (AppStateChirho.highlights-visible-chirho) {
                    AppStateChirho.load-all-highlights-chirho();
                }
                return accept;
            }
            // Ctrl+N: Toggle notes panel
            if (event-chirho.text == "n" && event-chirho.modifiers.control) {
                AppStateChirho.notes-visible-chirho = !AppStateChirho.notes-visible-chirho;
                if (AppStateChirho.notes-visible-chirho) {
                    AppStateChirho.load-all-notes-chirho();
                }
                return accept;
            }
            // Ctrl+M: Toggle module manager panel
            if (event-chirho.text == "m" && event-chirho.modifiers.control) {
                AppStateChirho.module-manager-visible-chirho = !AppStateChirho.module-manager-visible-chirho;
                return accept;
            }
            // Ctrl+P: Toggle parallel view (side-by-side translation)
            if (event-chirho.text == "p" && event-chirho.modifiers.control) {
                AppStateChirho.parallel-view-enabled-chirho = !AppStateChirho.parallel-view-enabled-chirho;
                return accept;
            }
            // Ctrl+I: Toggle info panel (verse details)
            if (event-chirho.text == "i" && event-chirho.modifiers.control) {
                AppStateChirho.info-panel-visible-chirho = !AppStateChirho.info-panel-visible-chirho;
                return accept;
            }
            // Ctrl+Y: Toggle statistics panel (analYtics)
            if (event-chirho.text == "y" && event-chirho.modifiers.control) {
                AppStateChirho.stats-panel-visible-chirho = !AppStateChirho.stats-panel-visible-chirho;
                if AppStateChirho.stats-panel-visible-chirho {
                    AppStateChirho.load-statistics-chirho();
                }
                return accept;
            }
            // Ctrl+J: Toggle journal panel
            if (event-chirho.text == "j" && event-chirho.modifiers.control) {
                AppStateChirho.journal-panel-visible-chirho = !AppStateChirho.journal-panel-visible-chirho;
                if AppStateChirho.journal-panel-visible-chirho {
                    AppStateChirho.load-journal-entries-chirho();
                }
                return accept;
            }
            // Ctrl+R: Toggle prayer list panel (pRayer)
            if (event-chirho.text == "r" && event-chirho.modifiers.control) {
                AppStateChirho.prayer-panel-visible-chirho = !AppStateChirho.prayer-panel-visible-chirho;
                if AppStateChirho.prayer-panel-visible-chirho {
                    AppStateChirho.load-prayer-requests-chirho();
                }
                return accept;
            }
            // Ctrl+Shift+V: Show Verse of the Day dialog (V for Verse)
            if (event-chirho.text == "V" && event-chirho.modifiers.control && event-chirho.modifiers.shift) {
                AppStateChirho.load-verse-of-the-day-chirho();
                AppStateChirho.votd-dialog-visible-chirho = true;
                return accept;
            }
            // Ctrl+,: Toggle settings panel (standard macOS shortcut)
            if (event-chirho.text == "," && event-chirho.modifiers.control) {
                AppStateChirho.settings-visible-chirho = !AppStateChirho.settings-visible-chirho;
                return accept;
            }
            // Ctrl+Shift+S: Toggle Strong's Numbers display
            if (event-chirho.text == "S" && event-chirho.modifiers.control && event-chirho.modifiers.shift) {
                AppStateChirho.toggle-strongs-display-chirho();
                return accept;
            }
            // Ctrl+Shift+P: Toggle Reading Plans panel
            if (event-chirho.text == "P" && event-chirho.modifiers.control && event-chirho.modifiers.shift) {
                AppStateChirho.reading-plan-panel-visible-chirho = !AppStateChirho.reading-plan-panel-visible-chirho;
                if AppStateChirho.reading-plan-panel-visible-chirho {
                    AppStateChirho.load-reading-plans-chirho();
                }
                return accept;
            }
            // Ctrl+Shift+M: Toggle Morphology display
            if (event-chirho.text == "M" && event-chirho.modifiers.control && event-chirho.modifiers.shift) {
                AppStateChirho.toggle-morphology-display-chirho();
                return accept;
            }
            // Ctrl+Shift+X: Toggle Cross-References display
            if (event-chirho.text == "X" && event-chirho.modifiers.control && event-chirho.modifiers.shift) {
                AppStateChirho.toggle-cross-refs-display-chirho();
                return accept;
            }
            // Ctrl+Shift+F: Toggle Footnotes display
            if (event-chirho.text == "F" && event-chirho.modifiers.control && event-chirho.modifiers.shift) {
                AppStateChirho.toggle-footnotes-display-chirho();
                return accept;
            }
            // Ctrl+Shift+C: Toggle Commentary panel
            if (event-chirho.text == "C" && event-chirho.modifiers.control && event-chirho.modifiers.shift) {
                AppStateChirho.commentary-panel-visible-chirho = !AppStateChirho.commentary-panel-visible-chirho;
                if AppStateChirho.commentary-panel-visible-chirho {
                    AppStateChirho.load-commentary-chirho(
                        AppStateChirho.current-book-chirho + " " + AppStateChirho.current-chapter-chirho + ":1"
                    );
                }
                return accept;
            }
            // Ctrl+Shift+L: Toggle Lexicon panel
            if (event-chirho.text == "L" && event-chirho.modifiers.control && event-chirho.modifiers.shift) {
                AppStateChirho.lexicon-panel-visible-chirho = !AppStateChirho.lexicon-panel-visible-chirho;
                return accept;
            }
            // Ctrl+Shift+I: Toggle Interlinear display
            if (event-chirho.text == "I" && event-chirho.modifiers.control && event-chirho.modifiers.shift) {
                AppStateChirho.toggle-interlinear-display-chirho();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            ToolbarChirho {}

            SearchPanelChirho {
                visible-chirho: AppStateChirho.search-active-chirho;
            }

            HorizontalLayout {
                vertical-stretch: 1;

                if AppStateChirho.sidebar-visible-chirho: SidebarChirho {
                    animate width { duration: ThemeChirho.animation-normal-chirho; easing: ease-out; }
                }

                BibleViewChirho {
                    horizontal-stretch: 1;
                }

                ParallelPaneChirho {
                    visible-chirho: AppStateChirho.parallel-view-enabled-chirho;
                }

                BookmarksPanelChirho {
                    visible-chirho: AppStateChirho.bookmarks-visible-chirho;
                }

                HighlightsPanelChirho {
                    visible-chirho: AppStateChirho.highlights-visible-chirho;
                }

                NotesPanelChirho {
                    visible-chirho: AppStateChirho.notes-visible-chirho;
                }

                InfoPanelChirho {
                    visible-chirho: AppStateChirho.info-panel-visible-chirho;
                }

                StatisticsPanelChirho {
                    visible-chirho: AppStateChirho.stats-panel-visible-chirho;
                }

                JournalPanelChirho {
                    visible-chirho: AppStateChirho.journal-panel-visible-chirho;
                }

                PrayerPanelChirho {
                    visible-chirho: AppStateChirho.prayer-panel-visible-chirho;
                }

                ReadingPlanPanelChirho {
                    visible-chirho: AppStateChirho.reading-plan-panel-visible-chirho;
                }

                CommentaryPanelChirho {
                    visible-chirho: AppStateChirho.commentary-panel-visible-chirho;
                }

                LexiconPanelChirho {
                    visible-chirho: AppStateChirho.lexicon-panel-visible-chirho;
                }

                InterlinearPanelChirho {
                    visible-chirho: AppStateChirho.interlinear-visible-chirho;
                }

                ModuleManagerPanelChirho {
                    visible-chirho: AppStateChirho.module-manager-visible-chirho;
                }
            }

            StatusBarChirho {}
        }

        // Overlay dialogs
        ChapterSelectorChirho {
            visible-chirho: AppStateChirho.chapter-selector-visible-chirho;
        }

        GotoDialogChirho {
            visible-chirho: AppStateChirho.goto-dialog-visible-chirho;
        }

        QuickNavDialogChirho {
            visible-chirho: AppStateChirho.quick-nav-visible-chirho;
        }

        ContextMenuChirho {
            visible-chirho: AppStateChirho.context-menu-visible-chirho;
            menu-x-chirho: AppStateChirho.context-menu-x-chirho;
            menu-y-chirho: AppStateChirho.context-menu-y-chirho;
            verse-ref-chirho: AppStateChirho.context-menu-verse-ref-chirho;
            verse-text-chirho: AppStateChirho.context-menu-verse-text-chirho;
        }

        NoteDialogChirho {
            visible-chirho: AppStateChirho.note-dialog-visible-chirho;
        }

        ImportDialogChirho {}

        VotdDialogChirho {}

        // Strong's lookup popup (positioned at the cursor/click location)
        if AppStateChirho.strongs-popup-visible-chirho: Rectangle {
            x: AppStateChirho.strongs-popup-x-chirho;
            y: AppStateChirho.strongs-popup-y-chirho;

            StrongsPopupChirho {
                entry-chirho: AppStateChirho.strongs-current-entry-chirho;
                visible-chirho: AppStateChirho.strongs-popup-visible-chirho;
            }
        }

        // Morphology popup (positioned at click location)
        if AppStateChirho.morphology-popup-visible-chirho: Rectangle {
            x: AppStateChirho.morphology-popup-x-chirho;
            y: AppStateChirho.morphology-popup-y-chirho;

            MorphologyPopupChirho {
                visible-chirho: AppStateChirho.morphology-popup-visible-chirho;
            }
        }

        // Cross-references popup
        if AppStateChirho.cross-refs-popup-visible-chirho: Rectangle {
            x: AppStateChirho.cross-refs-popup-x-chirho;
            y: AppStateChirho.cross-refs-popup-y-chirho;

            CrossRefsPopupChirho {
                visible-chirho: AppStateChirho.cross-refs-popup-visible-chirho;
            }
        }

        // Footnote popup
        if AppStateChirho.footnote-popup-visible-chirho: Rectangle {
            x: AppStateChirho.footnote-popup-x-chirho;
            y: AppStateChirho.footnote-popup-y-chirho;

            FootnotePopupChirho {
                visible-chirho: AppStateChirho.footnote-popup-visible-chirho;
            }
        }

        HistoryPanelChirho {
            visible-chirho: AppStateChirho.history-visible-chirho;
        }

        SettingsPanelChirho {
            visible-chirho: AppStateChirho.settings-visible-chirho;
        }

        OnboardingWizardChirho {
            visible-chirho: AppStateChirho.onboarding-visible-chirho;
        }
    }
}
