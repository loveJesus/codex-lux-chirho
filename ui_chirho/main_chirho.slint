            }

            Text {
                text: "Click the bookmark icon on a verse to add one";
                font-size: ThemeChirho.font-size-sm-chirho;
                color: ThemeChirho.text-disabled-chirho;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: ThemeChirho.spacing-sm-chirho;

                for bookmark-chirho in AppStateChirho.bookmarks-chirho: Rectangle {
                    height: 64px;
                    background: bm-touch-chirho.has-hover ? ThemeChirho.background-elevated-chirho : ThemeChirho.background-tertiary-chirho;
                    border-radius: ThemeChirho.radius-md-chirho;

                    animate background { duration: ThemeChirho.animation-fast-chirho; easing: ease-out; }

                    bm-touch-chirho := TouchArea {
                        clicked => {
                            AppStateChirho.navigate-to-chirho(
                                bookmark-chirho.book-chirho,
                                bookmark-chirho.chapter-chirho,
                                bookmark-chirho.verse-chirho
                            );
                        }
                        mouse-cursor: pointer;
                    }

                    VerticalLayout {
                        padding: ThemeChirho.spacing-md-chirho;
                        spacing: ThemeChirho.spacing-xs-chirho;

                        HorizontalLayout {
                            Text {
                                text: LabelsChirho.bookmark-icon-chirho;
                                font-size: 14px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: bookmark-chirho.reference-chirho;
                                font-size: ThemeChirho.font-size-md-chirho;
                                font-weight: 600;
                                color: ThemeChirho.accent-chirho;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }

                        if bookmark-chirho.label-chirho != "": Text {
                            text: bookmark-chirho.label-chirho;
                            font-size: ThemeChirho.font-size-sm-chirho;
                            color: ThemeChirho.text-secondary-chirho;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}

// Highlights list panel
component HighlightsPanelChirho inherits Rectangle {
    in-out property <bool> visible-chirho: false;

    width: visible-chirho ? 280px : 0px;
    background: ThemeChirho.background-secondary-chirho;
    clip: true;

    animate width { duration: ThemeChirho.animation-normal-chirho; easing: ease-out; }

    Rectangle {
        width: 1px;
        height: 100%;
        background: ThemeChirho.border-chirho;
    }

    VerticalLayout {
        padding: ThemeChirho.spacing-lg-chirho;
        spacing: ThemeChirho.spacing-md-chirho;

        HorizontalLayout {
            Text {
                text: "All Highlights";
                font-size: ThemeChirho.font-size-lg-chirho;
                font-weight: 600;
                color: ThemeChirho.text-primary-chirho;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            IconButtonChirho {
                icon-chirho: LabelsChirho.close-icon-chirho;
                clicked-chirho => {
                    AppStateChirho.highlights-visible-chirho = false;
                }
            }
        }

        // Color filter buttons
        HorizontalLayout {
            spacing: ThemeChirho.spacing-xs-chirho;
            alignment: center;

            // All button
            Rectangle {
                width: 35px;
                height: 24px;
                background: AppStateChirho.highlights-filter-color-chirho == "" ? ThemeChirho.accent-chirho : ThemeChirho.background-elevated-chirho;
                border-radius: 12px;

                Text {
                    text: "All";
                    font-size: ThemeChirho.font-size-xs-chirho;
                    color: AppStateChirho.highlights-filter-color-chirho == "" ? white : ThemeChirho.text-secondary-chirho;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => { AppStateChirho.highlights-filter-color-chirho = ""; }
                    mouse-cursor: pointer;
                }
            }

            // Color filter buttons
            for color-chirho in AppStateChirho.highlight-colors-chirho: Rectangle {
                width: 24px;
                height: 24px;
                background: color-chirho.color-chirho;
                border-radius: 12px;
                border-width: AppStateChirho.highlights-filter-color-chirho == color-chirho.name-chirho ? 2px : 0px;
                border-color: ThemeChirho.text-primary-chirho;

                TouchArea {
                    clicked => { AppStateChirho.highlights-filter-color-chirho = color-chirho.name-chirho; }
                    mouse-cursor: pointer;
                }
            }
        }

        Rectangle {
            height: 1px;
            background: ThemeChirho.divider-chirho;
        }

        if AppStateChirho.all-highlights-chirho.length == 0: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;

            Text {
                text: "No highlights yet";
                font-size: ThemeChirho.font-size-md-chirho;
                color: ThemeChirho.text-muted-chirho;
                horizontal-alignment: center;
            }

            Text {
                text: "Click a verse to highlight it";
                font-size: ThemeChirho.font-size-sm-chirho;
                color: ThemeChirho.text-disabled-chirho;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: ThemeChirho.spacing-sm-chirho;

                for hl-chirho in AppStateChirho.all-highlights-chirho: Rectangle {
                    // Check if this highlight matches the filter (empty filter = show all)
                    property <bool> matches-filter-chirho:
                        AppStateChirho.highlights-filter-color-chirho == "" ||
                        AppStateChirho.highlights-filter-color-chirho == hl-chirho.color-chirho;

                    property <color> hl-bg-chirho:
                        hl-chirho.color-chirho == "green" ? #34d399 :
                        hl-chirho.color-chirho == "blue" ? #60a5fa :
                        hl-chirho.color-chirho == "pink" ? #f472b6 :
                        hl-chirho.color-chirho == "orange" ? #fb923c :
                        #fbbf24;

                    // Hide if doesn't match filter
                    height: matches-filter-chirho ? 60px : 0px;
                    visible: matches-filter-chirho;
                    background: hl-touch-chirho.has-hover ? ThemeChirho.background-elevated-chirho : ThemeChirho.background-tertiary-chirho;
                    border-radius: ThemeChirho.radius-md-chirho;

                    animate background { duration: ThemeChirho.animation-fast-chirho; easing: ease-out; }

                    // Left color indicator bar
                    Rectangle {
                        x: 0px;
                        width: 3px;
                        y: 4px;
                        height: parent.height - 8px;
                        background: hl-bg-chirho;
                        border-radius: 2px;
                    }

                    hl-touch-chirho := TouchArea {
                        clicked => {
                            AppStateChirho.navigate-to-chirho(
                                hl-chirho.book-chirho,
                                hl-chirho.chapter-chirho,
                                hl-chirho.verse-chirho
                            );
                        }
                        mouse-cursor: pointer;
                    }

                    VerticalLayout {
                        padding: ThemeChirho.spacing-md-chirho;
                        padding-left: ThemeChirho.spacing-lg-chirho;
                        spacing: ThemeChirho.spacing-xs-chirho;

                        Text {
                            text: hl-chirho.reference-chirho;
                            font-size: ThemeChirho.font-size-md-chirho;
                            font-weight: 600;
                            color: ThemeChirho.accent-chirho;
                            vertical-alignment: center;
                        }

                        Text {
                            text: hl-chirho.preview-chirho;
                            font-size: ThemeChirho.font-size-sm-chirho;
                            color: ThemeChirho.text-secondary-chirho;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}

// Notes list panel
