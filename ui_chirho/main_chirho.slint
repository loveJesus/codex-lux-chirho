    out property <string> separator-chirho: "•";
    out property <string> app-name-chirho: "Codex Lux Chirho";
    out property <string> app-icon-chirho: "+";
    out property <string> menu-icon-chirho: "=";
    out property <string> search-icon-chirho: "?";
    out property <string> settings-icon-chirho: "*";
    out property <string> close-icon-chirho: "x";
    out property <string> nav-prev-chirho: "<";
    out property <string> nav-next-chirho: ">";
    out property <string> search-placeholder-chirho: "Search the Scriptures...";
    out property <string> search-button-chirho: "Search";
    out property <string> book-count-chirho: "66";
