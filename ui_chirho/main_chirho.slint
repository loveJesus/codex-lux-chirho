// Application state shared with Rust
export global AppStateChirho {
    in-out property <string> current-module-chirho: "KJV";
    in-out property <string> current-book-chirho: "Genesis";
    in-out property <int> current-chapter-chirho: 1;
    in-out property <int> current-verse-chirho: 1;

    in-out property <[string]> module-names-chirho: ["KJV"];
    in-out property <[BookChirho]> books-chirho: [];
    in-out property <[VerseChirho]> verses-chirho: [];

    in-out property <bool> sidebar-visible-chirho: true;
    in-out property <bool> search-active-chirho: false;
    in-out property <string> search-query-chirho: "";
    in-out property <[VerseChirho]> search-results-chirho: [];
    in-out property <float> font-scale-chirho: 1.0;

    // Search scope: 0=All, 1=OT, 2=NT, 3=Current Book
    in-out property <int> search-scope-index-chirho: 0;
    // Search history (recent searches)
    in-out property <[string]> search-history-chirho: [];

    in-out property <string> status-message-chirho: "Ready";
    in-out property <bool> is-loading-chirho: false;

    // Goto verse dialog
    in-out property <bool> goto-dialog-visible-chirho: false;
    in-out property <string> goto-reference-chirho: "";

    // Settings panel
    in-out property <bool> settings-visible-chirho: false;

    // Display mode settings
    in-out property <bool> paragraph-mode-chirho: false;
    in-out property <float> line-height-chirho: 1.5;
    in-out property <int> font-family-index-chirho: 0; // 0=System, 1=Serif, 2=Sans

    // Bookmarks panel
    in-out property <bool> bookmarks-visible-chirho: false;
    in-out property <[BookmarkDisplayChirho]> bookmarks-chirho: [];

    // Available highlight colors
    in-out property <[HighlightColorChirho]> highlight-colors-chirho: [
        { name-chirho: "yellow", color-chirho: #fbbf24 },
        { name-chirho: "green", color-chirho: #34d399 },
        { name-chirho: "blue", color-chirho: #60a5fa },
        { name-chirho: "pink", color-chirho: #f472b6 },
        { name-chirho: "orange", color-chirho: #fb923c }
    ];

    callback navigate-to-chirho(string, int, int);
    callback search-chirho(string);
    callback load-module-chirho(string);
    callback toggle-highlight-chirho(string);
    callback set-highlight-color-chirho(string, string);
    callback add-note-chirho(string, string);
    callback copy-verse-chirho(string, string);
    callback goto-verse-chirho(string);
    callback toggle-theme-chirho();
    callback toggle-bookmark-chirho(string);
    callback update-bookmark-label-chirho(int, string);
    callback get-bookmarks-chirho();
    callback save-note-chirho(string, string);
    callback get-note-chirho(string);

    // Notes editing state
    in-out property <bool> note-dialog-visible-chirho: false;
    in-out property <string> note-verse-ref-chirho: "";
    in-out property <string> note-content-chirho: "";

    // Chapter selector state
    in-out property <bool> chapter-selector-visible-chirho: false;
    in-out property <int> current-book-chapter-count-chirho: 50;

    // Reading history
    in-out property <bool> history-visible-chirho: false;
    in-out property <[HistoryEntryChirho]> history-entries-chirho: [];
    callback load-history-chirho();
    callback navigate-to-reference-chirho(string);

    // Book navigation (for prev/next book buttons)
    callback navigate-prev-book-chirho();
    callback navigate-next-book-chirho();

    // Highlights panel
    in-out property <bool> highlights-visible-chirho: false;
    in-out property <[HighlightDisplayChirho]> all-highlights-chirho: [];
    // Filter: empty = all, otherwise filter by color name (yellow, green, blue, pink, orange)
    in-out property <string> highlights-filter-color-chirho: "";
    callback load-all-highlights-chirho();

    // Notes panel
    in-out property <bool> notes-visible-chirho: false;
    in-out property <[NoteDisplayChirho]> all-notes-chirho: [];
    callback load-all-notes-chirho();
    callback delete-note-chirho(string);

    // Module Manager panel
    in-out property <bool> module-manager-visible-chirho: false;
    in-out property <bool> module-manager-loading-chirho: false;
    in-out property <string> module-manager-status-chirho: "";
    in-out property <[RemoteModuleChirho]> remote-modules-chirho: [];
    in-out property <[string]> installed-modules-chirho: [];
    callback refresh-remote-modules-chirho();
    callback install-module-chirho(string);
    callback uninstall-module-chirho(string);

    // Quick Navigation (Ctrl+K command palette)
    in-out property <bool> quick-nav-visible-chirho: false;
    in-out property <string> quick-nav-query-chirho: "";
    in-out property <[HistoryEntryChirho]> quick-nav-results-chirho: [];
    callback quick-nav-search-chirho(string);

    // Context Menu (right-click on verse)
    in-out property <bool> context-menu-visible-chirho: false;
    in-out property <length> context-menu-x-chirho: 0px;
    in-out property <length> context-menu-y-chirho: 0px;
    in-out property <string> context-menu-verse-ref-chirho: "";
    in-out property <string> context-menu-verse-text-chirho: "";

    // Copy format settings
    // 0 = "text - reference" (default), 1 = "reference: text", 2 = "text only", 3 = "reference only"
    in-out property <int> copy-format-index-chirho: 0;
    in-out property <bool> copy-include-verse-numbers-chirho: true;

    // Multi-verse selection (for copying ranges)
    in-out property <bool> verse-selection-mode-chirho: false;
    in-out property <int> selection-start-verse-chirho: 0;
    in-out property <int> selection-end-verse-chirho: 0;
    callback copy-selected-verses-chirho();
    callback clear-selection-chirho();

    // Onboarding wizard (first-run experience)
    in-out property <bool> onboarding-visible-chirho: false;
    in-out property <int> onboarding-step-chirho: 0; // 0=welcome, 1=features, 2=shortcuts, 3=modules, 4=complete
    callback onboarding-complete-chirho();
    callback onboarding-skip-chirho();

    // Export callbacks for data portability
    callback export-highlights-chirho();
    callback export-bookmarks-chirho();
    callback export-notes-chirho();
    callback export-all-data-chirho();

    // Import callbacks for data restore
    callback import-data-chirho(string);
    callback load-backup-files-chirho();
    in-out property <[string]> backup-files-chirho: [];
    in-out property <bool> import-dialog-visible-chirho: false;

    // Parallel View (side-by-side translation comparison)
    in-out property <bool> parallel-view-enabled-chirho: false;
    in-out property <string> parallel-module-chirho: "";
    in-out property <[VerseChirho]> parallel-verses-chirho: [];
    callback load-parallel-module-chirho(string);

    // Info Panel (contextual verse details)
    in-out property <bool> info-panel-visible-chirho: false;
    in-out property <string> info-verse-ref-chirho: "";
    in-out property <string> info-verse-text-chirho: "";
    in-out property <bool> info-has-highlight-chirho: false;
    in-out property <string> info-highlight-color-chirho: "";
    in-out property <bool> info-has-note-chirho: false;
    in-out property <string> info-note-preview-chirho: "";
    in-out property <bool> info-has-bookmark-chirho: false;
    callback load-verse-info-chirho(string);

    // Statistics Panel
    in-out property <bool> stats-panel-visible-chirho: false;
    in-out property <int> stats-total-chapters-chirho: 0;
    in-out property <int> stats-unique-chapters-chirho: 0;
    in-out property <string> stats-reading-time-chirho: "0m";
    in-out property <int> stats-current-streak-chirho: 0;
    in-out property <int> stats-longest-streak-chirho: 0;
    in-out property <int> stats-highlight-count-chirho: 0;
    in-out property <int> stats-note-count-chirho: 0;
    in-out property <int> stats-bookmark-count-chirho: 0;
    in-out property <int> stats-books-started-chirho: 0;
    callback load-statistics-chirho();

    // Journal Panel
    in-out property <bool> journal-panel-visible-chirho: false;
    in-out property <[JournalEntryDisplayChirho]> journal-entries-chirho: [];
    in-out property <bool> journal-editor-visible-chirho: false;
    in-out property <int> journal-edit-id-chirho: -1;
    in-out property <string> journal-edit-title-chirho: "";
    in-out property <string> journal-edit-content-chirho: "";
    in-out property <string> journal-edit-verse-ref-chirho: "";
    in-out property <string> journal-edit-tags-chirho: "";
    callback load-journal-entries-chirho();
    callback save-journal-entry-chirho(int, string, string, string, string);
    callback delete-journal-entry-chirho(int);

    // Prayer List Panel
    in-out property <bool> prayer-panel-visible-chirho: false;
    in-out property <[PrayerRequestDisplayChirho]> prayer-requests-chirho: [];
    in-out property <bool> prayer-editor-visible-chirho: false;
    in-out property <string> prayer-edit-title-chirho: "";
    in-out property <string> prayer-edit-description-chirho: "";
    in-out property <string> prayer-edit-verse-ref-chirho: "";
    in-out property <string> prayer-edit-category-chirho: "";
    callback load-prayer-requests-chirho();
    callback save-prayer-request-chirho(string, string, string, string);
    callback mark-prayer-answered-chirho(int);
    callback delete-prayer-request-chirho(int);

    // Verse of the Day (Daily Devotional)
    in-out property <bool> votd-dialog-visible-chirho: false;
    in-out property <string> votd-reference-chirho: "";
    in-out property <string> votd-text-chirho: "";
    in-out property <string> votd-date-chirho: "";
    callback load-verse-of-the-day-chirho();
    callback goto-votd-chirho();

    // Strong's Numbers (Study Tools)
    in-out property <bool> strongs-visible-chirho: false; // Toggle Strong's display
    in-out property <bool> strongs-popup-visible-chirho: false;
    in-out property <StrongsEntryChirho> strongs-current-entry-chirho;
    in-out property <length> strongs-popup-x-chirho: 0px;
    in-out property <length> strongs-popup-y-chirho: 0px;
    callback lookup-strongs-chirho(string); // Look up a Strong's number (H1234 or G5678)
    callback toggle-strongs-display-chirho();

    // Reading Plans
    in-out property <bool> reading-plan-panel-visible-chirho: false;
    in-out property <[ReadingPlanChirho]> reading-plans-chirho: [];
    in-out property <ReadingPlanChirho> active-plan-chirho;
    in-out property <[ReadingDayChirho]> plan-days-chirho: [];
    in-out property <ReadingDayChirho> today-reading-chirho;
    in-out property <bool> plan-selector-visible-chirho: false;
    callback load-reading-plans-chirho();
    callback start-reading-plan-chirho(int); // Start a plan by ID
    callback mark-day-complete-chirho(int, int); // Mark a day complete (plan_id, day_number)
    callback navigate-to-reading-chirho(string); // Navigate to a reading reference

    // Morphology Display (Study Tools)
    in-out property <bool> morphology-visible-chirho: false; // Toggle morphology display
    in-out property <bool> morphology-popup-visible-chirho: false;
    in-out property <string> morphology-code-chirho: ""; // Current morphology code (e.g., "V-AAI-3S")
    in-out property <string> morphology-parsed-chirho: ""; // Human-readable parsing (e.g., "Verb, Aorist Active Indicative, 3rd Person Singular")
    in-out property <string> morphology-word-chirho: ""; // The word being analyzed
    in-out property <bool> morphology-is-hebrew-chirho: false; // Hebrew or Greek
    in-out property <length> morphology-popup-x-chirho: 0px;
    in-out property <length> morphology-popup-y-chirho: 0px;
    callback lookup-morphology-chirho(string); // Look up a morphology code
    callback toggle-morphology-display-chirho();

    // Cross-References (Study Tools)
    in-out property <bool> cross-refs-visible-chirho: false; // Toggle cross-reference display
    in-out property <bool> cross-refs-popup-visible-chirho: false;
    in-out property <string> cross-refs-verse-chirho: ""; // Current verse for cross-refs
    in-out property <[string]> cross-refs-list-chirho: []; // List of cross-reference verses
    in-out property <length> cross-refs-popup-x-chirho: 0px;
    in-out property <length> cross-refs-popup-y-chirho: 0px;
    callback load-cross-refs-chirho(string); // Load cross-references for a verse
    callback toggle-cross-refs-display-chirho();

    // Footnotes (Study Tools)
    in-out property <bool> footnotes-visible-chirho: false; // Toggle footnotes display
    in-out property <bool> footnote-popup-visible-chirho: false;
    in-out property <string> footnote-marker-chirho: ""; // Footnote marker (a, b, c, *)
    in-out property <string> footnote-content-chirho: ""; // Footnote text
    in-out property <string> footnote-type-chirho: ""; // "translator", "textual", "alternative"
    in-out property <length> footnote-popup-x-chirho: 0px;
    in-out property <length> footnote-popup-y-chirho: 0px;
    callback lookup-footnote-chirho(string, string); // Look up footnote (verse_ref, marker)
    callback toggle-footnotes-display-chirho();

    // Commentary Panel (Study Tools)
    in-out property <bool> commentary-panel-visible-chirho: false;
    in-out property <string> commentary-verse-ref-chirho: ""; // Current verse for commentary
    in-out property <string> commentary-content-chirho: ""; // Commentary text
    in-out property <string> commentary-module-chirho: ""; // Selected commentary module
    in-out property <[string]> commentary-modules-chirho: []; // Available commentary modules
    callback load-commentary-chirho(string); // Load commentary for verse
    callback select-commentary-module-chirho(string);

    // Lexicon/Dictionary Panel (Study Tools)
    in-out property <bool> lexicon-panel-visible-chirho: false;
    in-out property <string> lexicon-search-query-chirho: "";
    in-out property <string> lexicon-current-entry-chirho: "";
    in-out property <string> lexicon-entry-content-chirho: "";
    in-out property <[string]> lexicon-modules-chirho: []; // Available lexicon modules
    in-out property <string> lexicon-module-chirho: ""; // Selected lexicon module
    in-out property <[string]> lexicon-history-chirho: []; // Recently viewed entries
    callback search-lexicon-chirho(string);
    callback browse-lexicon-chirho(string); // Browse by letter
    callback select-lexicon-module-chirho(string);

    // Versification System (CLX-032)
    // 0=KJV (default), 1=Catholic, 2=Orthodox, 3=LXX, 4=Vulgate, 5=Luther
    in-out property <int> versification-index-chirho: 0;
    in-out property <[string]> versification-systems-chirho: ["KJV", "Catholic", "Orthodox", "LXX", "Vulgate", "Luther"];
    callback set-versification-chirho(int);

    // Interlinear Display (CLX-051)
    in-out property <bool> interlinear-visible-chirho: false; // Toggle interlinear panel
    in-out property <string> interlinear-verse-ref-chirho: ""; // Current verse for interlinear
    in-out property <[InterlinearWordChirho]> interlinear-words-chirho: []; // Words for current verse
    in-out property <bool> interlinear-show-transliteration-chirho: true; // Show transliteration line
    in-out property <bool> interlinear-show-morphology-chirho: true; // Show morphology tags
    in-out property <bool> interlinear-show-strongs-chirho: true; // Show Strong's numbers
    in-out property <bool> interlinear-show-gloss-chirho: true; // Show gloss/meaning
    callback load-interlinear-chirho(string); // Load interlinear for a verse
    callback toggle-interlinear-display-chirho();
}

// Icon button component with accessibility support
component IconButtonChirho inherits Rectangle {
    in property <string> icon-chirho;
    in property <bool> active-chirho: false;
    in property <string> accessible-label-chirho: "";
    in property <bool> has-focus-chirho: false;
    callback clicked-chirho();

    width: 36px;
    height: 36px;
    border-radius: ThemeChirho.radius-md-chirho;
    background: touch-area-chirho.has-hover ?
        (active-chirho ? ThemeChirho.accent-chirho : ThemeChirho.background-elevated-chirho) :
        (active-chirho ? ThemeChirho.accent-secondary-chirho : transparent);
    // Focus indicator ring (enabled via external focus management)
    border-width: has-focus-chirho && ThemeChirho.focus-visible-chirho ? 2px : 0px;
    border-color: ThemeChirho.focus-ring-chirho;

    animate background { duration: ThemeChirho.animation-fast-chirho; easing: ease-out; }

    Text {
        text: icon-chirho;
        font-size: 18px;
        color: active-chirho ? ThemeChirho.text-primary-chirho : ThemeChirho.text-secondary-chirho;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch-area-chirho := TouchArea {
        clicked => { root.clicked-chirho(); }
        mouse-cursor: pointer;
    }
}

// Nav button with accessibility support
component NavButtonChirho inherits Rectangle {
    in property <string> label-chirho;
    in property <bool> disabled-chirho: false;
    in property <string> accessible-label-chirho: "";
    callback clicked-chirho();

    width: 32px;
    height: 32px;
    border-radius: ThemeChirho.radius-sm-chirho;
    background: disabled-chirho ? transparent :
        (touch-chirho.has-hover ? ThemeChirho.background-elevated-chirho : ThemeChirho.background-tertiary-chirho);
    border-width: 1px;
    border-color: disabled-chirho ? transparent : ThemeChirho.border-subtle-chirho;

    animate background { duration: ThemeChirho.animation-fast-chirho; easing: ease-out; }

    Text {
        text: label-chirho;
        font-size: ThemeChirho.font-size-md-chirho;
        font-weight: 500;
        color: disabled-chirho ? ThemeChirho.text-disabled-chirho : ThemeChirho.text-secondary-chirho;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch-chirho := TouchArea {
        clicked => { if (!disabled-chirho) { root.clicked-chirho(); } }
        mouse-cursor: disabled-chirho ? default : pointer;
    }
}

// Sidebar component
component SidebarChirho inherits Rectangle {
    width: 260px;
    background: ThemeChirho.background-secondary-chirho;

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: ThemeChirho.border-chirho;
    }

    VerticalBox {
        padding: ThemeChirho.spacing-lg-chirho;
        spacing: ThemeChirho.spacing-md-chirho;

        // Module selector
        VerticalBox {
            spacing: ThemeChirho.spacing-sm-chirho;

            Text {
                text: LabelsChirho.translation-label-chirho;
                font-size: ThemeChirho.font-size-xs-chirho;
                font-weight: 600;
                color: ThemeChirho.text-muted-chirho;
            }

            ComboBox {
                height: 36px;
                model: AppStateChirho.module-names-chirho;
                current-value: AppStateChirho.current-module-chirho;
                selected(value) => {
                    AppStateChirho.load-module-chirho(value);
                }
            }
        }

        Rectangle {
            height: 1px;
            background: ThemeChirho.divider-chirho;
        }

        HorizontalBox {
            Text {
                text: LabelsChirho.books-label-chirho;
                font-size: ThemeChirho.font-size-xs-chirho;
                font-weight: 600;
                color: ThemeChirho.text-muted-chirho;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: LabelsChirho.book-count-chirho;
                font-size: ThemeChirho.font-size-xs-chirho;
                color: ThemeChirho.text-disabled-chirho;
                vertical-alignment: center;
            }
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalBox {
                spacing: 2px;

                // Old Testament Header
                Rectangle {
                    height: 28px;
                    background: ThemeChirho.background-tertiary-chirho;

                    HorizontalBox {
                        padding-left: ThemeChirho.spacing-md-chirho;
                        padding-right: ThemeChirho.spacing-md-chirho;

                        Text {
                            text: LabelsChirho.old-testament-label-chirho;
                            font-size: ThemeChirho.font-size-xs-chirho;
                            font-weight: 700;
                            color: ThemeChirho.text-muted-chirho;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        Text {
                            text: LabelsChirho.ot-book-count-chirho;
                            font-size: ThemeChirho.font-size-xs-chirho;
                            color: ThemeChirho.text-disabled-chirho;
                            vertical-alignment: center;
                        }
                    }
                }

                for book-chirho in AppStateChirho.books-chirho: VerticalLayout {
                    // New Testament Header (appears before Matthew)
                    if book-chirho.name-chirho == "Matthew": Rectangle {
                        height: 28px;
                        background: ThemeChirho.background-tertiary-chirho;

                        HorizontalBox {
                            padding-left: ThemeChirho.spacing-md-chirho;
                            padding-right: ThemeChirho.spacing-md-chirho;

                            Text {
                                text: LabelsChirho.new-testament-label-chirho;
                                font-size: ThemeChirho.font-size-xs-chirho;
                                font-weight: 700;
                                color: ThemeChirho.text-muted-chirho;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: LabelsChirho.nt-book-count-chirho;
                                font-size: ThemeChirho.font-size-xs-chirho;
                                color: ThemeChirho.text-disabled-chirho;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        height: 36px;
                        background: book-chirho.name-chirho == AppStateChirho.current-book-chirho ?
                            ThemeChirho.accent-secondary-chirho :
                            (book-touch-chirho.has-hover ? ThemeChirho.background-tertiary-chirho : transparent);
                        border-radius: ThemeChirho.radius-md-chirho;

                        animate background { duration: ThemeChirho.animation-fast-chirho; easing: ease-out; }

                        book-touch-chirho := TouchArea {
                            clicked => {
                                AppStateChirho.navigate-to-chirho(book-chirho.name-chirho, 1, 1);
                            }
                            mouse-cursor: pointer;
                        }

                        HorizontalBox {
                            padding-left: ThemeChirho.spacing-md-chirho;
                            padding-right: ThemeChirho.spacing-md-chirho;

                            if book-chirho.name-chirho == AppStateChirho.current-book-chirho: Rectangle {
                                width: 3px;
                                height: 18px;
                                background: ThemeChirho.accent-chirho;
                                border-radius: 2px;
                            }

                            Text {
                                text: book-chirho.name-chirho;
                                color: book-chirho.name-chirho == AppStateChirho.current-book-chirho ?
                                    ThemeChirho.text-primary-chirho : ThemeChirho.text-secondary-chirho;
                                font-size: ThemeChirho.font-size-md-chirho;
                                font-weight: book-chirho.name-chirho == AppStateChirho.current-book-chirho ? 500 : 400;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: book-chirho.chapters-chirho;
                                color: ThemeChirho.text-muted-chirho;
                                font-size: ThemeChirho.font-size-sm-chirho;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}

// Chapter navigation bar
component ChapterBarChirho inherits Rectangle {
    height: 56px;
    background: ThemeChirho.background-secondary-chirho;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: ThemeChirho.border-chirho;
    }

    HorizontalBox {
        padding: ThemeChirho.spacing-md-chirho;
        spacing: ThemeChirho.spacing-md-chirho;
        alignment: center;

        // Previous book button
        NavButtonChirho {
            label-chirho: "<<";
            clicked-chirho => {
                AppStateChirho.navigate-prev-book-chirho();
            }
        }

        // Previous chapter button
        NavButtonChirho {
            label-chirho: LabelsChirho.nav-prev-chirho;
            disabled-chirho: AppStateChirho.current-chapter-chirho <= 1;
            clicked-chirho => {
                if (AppStateChirho.current-chapter-chirho > 1) {
                    AppStateChirho.navigate-to-chirho(
                        AppStateChirho.current-book-chirho,
                        AppStateChirho.current-chapter-chirho - 1,
                        1
                    );
                }
            }
        }

        Rectangle {
            min-width: 200px;
            height: 36px;
            background: chapter-display-touch-chirho.has-hover ? ThemeChirho.background-elevated-chirho : ThemeChirho.background-tertiary-chirho;
            border-radius: ThemeChirho.radius-md-chirho;
            border-width: 1px;
            border-color: ThemeChirho.border-subtle-chirho;

            animate background { duration: ThemeChirho.animation-fast-chirho; }

            HorizontalBox {
                padding-left: ThemeChirho.spacing-lg-chirho;
                padding-right: ThemeChirho.spacing-lg-chirho;
                alignment: center;

                Text {
                    text: AppStateChirho.current-book-chirho + " " + AppStateChirho.current-chapter-chirho;
                    font-size: ThemeChirho.font-size-lg-chirho;
                    font-weight: 600;
                    color: ThemeChirho.text-primary-chirho;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }

                Text {
                    text: "▾";
                    font-size: 10px;
                    color: ThemeChirho.text-muted-chirho;
                    vertical-alignment: center;
                }
            }

            chapter-display-touch-chirho := TouchArea {
                clicked => {
                    AppStateChirho.chapter-selector-visible-chirho = true;
                }
                mouse-cursor: pointer;
            }
        }

        // Next chapter button
        NavButtonChirho {
            label-chirho: LabelsChirho.nav-next-chirho;
            clicked-chirho => {
                AppStateChirho.navigate-to-chirho(
                    AppStateChirho.current-book-chirho,
                    AppStateChirho.current-chapter-chirho + 1,
                    1
                );
            }
        }

        // Next book button
        NavButtonChirho {
            label-chirho: ">>";
            clicked-chirho => {
                AppStateChirho.navigate-next-book-chirho();
            }
        }
    }
}

// Context Menu Item component
component ContextMenuItemChirho inherits Rectangle {
    in property <string> icon-chirho;
    in property <string> label-chirho;
    callback clicked-chirho();

    height: 36px;
    background: item-touch-chirho.has-hover ? ThemeChirho.background-elevated-chirho : transparent;
    border-radius: ThemeChirho.radius-sm-chirho;

    HorizontalLayout {
        padding-left: ThemeChirho.spacing-md-chirho;
        padding-right: ThemeChirho.spacing-md-chirho;
        spacing: ThemeChirho.spacing-sm-chirho;

        Text {
            text: icon-chirho;
            font-size: 14px;
            vertical-alignment: center;
        }
        Text {
            text: label-chirho;
            font-size: ThemeChirho.font-size-sm-chirho;
            color: ThemeChirho.text-primary-chirho;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }

    item-touch-chirho := TouchArea {
        clicked => {
            root.clicked-chirho();
        }
        mouse-cursor: pointer;
    }
}

// Context Menu component (popup on right-click)
component ContextMenuChirho inherits Rectangle {
    in-out property <bool> visible-chirho: false;
    in property <length> menu-x-chirho: 0px;
    in property <length> menu-y-chirho: 0px;
    in property <string> verse-ref-chirho;
    in property <string> verse-text-chirho;

    width: 100%;
    height: 100%;
    background: visible-chirho ? transparent : transparent;

    if visible-chirho: Rectangle {
        // Backdrop to close menu when clicking outside
        width: 100%;
        height: 100%;

        TouchArea {
            clicked => {
                root.visible-chirho = false;
            }
        }

        // Menu popup
        Rectangle {
            x: menu-x-chirho;
            y: menu-y-chirho;
            width: 200px;
            height: 292px;
            background: ThemeChirho.background-secondary-chirho;
            border-radius: ThemeChirho.radius-md-chirho;
            border-width: 1px;
            border-color: ThemeChirho.border-chirho;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000040;

            VerticalLayout {
                padding: ThemeChirho.spacing-xs-chirho;
                spacing: 2px;

                // Header with verse reference
                Rectangle {
                    height: 28px;
                    HorizontalLayout {
                        padding-left: ThemeChirho.spacing-md-chirho;
                        Text {
                            text: verse-ref-chirho;
                            font-size: ThemeChirho.font-size-xs-chirho;
                            font-weight: 600;
                            color: ThemeChirho.text-muted-chirho;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: ThemeChirho.divider-chirho;
                }

                ContextMenuItemChirho {
                    icon-chirho: LabelsChirho.copy-icon-chirho;
                    label-chirho: "Copy Verse";
                    clicked-chirho => {
                        AppStateChirho.copy-verse-chirho(verse-ref-chirho, verse-text-chirho);
                        root.visible-chirho = false;
                    }
                }

                ContextMenuItemChirho {
                    icon-chirho: LabelsChirho.bookmark-icon-chirho;
                    label-chirho: "Add Bookmark";
                    clicked-chirho => {
                        // Extract just the verse number for the toggle
                        AppStateChirho.toggle-bookmark-chirho(verse-ref-chirho);
                        root.visible-chirho = false;
                    }
                }

                ContextMenuItemChirho {
                    icon-chirho: "*";
                    label-chirho: "Highlight";
                    clicked-chirho => {
                        AppStateChirho.toggle-highlight-chirho(verse-ref-chirho);
                        root.visible-chirho = false;
                    }
                }

                ContextMenuItemChirho {
                    icon-chirho: LabelsChirho.note-indicator-chirho;
                    label-chirho: "Add Note";
                    clicked-chirho => {
                        AppStateChirho.note-verse-ref-chirho = verse-ref-chirho;
                        AppStateChirho.get-note-chirho(verse-ref-chirho);
                        AppStateChirho.note-dialog-visible-chirho = true;
                        root.visible-chirho = false;
                    }
                }

                Rectangle {
                    height: 1px;
                    background: ThemeChirho.divider-chirho;
                }

                ContextMenuItemChirho {
                    icon-chirho: "⇄";
                    label-chirho: "Compare Translations";
                    clicked-chirho => {
                        // Enable parallel view for translation comparison
                        AppStateChirho.parallel-view-enabled-chirho = true;
                        root.visible-chirho = false;
                    }
                }

                ContextMenuItemChirho {
                    icon-chirho: LabelsChirho.search-icon-chirho;
                    label-chirho: "Search Similar";
                    clicked-chirho => {
                        // Use first few words as search query
                        AppStateChirho.search-active-chirho = true;
                        root.visible-chirho = false;
                    }
                }
            }
        }
    }
}

// Individual verse component
component VerseViewChirho inherits Rectangle {
    in property <VerseChirho> verse-chirho;

    // Compute highlight color from name
    property <color> active-highlight-color-chirho:
        verse-chirho.highlight-color-chirho == "green" ? #34d399 :
        verse-chirho.highlight-color-chirho == "blue" ? #60a5fa :
        verse-chirho.highlight-color-chirho == "pink" ? #f472b6 :
        verse-chirho.highlight-color-chirho == "orange" ? #fb923c :
        #fbbf24; // default yellow

    // Calculate poetry indent (20px per level)
    property <length> poetry-indent-amount-chirho:
        verse-chirho.poetry-indent-chirho == 1 ? 20px :
        verse-chirho.poetry-indent-chirho == 2 ? 40px :
        verse-chirho.poetry-indent-chirho == 3 ? 60px :
        0px;

    background: verse-chirho.is-highlighted-chirho ?
        active-highlight-color-chirho.with-alpha(0.12) :
        (verse-touch-chirho.has-hover ? ThemeChirho.background-tertiary-chirho.with-alpha(0.5) : transparent);
    border-radius: ThemeChirho.radius-md-chirho;

    if verse-chirho.is-highlighted-chirho: Rectangle {
        x: 0px;
        width: 3px;
        y: 8px;
        height: parent.height - 16px;
        background: active-highlight-color-chirho;
        border-radius: 2px;
    }

    animate background { duration: ThemeChirho.animation-fast-chirho; easing: ease-out; }

    VerticalLayout {
        spacing: 0px;

        // Section heading (if present)
        if verse-chirho.section-heading-chirho != "": Rectangle {
            HorizontalLayout {
                padding-top: ThemeChirho.spacing-lg-chirho;
                padding-bottom: ThemeChirho.spacing-sm-chirho;
                padding-left: ThemeChirho.spacing-md-chirho;

                Text {
                    text: verse-chirho.section-heading-chirho;
                    font-size: ThemeChirho.font-size-md-chirho * AppStateChirho.font-scale-chirho;
                    font-weight: 600;
                    color: ThemeChirho.section-heading-chirho;
                    wrap: word-wrap;
                }
            }
        }

        HorizontalLayout {
            padding-top: ThemeChirho.spacing-md-chirho;
            padding-bottom: ThemeChirho.spacing-md-chirho;
            padding-left: verse-chirho.is-highlighted-chirho ? ThemeChirho.spacing-lg-chirho : ThemeChirho.spacing-md-chirho;
            padding-right: ThemeChirho.spacing-md-chirho;
            spacing: ThemeChirho.spacing-sm-chirho;
            alignment: start;

            // Pilcrow marker for paragraph start
            if verse-chirho.is-paragraph-start-chirho && AppStateChirho.paragraph-mode-chirho: Rectangle {
                width: 14px;
                Text {
                    text: "¶";
                    font-size: ThemeChirho.font-size-sm-chirho;
                    color: ThemeChirho.text-muted-chirho;
                    horizontal-alignment: center;
                    vertical-alignment: top;
                }
            }

            // Poetry indent spacer
            if verse-chirho.poetry-indent-chirho > 0: Rectangle {
                width: poetry-indent-amount-chirho;
            }

            // Verse number - fixed width column
            Rectangle {
                width: 32px;

                Text {
                    text: verse-chirho.reference-chirho;
                    font-size: ThemeChirho.font-size-sm-chirho;
                    font-weight: 700;
                    color: ThemeChirho.verse-number-chirho;
                    horizontal-alignment: right;
                    vertical-alignment: top;
                }
            }

            // Verse text - takes remaining space
            // Shows Strong's annotated text when enabled and available, otherwise plain text
            // Red letter text uses red color, poetry uses lighter weight
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;

                // Primary verse text (or Strong's annotated text)
                Text {
                    text: AppStateChirho.strongs-visible-chirho && verse-chirho.has-strongs-chirho ?
                          verse-chirho.strongs-text-chirho : verse-chirho.text-chirho;
                    font-size: ThemeChirho.font-size-scripture-chirho * AppStateChirho.font-scale-chirho;
                    font-family: AppStateChirho.font-family-index-chirho == 1 ? "Georgia, Times New Roman, serif" :
                                 AppStateChirho.font-family-index-chirho == 2 ? "Helvetica, Arial, sans-serif" :
                                 "system-ui";
                    // Red letter text for words of Jesus, otherwise normal text color
                    color: verse-chirho.is-red-letter-chirho ? ThemeChirho.red-letter-chirho :
                           (verse-chirho.poetry-indent-chirho > 0 ? ThemeChirho.poetry-text-chirho : ThemeChirho.text-primary-chirho);
                    // Poetry uses lighter font weight for visual distinction
                    font-weight: verse-chirho.poetry-indent-chirho > 0 ? 300 : 400;
                    wrap: word-wrap;
                    horizontal-alignment: left;
                    vertical-alignment: top;
                }

                // Strong's numbers indicator (when showing Strong's text)
                if AppStateChirho.strongs-visible-chirho && verse-chirho.has-strongs-chirho: Text {
                    text: "Tap Strong's numbers (H/G) for definitions";
                    font-size: ThemeChirho.font-size-xs-chirho;
                    color: ThemeChirho.text-muted-chirho;
                }
            }

        // Action buttons (visible on hover)
        if verse-touch-chirho.has-hover: HorizontalLayout {
            spacing: 4px;

            // Copy button
            Rectangle {
                width: 24px;
                height: 24px;
                background: copy-touch-chirho.has-hover ? ThemeChirho.accent-chirho : ThemeChirho.background-elevated-chirho;
                border-radius: 12px;

                Text {
                    text: LabelsChirho.copy-icon-chirho;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                copy-touch-chirho := TouchArea {
                    clicked => {
                        AppStateChirho.copy-verse-chirho(
                            AppStateChirho.current-book-chirho + " " + AppStateChirho.current-chapter-chirho + ":" + verse-chirho.reference-chirho,
                            verse-chirho.text-chirho
                        );
                    }
                    mouse-cursor: pointer;
                }
            }

            // Highlight color buttons (show available colors)
            for color-chirho in AppStateChirho.highlight-colors-chirho: Rectangle {
                width: 20px;
                height: 20px;
                background: color-touch-chirho.has-hover ? color-chirho.color-chirho.with-alpha(1.0) : color-chirho.color-chirho.with-alpha(0.7);
                border-radius: 10px;
                border-width: verse-chirho.highlight-color-chirho == color-chirho.name-chirho ? 2px : 0px;
                border-color: ThemeChirho.text-primary-chirho;

                animate background { duration: 100ms; }

                color-touch-chirho := TouchArea {
                    clicked => {
                        AppStateChirho.set-highlight-color-chirho(verse-chirho.reference-chirho, color-chirho.name-chirho);
                    }
                    mouse-cursor: pointer;
                }
            }

            // Bookmark button
            Rectangle {
                width: 24px;
                height: 24px;
                background: bookmark-touch-chirho.has-hover ? ThemeChirho.accent-chirho : ThemeChirho.background-elevated-chirho;
                border-radius: 12px;

                Text {
                    text: LabelsChirho.bookmark-icon-chirho;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                bookmark-touch-chirho := TouchArea {
                    clicked => {
                        AppStateChirho.toggle-bookmark-chirho(verse-chirho.reference-chirho);
                    }
                    mouse-cursor: pointer;
                }
            }

            // Note button
            Rectangle {
                width: 24px;
                height: 24px;
                background: note-touch-chirho.has-hover ? ThemeChirho.accent-chirho :
                    (verse-chirho.has-note-chirho ? ThemeChirho.highlight-chirho : ThemeChirho.background-elevated-chirho);
                border-radius: 12px;

                Text {
                    text: LabelsChirho.note-indicator-chirho;
                    font-size: 12px;
                    color: verse-chirho.has-note-chirho ? #1e1e2e : ThemeChirho.text-secondary-chirho;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                note-touch-chirho := TouchArea {
                    clicked => {
                        // Open note dialog for this verse
                        AppStateChirho.note-verse-ref-chirho = AppStateChirho.current-book-chirho + " " + AppStateChirho.current-chapter-chirho + ":" + verse-chirho.reference-chirho;
                        AppStateChirho.get-note-chirho(verse-chirho.reference-chirho);
                        AppStateChirho.note-dialog-visible-chirho = true;
                    }
                    mouse-cursor: pointer;
                }
            }

            // Info button
            Rectangle {
                width: 24px;
                height: 24px;
                background: info-touch-chirho.has-hover ? ThemeChirho.accent-chirho : ThemeChirho.background-elevated-chirho;
                border-radius: 12px;

                Text {
                    text: "ℹ";
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                info-touch-chirho := TouchArea {
                    clicked => {
                        // Show info panel and load this verse's info
                        AppStateChirho.info-panel-visible-chirho = true;
                        AppStateChirho.load-verse-info-chirho(verse-chirho.reference-chirho);
                    }
                    mouse-cursor: pointer;
                }
            }
        }

        if verse-chirho.has-note-chirho: Rectangle {
            width: 20px;
            height: 20px;
            background: ThemeChirho.highlight-chirho;
            border-radius: 10px;

            Text {
                text: LabelsChirho.note-indicator-chirho;
                font-size: 10px;
                color: #1e1e2e;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        } // Close HorizontalLayout
    } // Close VerticalLayout

    verse-touch-chirho := TouchArea {
        clicked => {
            AppStateChirho.toggle-highlight-chirho(verse-chirho.reference-chirho);
            // Also update info panel with this verse's details
            AppStateChirho.load-verse-info-chirho(verse-chirho.reference-chirho);
        }
        pointer-event(event-chirho) => {
            // Right-click to show context menu
            if (event-chirho.button == PointerEventButton.right && event-chirho.kind == PointerEventKind.down) {
                AppStateChirho.context-menu-visible-chirho = true;
                // Use absolute position of the verse element plus mouse position within it
                AppStateChirho.context-menu-x-chirho = self.absolute-position.x + self.mouse-x;
                AppStateChirho.context-menu-y-chirho = self.absolute-position.y + self.mouse-y;
                AppStateChirho.context-menu-verse-ref-chirho = AppStateChirho.current-book-chirho + " " + AppStateChirho.current-chapter-chirho + ":" + verse-chirho.reference-chirho;
                AppStateChirho.context-menu-verse-text-chirho = verse-chirho.text-chirho;
            }
        }
        mouse-cursor: pointer;
    }
}

// Main Bible reading area
component BibleViewChirho inherits Rectangle {
    background: ThemeChirho.background-primary-chirho;

    VerticalLayout {
        ChapterBarChirho {}

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding-top: ThemeChirho.spacing-lg-chirho;
                padding-bottom: ThemeChirho.spacing-xl-chirho;
                padding-left: 24px;
                padding-right: 24px;
                spacing: 2px;

                for verse-chirho in AppStateChirho.verses-chirho: VerseViewChirho {
                    verse-chirho: verse-chirho;
                }

                Rectangle { height: 48px; }
            }
        }
    }
}

// Parallel pane for side-by-side translation comparison
component ParallelPaneChirho inherits Rectangle {
    in-out property <bool> visible-chirho: false;

    width: visible-chirho ? 400px : 0px;
    clip: true;
    background: ThemeChirho.background-secondary-chirho;

    animate width { duration: ThemeChirho.animation-normal-chirho; easing: ease-out; }

    // Left border separator
    Rectangle {
        x: 0px;
        width: 1px;
        height: 100%;
        background: ThemeChirho.border-chirho;
    }

    VerticalLayout {
        // Header with module selector
        Rectangle {
            height: 52px;
            background: ThemeChirho.background-tertiary-chirho;

            HorizontalLayout {
                padding: ThemeChirho.spacing-md-chirho;
                spacing: ThemeChirho.spacing-sm-chirho;

                Text {
                    text: "Compare:";
                    font-size: ThemeChirho.font-size-sm-chirho;
                    color: ThemeChirho.text-muted-chirho;
                    vertical-alignment: center;
                }

                ComboBox {
                    horizontal-stretch: 1;
                    height: 32px;
                    model: AppStateChirho.module-names-chirho;
                    current-value: AppStateChirho.parallel-module-chirho;
                    selected(value-chirho) => {
                        AppStateChirho.load-parallel-module-chirho(value-chirho);
                    }
                }

                IconButtonChirho {
                    icon-chirho: LabelsChirho.close-icon-chirho;
                    clicked-chirho => {
                        AppStateChirho.parallel-view-enabled-chirho = false;
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: ThemeChirho.border-chirho;
            }
        }

        // Chapter reference
        Rectangle {
            height: 40px;
            background: ThemeChirho.background-secondary-chirho;

            HorizontalLayout {
                padding-left: ThemeChirho.spacing-lg-chirho;
                alignment: start;

                Text {
                    text: AppStateChirho.parallel-module-chirho + " • " + AppStateChirho.current-book-chirho + " " + AppStateChirho.current-chapter-chirho;
                    font-size: ThemeChirho.font-size-md-chirho;
                    font-weight: 500;
                    color: ThemeChirho.text-secondary-chirho;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: ThemeChirho.divider-chirho;
            }
        }

        // Verses scroll view
        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding-top: ThemeChirho.spacing-lg-chirho;
                padding-bottom: ThemeChirho.spacing-xl-chirho;
                padding-left: 24px;
                padding-right: 24px;
                spacing: 2px;

                // Message if no parallel module selected
                if AppStateChirho.parallel-module-chirho == "": Rectangle {
                    height: 100px;

                    Text {
                        text: "Select a translation to compare";
                        font-size: ThemeChirho.font-size-md-chirho;
                        color: ThemeChirho.text-muted-chirho;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Parallel verses (simplified display without interactions)
                for verse-chirho in AppStateChirho.parallel-verses-chirho: Rectangle {
                    background: transparent;

                    HorizontalLayout {
                        padding-top: ThemeChirho.spacing-sm-chirho;
                        padding-bottom: ThemeChirho.spacing-sm-chirho;
                        spacing: ThemeChirho.spacing-sm-chirho;

                        Text {
                            text: verse-chirho.reference-chirho;
                            font-size: 14px * AppStateChirho.font-scale-chirho;
                            font-weight: 600;
                            color: ThemeChirho.verse-number-chirho;
                            vertical-alignment: top;
                            width: 32px;
                        }

                        Text {
                            text: verse-chirho.text-chirho;
                            font-size: ThemeChirho.font-size-scripture-chirho * AppStateChirho.font-scale-chirho;
                            color: ThemeChirho.text-primary-chirho;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }

                Rectangle { height: 48px; }
            }
        }
    }
}

// Search panel
component SearchPanelChirho inherits Rectangle {
    in-out property <bool> visible-chirho: false;

    height: visible-chirho ? 320px : 0px;
    background: ThemeChirho.background-secondary-chirho;
    clip: true;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: ThemeChirho.border-chirho;
    }

    animate height { duration: 250ms; easing: ease-out; }

    VerticalLayout {
        padding: ThemeChirho.spacing-lg-chirho;
        spacing: ThemeChirho.spacing-md-chirho;

        HorizontalLayout {
            spacing: ThemeChirho.spacing-md-chirho;

            Text {
                text: LabelsChirho.search-label-chirho;
                font-size: ThemeChirho.font-size-xs-chirho;
                font-weight: 600;
                color: ThemeChirho.text-muted-chirho;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            IconButtonChirho {
                icon-chirho: LabelsChirho.close-icon-chirho;
                clicked-chirho => { root.visible-chirho = false; }
            }
        }

        HorizontalLayout {
            spacing: ThemeChirho.spacing-sm-chirho;

            LineEdit {
                horizontal-stretch: 1;
                placeholder-text: LabelsChirho.search-placeholder-chirho;
                text <=> AppStateChirho.search-query-chirho;
                accepted => {
                    AppStateChirho.search-chirho(AppStateChirho.search-query-chirho);
                }
            }

            Rectangle {
                width: 100px;
                height: 36px;
                background: ThemeChirho.accent-chirho;
                border-radius: ThemeChirho.radius-md-chirho;

                Text {
                    text: LabelsChirho.search-button-chirho;
                    font-size: ThemeChirho.font-size-md-chirho;
                    font-weight: 500;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => {
                        AppStateChirho.search-chirho(AppStateChirho.search-query-chirho);
                    }
                    mouse-cursor: pointer;
                }
            }
        }

        // Search scope selector
        HorizontalLayout {
            spacing: ThemeChirho.spacing-sm-chirho;

            Text {
                text: "Scope:";
                font-size: ThemeChirho.font-size-sm-chirho;
                color: ThemeChirho.text-secondary-chirho;
                vertical-alignment: center;
            }

            // Scope: All
            Rectangle {
                width: 40px;
                height: 28px;
                background: AppStateChirho.search-scope-index-chirho == 0 ? ThemeChirho.accent-chirho : ThemeChirho.background-elevated-chirho;
                border-radius: ThemeChirho.radius-sm-chirho;

                Text {
                    text: "All";
                    font-size: ThemeChirho.font-size-sm-chirho;
                    color: AppStateChirho.search-scope-index-chirho == 0 ? white : ThemeChirho.text-secondary-chirho;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => { AppStateChirho.search-scope-index-chirho = 0; }
                    mouse-cursor: pointer;
                }
            }

            // Scope: OT
            Rectangle {
                width: 40px;
                height: 28px;
                background: AppStateChirho.search-scope-index-chirho == 1 ? ThemeChirho.accent-chirho : ThemeChirho.background-elevated-chirho;
                border-radius: ThemeChirho.radius-sm-chirho;

                Text {
                    text: "OT";
                    font-size: ThemeChirho.font-size-sm-chirho;
                    color: AppStateChirho.search-scope-index-chirho == 1 ? white : ThemeChirho.text-secondary-chirho;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => { AppStateChirho.search-scope-index-chirho = 1; }
                    mouse-cursor: pointer;
                }
            }

            // Scope: NT
            Rectangle {
                width: 40px;
                height: 28px;
                background: AppStateChirho.search-scope-index-chirho == 2 ? ThemeChirho.accent-chirho : ThemeChirho.background-elevated-chirho;
                border-radius: ThemeChirho.radius-sm-chirho;

                Text {
                    text: "NT";
                    font-size: ThemeChirho.font-size-sm-chirho;
                    color: AppStateChirho.search-scope-index-chirho == 2 ? white : ThemeChirho.text-secondary-chirho;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => { AppStateChirho.search-scope-index-chirho = 2; }
                    mouse-cursor: pointer;
                }
            }

            // Scope: Current Book
            Rectangle {
                width: 60px;
                height: 28px;
                background: AppStateChirho.search-scope-index-chirho == 3 ? ThemeChirho.accent-chirho : ThemeChirho.background-elevated-chirho;
                border-radius: ThemeChirho.radius-sm-chirho;

                Text {
                    text: "Book";
                    font-size: ThemeChirho.font-size-sm-chirho;
                    color: AppStateChirho.search-scope-index-chirho == 3 ? white : ThemeChirho.text-secondary-chirho;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => { AppStateChirho.search-scope-index-chirho = 3; }
                    mouse-cursor: pointer;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            // Phrase search hint
            Text {
                text: "Use \"quotes\" for exact phrases";
                font-size: ThemeChirho.font-size-xs-chirho;
                color: ThemeChirho.text-muted-chirho;
                vertical-alignment: center;
            }
        }

        // Search result count
        if AppStateChirho.search-results-chirho.length > 0: Text {
            text: AppStateChirho.search-results-chirho.length + " results found";
            font-size: ThemeChirho.font-size-sm-chirho;
            color: ThemeChirho.text-muted-chirho;
        }

        // No results message
        if AppStateChirho.search-results-chirho.length == 0 && AppStateChirho.search-query-chirho != "": VerticalLayout {
            vertical-stretch: 1;
            alignment: center;

            Text {
                text: "No results found";
                font-size: ThemeChirho.font-size-md-chirho;
                color: ThemeChirho.text-muted-chirho;
                horizontal-alignment: center;
            }

            Text {
                text: "Try different keywords or check your spelling";
                font-size: ThemeChirho.font-size-sm-chirho;
                color: ThemeChirho.text-disabled-chirho;
                horizontal-alignment: center;
            }
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: ThemeChirho.spacing-sm-chirho;

                for result-chirho in AppStateChirho.search-results-chirho: Rectangle {
                    background: result-touch-chirho.has-hover ?
                        ThemeChirho.background-elevated-chirho : ThemeChirho.background-tertiary-chirho;
                    border-radius: ThemeChirho.radius-md-chirho;

                    animate background { duration: ThemeChirho.animation-fast-chirho; easing: ease-out; }

                    result-touch-chirho := TouchArea {
                        clicked => {
                            AppStateChirho.navigate-to-reference-chirho(result-chirho.reference-chirho);
                            AppStateChirho.search-active-chirho = false;
                        }
                        mouse-cursor: pointer;
                    }

                    VerticalLayout {
                        padding: ThemeChirho.spacing-md-chirho;
                        spacing: ThemeChirho.spacing-xs-chirho;

                        Text {
                            text: result-chirho.reference-chirho;
                            font-size: ThemeChirho.font-size-sm-chirho;
                            font-weight: 600;
                            color: ThemeChirho.accent-chirho;
                        }

                        Text {
                            text: result-chirho.text-chirho;
                            font-size: ThemeChirho.font-size-md-chirho;
                            color: ThemeChirho.text-secondary-chirho;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}

// Strong's Number Popup - shows lexicon entry for a Strong's number
component StrongsPopupChirho inherits Rectangle {
    in property <StrongsEntryChirho> entry-chirho;
    in property <bool> visible-chirho: false;

    width: 320px;
    visible: visible-chirho;
    background: ThemeChirho.background-secondary-chirho;
    border-radius: ThemeChirho.radius-lg-chirho;
    border-width: 1px;
    border-color: ThemeChirho.border-chirho;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000040;

    VerticalLayout {
        padding: ThemeChirho.spacing-lg-chirho;
        spacing: ThemeChirho.spacing-md-chirho;

        // Header with Strong's number
        HorizontalLayout {
            spacing: ThemeChirho.spacing-sm-chirho;

            Rectangle {
                width: 48px;
                height: 28px;
                background: entry-chirho.is-hebrew-chirho ? ThemeChirho.hebrew-chirho.with-alpha(0.2) : ThemeChirho.greek-chirho.with-alpha(0.2);
                border-radius: ThemeChirho.radius-sm-chirho;

                Text {
                    text: entry-chirho.number-chirho;
                    font-size: ThemeChirho.font-size-sm-chirho;
                    font-weight: 700;
                    color: entry-chirho.is-hebrew-chirho ? ThemeChirho.hebrew-chirho : ThemeChirho.greek-chirho;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Text {
                text: entry-chirho.lemma-chirho;
                font-size: ThemeChirho.font-size-lg-chirho;
                font-weight: 600;
                color: ThemeChirho.text-primary-chirho;
                vertical-alignment: center;
            }
        }

        // Transliteration and pronunciation
        if entry-chirho.transliteration-chirho != "": HorizontalLayout {
            spacing: ThemeChirho.spacing-sm-chirho;

            Text {
                text: entry-chirho.transliteration-chirho;
                font-size: ThemeChirho.font-size-md-chirho;
                color: ThemeChirho.text-secondary-chirho;
            }

            if entry-chirho.pronunciation-chirho != "": Text {
                text: "(" + entry-chirho.pronunciation-chirho + ")";
                font-size: ThemeChirho.font-size-sm-chirho;
                color: ThemeChirho.text-muted-chirho;
            }
        }

        // Definition
        Text {
            text: entry-chirho.definition-chirho;
            font-size: ThemeChirho.font-size-md-chirho;
            color: ThemeChirho.text-primary-chirho;
            wrap: word-wrap;
        }

        // Usage notes (if present)
        if entry-chirho.usage-chirho != "": Rectangle {
            background: ThemeChirho.background-tertiary-chirho;
            border-radius: ThemeChirho.radius-sm-chirho;

            VerticalLayout {
                padding: ThemeChirho.spacing-sm-chirho;

                Text {
                    text: "Usage:";
                    font-size: ThemeChirho.font-size-xs-chirho;
                    font-weight: 600;
                    color: ThemeChirho.text-muted-chirho;
                }

                Text {
                    text: entry-chirho.usage-chirho;
                    font-size: ThemeChirho.font-size-sm-chirho;
                    color: ThemeChirho.text-secondary-chirho;
                    wrap: word-wrap;
                }
            }
        }

        // Occurrences
        if entry-chirho.occurrences-chirho > 0: Text {
            text: "Occurs " + entry-chirho.occurrences-chirho + " times";
            font-size: ThemeChirho.font-size-xs-chirho;
            color: ThemeChirho.text-muted-chirho;
        }
    }

    // Close on click outside
    popup-touch-chirho := TouchArea {
        clicked => {
            AppStateChirho.strongs-popup-visible-chirho = false;
        }
    }
}

// Morphology popup for grammatical analysis
component MorphologyPopupChirho inherits Rectangle {
    in property <bool> visible-chirho: false;

    width: 320px;
    visible: visible-chirho;
    background: ThemeChirho.background-secondary-chirho;
    border-radius: ThemeChirho.radius-lg-chirho;
    border-width: 1px;
    border-color: ThemeChirho.border-chirho;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000040;

    VerticalLayout {
        padding: ThemeChirho.spacing-lg-chirho;
        spacing: ThemeChirho.spacing-md-chirho;

        // Header with word and morphology code
        HorizontalLayout {
            spacing: ThemeChirho.spacing-sm-chirho;

            Rectangle {
                width: 60px;
                height: 28px;
                background: AppStateChirho.morphology-is-hebrew-chirho ? ThemeChirho.hebrew-chirho.with-alpha(0.2) : ThemeChirho.greek-chirho.with-alpha(0.2);
                border-radius: ThemeChirho.radius-sm-chirho;

                Text {
                    text: AppStateChirho.morphology-code-chirho;
                    font-size: ThemeChirho.font-size-xs-chirho;
                    font-weight: 700;
                    color: AppStateChirho.morphology-is-hebrew-chirho ? ThemeChirho.hebrew-chirho : ThemeChirho.greek-chirho;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Text {
                text: AppStateChirho.morphology-word-chirho;
                font-size: ThemeChirho.font-size-lg-chirho;
                font-weight: 600;
                color: ThemeChirho.text-primary-chirho;
                vertical-alignment: center;
            }
        }

        // Section label
        Text {
            text: AppStateChirho.morphology-is-hebrew-chirho ? "Hebrew Morphology" : "Greek Morphology";
            font-size: ThemeChirho.font-size-xs-chirho;
            font-weight: 600;
            color: ThemeChirho.text-muted-chirho;
        }

        // Parsed morphology explanation
        Text {
            text: AppStateChirho.morphology-parsed-chirho;
            font-size: ThemeChirho.font-size-md-chirho;
            color: ThemeChirho.text-primary-chirho;
            wrap: word-wrap;
        }

        // Legend/help
        Rectangle {
            background: ThemeChirho.background-tertiary-chirho;
            border-radius: ThemeChirho.radius-sm-chirho;

            VerticalLayout {
                padding: ThemeChirho.spacing-sm-chirho;

                Text {
                    text: "Code Legend:";
                    font-size: ThemeChirho.font-size-xs-chirho;
                    font-weight: 600;
                    color: ThemeChirho.text-muted-chirho;
                }

                Text {
                    text: AppStateChirho.morphology-is-hebrew-chirho ?
                        "V=Verb, N=Noun, A=Adjective, P=Preposition\n" +
                        "m/f=masculine/feminine, s/p=singular/plural" :
                        "V=Verb, N=Noun, A=Adjective, D=Adverb\n" +
                        "A/P/M=Active/Passive/Middle, I/S/O=Indicative/Subjunctive/Optative";
                    font-size: ThemeChirho.font-size-xs-chirho;
                    color: ThemeChirho.text-secondary-chirho;
                    wrap: word-wrap;
                }
            }
        }
    }

    // Close on click outside
    TouchArea {
        clicked => {
            AppStateChirho.morphology-popup-visible-chirho = false;
        }
    }
}

// Cross-references popup
component CrossRefsPopupChirho inherits Rectangle {
    in property <bool> visible-chirho: false;

    width: 300px;
    max-height: 400px;
    visible: visible-chirho;
    background: ThemeChirho.background-secondary-chirho;
    border-radius: ThemeChirho.radius-lg-chirho;
    border-width: 1px;
    border-color: ThemeChirho.border-chirho;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000040;

    VerticalLayout {
        padding: ThemeChirho.spacing-lg-chirho;
        spacing: ThemeChirho.spacing-md-chirho;

        // Header
        HorizontalLayout {
            Text {
                text: "Cross-References";
                font-size: ThemeChirho.font-size-md-chirho;
                font-weight: 600;
                color: ThemeChirho.text-primary-chirho;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            IconButtonChirho {
                icon-chirho: LabelsChirho.close-icon-chirho;
                clicked-chirho => {
                    AppStateChirho.cross-refs-popup-visible-chirho = false;
                }
            }
        }

        Text {
            text: AppStateChirho.cross-refs-verse-chirho;
            font-size: ThemeChirho.font-size-sm-chirho;
            color: ThemeChirho.text-muted-chirho;
        }

        Rectangle {
            height: 1px;
            background: ThemeChirho.divider-chirho;
        }

        // Cross-reference list
        if AppStateChirho.cross-refs-list-chirho.length == 0: Text {
            text: "No cross-references found";
            font-size: ThemeChirho.font-size-sm-chirho;
            color: ThemeChirho.text-muted-chirho;
            horizontal-alignment: center;
        }

        ScrollView {
            vertical-stretch: 1;
            max-height: 250px;

            VerticalLayout {
                spacing: ThemeChirho.spacing-xs-chirho;

                for ref-chirho in AppStateChirho.cross-refs-list-chirho: Rectangle {
                    height: 36px;
                    background: xref-touch-chirho.has-hover ? ThemeChirho.background-elevated-chirho : transparent;
                    border-radius: ThemeChirho.radius-sm-chirho;

                    xref-touch-chirho := TouchArea {
                        clicked => {
                            AppStateChirho.navigate-to-reference-chirho(ref-chirho);
                            AppStateChirho.cross-refs-popup-visible-chirho = false;
                        }
                        mouse-cursor: pointer;
                    }

                    HorizontalLayout {
                        padding-left: ThemeChirho.spacing-sm-chirho;
                        padding-right: ThemeChirho.spacing-sm-chirho;

                        Text {
                            text: "→";
                            font-size: ThemeChirho.font-size-sm-chirho;
                            color: ThemeChirho.accent-chirho;
                            vertical-alignment: center;
                        }

                        Text {
                            text: ref-chirho;
                            font-size: ThemeChirho.font-size-sm-chirho;
                            color: ThemeChirho.text-primary-chirho;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

// Footnote popup
component FootnotePopupChirho inherits Rectangle {
    in property <bool> visible-chirho: false;

    width: 300px;
    visible: visible-chirho;
    background: ThemeChirho.background-secondary-chirho;
    border-radius: ThemeChirho.radius-lg-chirho;
    border-width: 1px;
    border-color: ThemeChirho.border-chirho;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000040;

    VerticalLayout {
        padding: ThemeChirho.spacing-lg-chirho;
        spacing: ThemeChirho.spacing-md-chirho;

        // Header
        HorizontalLayout {
            spacing: ThemeChirho.spacing-sm-chirho;

            Rectangle {
                width: 24px;
                height: 24px;
                background: ThemeChirho.accent-chirho.with-alpha(0.2);
                border-radius: 12px;

                Text {
                    text: AppStateChirho.footnote-marker-chirho;
                    font-size: ThemeChirho.font-size-xs-chirho;
                    font-weight: 700;
                    color: ThemeChirho.accent-chirho;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Text {
                text: AppStateChirho.footnote-type-chirho == "translator" ? "Translator's Note" :
                      AppStateChirho.footnote-type-chirho == "textual" ? "Textual Note" :
                      AppStateChirho.footnote-type-chirho == "alternative" ? "Alternative Reading" :
                      "Footnote";
                font-size: ThemeChirho.font-size-sm-chirho;
                font-weight: 600;
                color: ThemeChirho.text-muted-chirho;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            IconButtonChirho {
                icon-chirho: LabelsChirho.close-icon-chirho;
                clicked-chirho => {
                    AppStateChirho.footnote-popup-visible-chirho = false;
                }
            }
        }

        // Footnote content
        Text {
            text: AppStateChirho.footnote-content-chirho;
            font-size: ThemeChirho.font-size-md-chirho;
            color: ThemeChirho.text-primary-chirho;
            wrap: word-wrap;
        }
    }

    // Close on click outside
    TouchArea {
        clicked => {
            AppStateChirho.footnote-popup-visible-chirho = false;
        }
    }
}

// Top toolbar
component ToolbarChirho inherits Rectangle {
    height: 52px;
    background: ThemeChirho.background-secondary-chirho;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: ThemeChirho.border-chirho;
    }

    HorizontalLayout {
        padding: ThemeChirho.spacing-md-chirho;
        spacing: ThemeChirho.spacing-md-chirho;

        IconButtonChirho {
            icon-chirho: LabelsChirho.menu-icon-chirho;
            active-chirho: AppStateChirho.sidebar-visible-chirho;
            clicked-chirho => {
                AppStateChirho.sidebar-visible-chirho = !AppStateChirho.sidebar-visible-chirho;
            }
        }

        // App branding
        Text {
            text: LabelsChirho.app-icon-chirho + " " + LabelsChirho.app-name-chirho;
            font-size: ThemeChirho.font-size-lg-chirho;
            font-weight: 700;
            color: ThemeChirho.text-primary-chirho;
            vertical-alignment: center;
        }

        Rectangle { horizontal-stretch: 1; }

        // Font size controls
        Text {
            text: "A";
            font-size: 12px;
            color: ThemeChirho.text-muted-chirho;
            vertical-alignment: center;
        }

        Rectangle {
            width: 80px;
            height: 24px;

            Slider {
                minimum: 0.8;
                maximum: 1.5;
                value <=> AppStateChirho.font-scale-chirho;
            }
        }

        Text {
            text: "A";
            font-size: 18px;
            color: ThemeChirho.text-muted-chirho;
            vertical-alignment: center;
        }

        IconButtonChirho {
            icon-chirho: LabelsChirho.search-icon-chirho;
            active-chirho: AppStateChirho.search-active-chirho;
            clicked-chirho => {
                AppStateChirho.search-active-chirho = !AppStateChirho.search-active-chirho;
            }
        }

        // Bookmarks button
        IconButtonChirho {
            icon-chirho: LabelsChirho.bookmark-icon-chirho;
            active-chirho: AppStateChirho.bookmarks-visible-chirho;
            clicked-chirho => {
                AppStateChirho.bookmarks-visible-chirho = !AppStateChirho.bookmarks-visible-chirho;
            }
        }

        // History button
        IconButtonChirho {
            icon-chirho: LabelsChirho.history-icon-chirho;
            active-chirho: AppStateChirho.history-visible-chirho;
            clicked-chirho => {
                AppStateChirho.load-history-chirho();
                AppStateChirho.history-visible-chirho = !AppStateChirho.history-visible-chirho;
            }
        }

        // Highlights button
        IconButtonChirho {
            icon-chirho: "*";
            active-chirho: AppStateChirho.highlights-visible-chirho;
            clicked-chirho => {
                AppStateChirho.load-all-highlights-chirho();
                AppStateChirho.highlights-visible-chirho = !AppStateChirho.highlights-visible-chirho;
            }
        }

        // Notes button
        IconButtonChirho {
            icon-chirho: "📝";
            active-chirho: AppStateChirho.notes-visible-chirho;
            clicked-chirho => {
                AppStateChirho.load-all-notes-chirho();
                AppStateChirho.notes-visible-chirho = !AppStateChirho.notes-visible-chirho;
            }
        }

        // Parallel View button (side-by-side translations)
        IconButtonChirho {
            icon-chirho: "⫗";
            active-chirho: AppStateChirho.parallel-view-enabled-chirho;
            clicked-chirho => {
                AppStateChirho.parallel-view-enabled-chirho = !AppStateChirho.parallel-view-enabled-chirho;
            }
        }

        // Strong's Numbers button (study tool)
        IconButtonChirho {
            icon-chirho: "H";  // H for Hebrew/Greek Strong's
            active-chirho: AppStateChirho.strongs-visible-chirho;
            clicked-chirho => {
                AppStateChirho.toggle-strongs-display-chirho();
            }
        }

        // Morphology button (grammatical analysis)
        IconButtonChirho {
            icon-chirho: "M";  // M for Morphology
            active-chirho: AppStateChirho.morphology-visible-chirho;
            clicked-chirho => {
                AppStateChirho.toggle-morphology-display-chirho();
            }
        }

        // Cross-References button
        IconButtonChirho {
            icon-chirho: "Xr";  // Arrow for cross-refs
            active-chirho: AppStateChirho.cross-refs-visible-chirho;
            clicked-chirho => {
                AppStateChirho.toggle-cross-refs-display-chirho();
            }
        }

        // Footnotes button
        IconButtonChirho {
            icon-chirho: "Fn";  // Reference mark for footnotes
            active-chirho: AppStateChirho.footnotes-visible-chirho;
            clicked-chirho => {
                AppStateChirho.toggle-footnotes-display-chirho();
            }
        }

        // Interlinear button (word-by-word display)
        IconButtonChirho {
            icon-chirho: "≡";  // Parallel lines for interlinear
            active-chirho: AppStateChirho.interlinear-visible-chirho;
            clicked-chirho => {
                AppStateChirho.toggle-interlinear-display-chirho();
            }
        }

        // Info Panel button (verse details)
        IconButtonChirho {
            icon-chirho: "ℹ";
            active-chirho: AppStateChirho.info-panel-visible-chirho;
            clicked-chirho => {
                AppStateChirho.info-panel-visible-chirho = !AppStateChirho.info-panel-visible-chirho;
            }
        }

        // Statistics button
        IconButtonChirho {
            icon-chirho: "St";  // Statistics
            active-chirho: AppStateChirho.stats-panel-visible-chirho;
            clicked-chirho => {
                AppStateChirho.stats-panel-visible-chirho = !AppStateChirho.stats-panel-visible-chirho;
                if AppStateChirho.stats-panel-visible-chirho {
                    AppStateChirho.load-statistics-chirho();
                }
            }
        }

        // Journal button
        IconButtonChirho {
            icon-chirho: "Jn";  // Journal
            active-chirho: AppStateChirho.journal-panel-visible-chirho;
            clicked-chirho => {
                AppStateChirho.journal-panel-visible-chirho = !AppStateChirho.journal-panel-visible-chirho;
                if AppStateChirho.journal-panel-visible-chirho {
                    AppStateChirho.load-journal-entries-chirho();
                }
            }
        }

        // Prayer list button
        IconButtonChirho {
            icon-chirho: "Pr";  // Prayer
            active-chirho: AppStateChirho.prayer-panel-visible-chirho;
            clicked-chirho => {
                AppStateChirho.prayer-panel-visible-chirho = !AppStateChirho.prayer-panel-visible-chirho;
                if AppStateChirho.prayer-panel-visible-chirho {
                    AppStateChirho.load-prayer-requests-chirho();
                }
            }
        }

        // Reading Plans button
        IconButtonChirho {
            icon-chirho: "Pl";  // Plans
            active-chirho: AppStateChirho.reading-plan-panel-visible-chirho;
            clicked-chirho => {
                AppStateChirho.reading-plan-panel-visible-chirho = !AppStateChirho.reading-plan-panel-visible-chirho;
                if AppStateChirho.reading-plan-panel-visible-chirho {
                    AppStateChirho.load-reading-plans-chirho();
                }
            }
        }

        // Commentary button
        IconButtonChirho {
            icon-chirho: "Cm";  // Commentary
            active-chirho: AppStateChirho.commentary-panel-visible-chirho;
            clicked-chirho => {
                AppStateChirho.commentary-panel-visible-chirho = !AppStateChirho.commentary-panel-visible-chirho;
                if AppStateChirho.commentary-panel-visible-chirho {
                    // Load commentary for current verse
                    AppStateChirho.load-commentary-chirho(
                        AppStateChirho.current-book-chirho + " " + AppStateChirho.current-chapter-chirho + ":1"
                    );
                }
            }
        }

        // Lexicon button
        IconButtonChirho {
            icon-chirho: "Lx";  // Lexicon
            active-chirho: AppStateChirho.lexicon-panel-visible-chirho;
            clicked-chirho => {
                AppStateChirho.lexicon-panel-visible-chirho = !AppStateChirho.lexicon-panel-visible-chirho;
            }
        }

        // Verse of the Day button
        IconButtonChirho {
            icon-chirho: "Vd";  // Verse of Day
            active-chirho: AppStateChirho.votd-dialog-visible-chirho;
            clicked-chirho => {
                AppStateChirho.load-verse-of-the-day-chirho();
                AppStateChirho.votd-dialog-visible-chirho = true;
            }
        }

        // Theme toggle button (cycles: dark → light → sepia → dark)
        IconButtonChirho {
            icon-chirho:
                ThemeChirho.theme-index-chirho == 0 ? LabelsChirho.theme-light-icon-chirho :
                ThemeChirho.theme-index-chirho == 1 ? LabelsChirho.theme-sepia-icon-chirho :
                LabelsChirho.theme-dark-icon-chirho;
            clicked-chirho => {
                ThemeChirho.theme-index-chirho = Math.mod(ThemeChirho.theme-index-chirho + 1, 3);
            }
        }

        // Module Manager button
        IconButtonChirho {
            icon-chirho: "Md";  // Modules
            active-chirho: AppStateChirho.module-manager-visible-chirho;
            clicked-chirho => {
                AppStateChirho.module-manager-visible-chirho = !AppStateChirho.module-manager-visible-chirho;
            }
        }

        IconButtonChirho {
            icon-chirho: LabelsChirho.settings-icon-chirho;
            active-chirho: AppStateChirho.settings-visible-chirho;
            clicked-chirho => {
                AppStateChirho.settings-visible-chirho = !AppStateChirho.settings-visible-chirho;
            }
        }
    }
}

// Status bar
component StatusBarChirho inherits Rectangle {
    height: 28px;
    background: ThemeChirho.background-tertiary-chirho;

