// Settings panel component
component SettingsPanelChirho inherits Rectangle {
    in-out property <bool> visible-chirho: false;

    width: 100%;
    height: 100%;
    background: visible-chirho ? #00000080 : transparent;

    animate background { duration: ThemeChirho.animation-normal-chirho; }

    if visible-chirho: Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 500px;
        height: 640px;
        background: ThemeChirho.background-secondary-chirho;
        border-radius: ThemeChirho.radius-lg-chirho;
        border-width: 1px;
        border-color: ThemeChirho.border-chirho;
        drop-shadow-blur: 20px;
        drop-shadow-color: #00000040;

        VerticalLayout {
            padding: ThemeChirho.spacing-lg-chirho;
            spacing: ThemeChirho.spacing-md-chirho;

            // Header
            HorizontalLayout {
                Text {
                    text: "Settings";
                    font-size: ThemeChirho.font-size-xl-chirho;
                    font-weight: 700;
                    color: ThemeChirho.text-primary-chirho;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                IconButtonChirho {
                    icon-chirho: LabelsChirho.close-icon-chirho;
                    clicked-chirho => {
                        AppStateChirho.settings-visible-chirho = false;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: ThemeChirho.divider-chirho;
            }

            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: ThemeChirho.spacing-lg-chirho;

                    // Display Settings Section
                    VerticalLayout {
                        spacing: ThemeChirho.spacing-sm-chirho;

                        Text {
                            text: "Display";
                            font-size: ThemeChirho.font-size-sm-chirho;
                            font-weight: 600;
                            color: ThemeChirho.text-muted-chirho;
                        }

                        // Theme selector (Dark, Light, Sepia, High Contrast)
                        VerticalLayout {
                            spacing: ThemeChirho.spacing-xs-chirho;

                            HorizontalLayout {
                                spacing: ThemeChirho.spacing-md-chirho;
                                height: 40px;

                                Text {
                                    text: "Theme";
                                    font-size: ThemeChirho.font-size-md-chirho;
                                    color: ThemeChirho.text-primary-chirho;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }

                            HorizontalLayout {
                                spacing: ThemeChirho.spacing-xs-chirho;

                                for theme-opt-chirho in [
                                    { idx-chirho: 0, name-chirho: "Dark", icon-chirho: "D" },
                                    { idx-chirho: 1, name-chirho: "Light", icon-chirho: "L" },
                                    { idx-chirho: 2, name-chirho: "Sepia", icon-chirho: "S" },
                                    { idx-chirho: 3, name-chirho: "Contrast", icon-chirho: "⬤" }
                                ]: Rectangle {
                                    horizontal-stretch: 1;
                                    height: 32px;
                                    background: theme-opt-chirho.idx-chirho == ThemeChirho.theme-index-chirho ?
                                        ThemeChirho.accent-chirho : ThemeChirho.background-tertiary-chirho;
                                    border-radius: ThemeChirho.radius-sm-chirho;

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 4px;

                                        Text {
                                            text: theme-opt-chirho.icon-chirho;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: theme-opt-chirho.name-chirho;
                                            font-size: 11px;
                                            color: theme-opt-chirho.idx-chirho == ThemeChirho.theme-index-chirho ?
                                                white : ThemeChirho.text-secondary-chirho;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        clicked => {
                                            ThemeChirho.theme-index-chirho = theme-opt-chirho.idx-chirho;
                                        }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }
                        }

                        // Font family
                        HorizontalLayout {
                            spacing: ThemeChirho.spacing-md-chirho;
                            height: 40px;

                            Text {
                                text: "Font Family";
                                font-size: ThemeChirho.font-size-md-chirho;
                                color: ThemeChirho.text-primary-chirho;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            HorizontalLayout {
                                spacing: ThemeChirho.spacing-xs-chirho;

                                for font-idx-chirho in [
                                    { idx-chirho: 0, name-chirho: "System" },
                                    { idx-chirho: 1, name-chirho: "Serif" },
                                    { idx-chirho: 2, name-chirho: "Sans" }
                                ]: Rectangle {
                                    width: 60px;
                                    height: 28px;
                                    background: font-idx-chirho.idx-chirho == AppStateChirho.font-family-index-chirho ?
                                        ThemeChirho.accent-chirho : ThemeChirho.background-tertiary-chirho;
                                    border-radius: ThemeChirho.radius-sm-chirho;

                                    Text {
                                        text: font-idx-chirho.name-chirho;
                                        font-size: ThemeChirho.font-size-sm-chirho;
                                        color: font-idx-chirho.idx-chirho == AppStateChirho.font-family-index-chirho ?
                                            white : ThemeChirho.text-secondary-chirho;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        clicked => {
                                            AppStateChirho.font-family-index-chirho = font-idx-chirho.idx-chirho;
                                        }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }
                        }

                        // Font size
                        HorizontalLayout {
                            spacing: ThemeChirho.spacing-md-chirho;
                            height: 40px;

                            Text {
                                text: "Font Size";
                                font-size: ThemeChirho.font-size-md-chirho;
                                color: ThemeChirho.text-primary-chirho;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            Rectangle {
                                width: 120px;
                                height: 30px;

                                Slider {
                                    minimum: 0.8;
                                    maximum: 1.5;
                                    value <=> AppStateChirho.font-scale-chirho;
                                }
                            }
                        }

                        // Line height
                        HorizontalLayout {
                            spacing: ThemeChirho.spacing-md-chirho;
                            height: 40px;

                            Text {
                                text: "Line Height";
                                font-size: ThemeChirho.font-size-md-chirho;
                                color: ThemeChirho.text-primary-chirho;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            Rectangle {
                                width: 120px;
                                height: 30px;

                                Slider {
                                    minimum: 1.2;
                                    maximum: 2.5;
                                    value <=> AppStateChirho.line-height-chirho;
                                }
                            }
                        }

                        // Paragraph mode toggle
                        HorizontalLayout {
                            spacing: ThemeChirho.spacing-md-chirho;
                            height: 40px;

                            Text {
                                text: "Paragraph Mode";
                                font-size: ThemeChirho.font-size-md-chirho;
                                color: ThemeChirho.text-primary-chirho;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            Rectangle {
                                width: 50px;
                                height: 26px;
                                background: AppStateChirho.paragraph-mode-chirho ? ThemeChirho.accent-chirho : ThemeChirho.background-tertiary-chirho;
                                border-radius: 13px;
                                border-width: 1px;
                                border-color: ThemeChirho.border-chirho;

                                Rectangle {
                                    x: AppStateChirho.paragraph-mode-chirho ? 26px : 2px;
                                    y: 2px;
                                    width: 22px;
                                    height: 22px;
                                    background: white;
                                    border-radius: 11px;

                                    animate x { duration: ThemeChirho.animation-normal-chirho; easing: ease-out; }
                                }

                                TouchArea {
                                    clicked => {
                                        AppStateChirho.paragraph-mode-chirho = !AppStateChirho.paragraph-mode-chirho;
                                    }
                                    mouse-cursor: pointer;
                                }
                            }
                        }

                        // Versification System selector
                        HorizontalLayout {
                            spacing: ThemeChirho.spacing-md-chirho;
                            height: 40px;

                            Text {
                                text: "Versification";
                                font-size: ThemeChirho.font-size-md-chirho;
                                color: ThemeChirho.text-primary-chirho;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }

                        HorizontalLayout {
                            spacing: ThemeChirho.spacing-xs-chirho;

                            for vers-chirho[idx-chirho] in AppStateChirho.versification-systems-chirho: Rectangle {
                                horizontal-stretch: 1;
                                height: 28px;
                                background: idx-chirho == AppStateChirho.versification-index-chirho ?
                                    ThemeChirho.accent-chirho : ThemeChirho.background-tertiary-chirho;
                                border-radius: ThemeChirho.radius-sm-chirho;

                                Text {
                                    text: vers-chirho;
                                    font-size: ThemeChirho.font-size-xs-chirho;
                                    color: idx-chirho == AppStateChirho.versification-index-chirho ?
                                        white : ThemeChirho.text-secondary-chirho;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    clicked => {
                                        AppStateChirho.versification-index-chirho = idx-chirho;
                                        AppStateChirho.set-versification-chirho(idx-chirho);
                                    }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: ThemeChirho.divider-chirho;
                    }

                    // Copy Format Section
                    VerticalLayout {
                        spacing: ThemeChirho.spacing-sm-chirho;

                        Text {
                            text: "Copy Format";
                            font-size: ThemeChirho.font-size-sm-chirho;
                            font-weight: 600;
                            color: ThemeChirho.text-muted-chirho;
                        }

                        // Format selector
                        HorizontalLayout {
                            spacing: ThemeChirho.spacing-md-chirho;
                            height: 40px;

                            Text {
                                text: "Format";
                                font-size: ThemeChirho.font-size-md-chirho;
                                color: ThemeChirho.text-primary-chirho;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            HorizontalLayout {
                                spacing: ThemeChirho.spacing-xs-chirho;

                                for format-opt-chirho in [
                                    { idx-chirho: 0, name-chirho: "Text - Ref" },
                                    { idx-chirho: 1, name-chirho: "Ref: Text" },
                                    { idx-chirho: 2, name-chirho: "Text Only" }
                                ]: Rectangle {
                                    width: 75px;
                                    height: 28px;
                                    background: format-opt-chirho.idx-chirho == AppStateChirho.copy-format-index-chirho ?
                                        ThemeChirho.accent-chirho : ThemeChirho.background-tertiary-chirho;
                                    border-radius: ThemeChirho.radius-sm-chirho;

                                    Text {
                                        text: format-opt-chirho.name-chirho;
                                        font-size: ThemeChirho.font-size-xs-chirho;
                                        color: format-opt-chirho.idx-chirho == AppStateChirho.copy-format-index-chirho ?
                                            white : ThemeChirho.text-secondary-chirho;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        clicked => {
                                            AppStateChirho.copy-format-index-chirho = format-opt-chirho.idx-chirho;
                                        }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }
                        }

                        // Include verse numbers toggle
                        HorizontalLayout {
                            spacing: ThemeChirho.spacing-md-chirho;
                            height: 40px;

                            Text {
                                text: "Include Verse Numbers";
                                font-size: ThemeChirho.font-size-md-chirho;
                                color: ThemeChirho.text-primary-chirho;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            Rectangle {
                                width: 50px;
                                height: 26px;
                                background: AppStateChirho.copy-include-verse-numbers-chirho ? ThemeChirho.accent-chirho : ThemeChirho.background-tertiary-chirho;
                                border-radius: 13px;
                                border-width: 1px;
                                border-color: ThemeChirho.border-chirho;

                                Rectangle {
                                    x: AppStateChirho.copy-include-verse-numbers-chirho ? 26px : 2px;
                                    y: 2px;
                                    width: 22px;
                                    height: 22px;
                                    background: white;
                                    border-radius: 11px;

                                    animate x { duration: ThemeChirho.animation-normal-chirho; easing: ease-out; }
                                }

                                TouchArea {
                                    clicked => {
                                        AppStateChirho.copy-include-verse-numbers-chirho = !AppStateChirho.copy-include-verse-numbers-chirho;
                                    }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: ThemeChirho.divider-chirho;
                    }

                    // Keyboard Shortcuts Section
                    VerticalLayout {
                        spacing: ThemeChirho.spacing-sm-chirho;

                        Text {
                            text: "Keyboard Shortcuts";
                            font-size: ThemeChirho.font-size-sm-chirho;
                            font-weight: 600;
                            color: ThemeChirho.text-muted-chirho;
                        }

                        // List of shortcuts
                        VerticalLayout {
                            spacing: 4px;

                            HorizontalLayout {
                                height: 28px;
                                Text { text: "Ctrl+F"; font-size: 13px; color: ThemeChirho.accent-chirho; width: 80px; vertical-alignment: center; }
                                Text { text: "Search"; font-size: 13px; color: ThemeChirho.text-secondary-chirho; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                height: 28px;
                                Text { text: "Ctrl+G"; font-size: 13px; color: ThemeChirho.accent-chirho; width: 80px; vertical-alignment: center; }
                                Text { text: "Go to verse"; font-size: 13px; color: ThemeChirho.text-secondary-chirho; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                height: 28px;
                                Text { text: "Ctrl+B"; font-size: 13px; color: ThemeChirho.accent-chirho; width: 80px; vertical-alignment: center; }
                                Text { text: "Toggle sidebar"; font-size: 13px; color: ThemeChirho.text-secondary-chirho; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                height: 28px;
                                Text { text: "Ctrl+T"; font-size: 13px; color: ThemeChirho.accent-chirho; width: 80px; vertical-alignment: center; }
                                Text { text: "Toggle theme"; font-size: 13px; color: ThemeChirho.text-secondary-chirho; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                height: 28px;
                                Text { text: "Ctrl+D"; font-size: 13px; color: ThemeChirho.accent-chirho; width: 80px; vertical-alignment: center; }
                                Text { text: "Toggle bookmarks"; font-size: 13px; color: ThemeChirho.text-secondary-chirho; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                height: 28px;
                                Text { text: "Ctrl+H"; font-size: 13px; color: ThemeChirho.accent-chirho; width: 80px; vertical-alignment: center; }
                                Text { text: "Toggle highlights"; font-size: 13px; color: ThemeChirho.text-secondary-chirho; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                height: 28px;
                                Text { text: "Ctrl+N"; font-size: 13px; color: ThemeChirho.accent-chirho; width: 80px; vertical-alignment: center; }
                                Text { text: "Toggle notes"; font-size: 13px; color: ThemeChirho.text-secondary-chirho; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                height: 28px;
                                Text { text: "Ctrl+M"; font-size: 13px; color: ThemeChirho.accent-chirho; width: 80px; vertical-alignment: center; }
                                Text { text: "Module manager"; font-size: 13px; color: ThemeChirho.text-secondary-chirho; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                height: 28px;
                                Text { text: "Ctrl+P"; font-size: 13px; color: ThemeChirho.accent-chirho; width: 80px; vertical-alignment: center; }
                                Text { text: "Parallel view"; font-size: 13px; color: ThemeChirho.text-secondary-chirho; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                height: 28px;
                                Text { text: "Ctrl+K"; font-size: 13px; color: ThemeChirho.accent-chirho; width: 80px; vertical-alignment: center; }
                                Text { text: "Quick navigation"; font-size: 13px; color: ThemeChirho.text-secondary-chirho; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                height: 28px;
                                Text { text: "← / →"; font-size: 13px; color: ThemeChirho.accent-chirho; width: 80px; vertical-alignment: center; }
                                Text { text: "Previous/Next chapter"; font-size: 13px; color: ThemeChirho.text-secondary-chirho; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                height: 28px;
                                Text { text: "Escape"; font-size: 13px; color: ThemeChirho.accent-chirho; width: 80px; vertical-alignment: center; }
                                Text { text: "Close dialogs"; font-size: 13px; color: ThemeChirho.text-secondary-chirho; vertical-alignment: center; }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: ThemeChirho.divider-chirho;
                    }

                    // Data & Backup Section
                    VerticalLayout {
                        spacing: ThemeChirho.spacing-sm-chirho;

                        Text {
                            text: "Data & Backup";
                            font-size: ThemeChirho.font-size-sm-chirho;
                            font-weight: 600;
                            color: ThemeChirho.text-muted-chirho;
                        }

                        Text {
                            text: "Export your data for backup or transfer";
                            font-size: ThemeChirho.font-size-sm-chirho;
                            color: ThemeChirho.text-secondary-chirho;
                        }

                        // Export buttons row
                        HorizontalLayout {
                            spacing: ThemeChirho.spacing-sm-chirho;
                            height: 36px;

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 32px;
                                background: export-all-touch-chirho.has-hover ? ThemeChirho.accent-hover-chirho : ThemeChirho.accent-chirho;
                                border-radius: ThemeChirho.radius-md-chirho;

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    Text {
                                        text: "💾";
                                        font-size: 14px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "Export All Data";
                                        font-size: ThemeChirho.font-size-sm-chirho;
                                        font-weight: 500;
                                        color: white;
                                        vertical-alignment: center;
                                    }
                                }

                                export-all-touch-chirho := TouchArea {
                                    clicked => {
                                        AppStateChirho.export-all-data-chirho();
                                    }
                                    mouse-cursor: pointer;
                                }
                            }
                        }

                        // Individual export buttons
                        HorizontalLayout {
                            spacing: ThemeChirho.spacing-xs-chirho;
                            height: 32px;

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 28px;
                                background: export-hl-touch-chirho.has-hover ? ThemeChirho.background-elevated-chirho : ThemeChirho.background-tertiary-chirho;
                                border-radius: ThemeChirho.radius-sm-chirho;
                                border-width: 1px;
                                border-color: ThemeChirho.border-subtle-chirho;

                                Text {
                                    text: "* Highlights";
                                    font-size: 11px;
                                    color: ThemeChirho.text-secondary-chirho;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                export-hl-touch-chirho := TouchArea {
                                    clicked => {
                                        AppStateChirho.export-highlights-chirho();
                                    }
                                    mouse-cursor: pointer;
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 28px;
                                background: export-bm-touch-chirho.has-hover ? ThemeChirho.background-elevated-chirho : ThemeChirho.background-tertiary-chirho;
                                border-radius: ThemeChirho.radius-sm-chirho;
                                border-width: 1px;
                                border-color: ThemeChirho.border-subtle-chirho;

                                Text {
                                    text: "Bk Bookmarks";
                                    font-size: 11px;
                                    color: ThemeChirho.text-secondary-chirho;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                export-bm-touch-chirho := TouchArea {
                                    clicked => {
                                        AppStateChirho.export-bookmarks-chirho();
                                    }
                                    mouse-cursor: pointer;
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 28px;
                                background: export-notes-touch-chirho.has-hover ? ThemeChirho.background-elevated-chirho : ThemeChirho.background-tertiary-chirho;
                                border-radius: ThemeChirho.radius-sm-chirho;
                                border-width: 1px;
                                border-color: ThemeChirho.border-subtle-chirho;

                                Text {
                                    text: "📝 Notes";
                                    font-size: 11px;
                                    color: ThemeChirho.text-secondary-chirho;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                export-notes-touch-chirho := TouchArea {
                                    clicked => {
                                        AppStateChirho.export-notes-chirho();
                                    }
                                    mouse-cursor: pointer;
                                }
                            }
                        }

                        // Import button
                        HorizontalLayout {
                            spacing: ThemeChirho.spacing-sm-chirho;
                            height: 36px;

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 32px;
                                background: import-touch-chirho.has-hover ? ThemeChirho.background-elevated-chirho : ThemeChirho.background-tertiary-chirho;
                                border-radius: ThemeChirho.radius-md-chirho;
                                border-width: 1px;
                                border-color: ThemeChirho.border-chirho;

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    Text {
                                        text: "📥";
                                        font-size: 14px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "Import from Backup";
                                        font-size: ThemeChirho.font-size-sm-chirho;
                                        font-weight: 500;
                                        color: ThemeChirho.text-primary-chirho;
                                        vertical-alignment: center;
                                    }
                                }

                                import-touch-chirho := TouchArea {
                                    clicked => {
                                        AppStateChirho.load-backup-files-chirho();
                                        AppStateChirho.import-dialog-visible-chirho = true;
                                    }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: ThemeChirho.divider-chirho;
                    }

                    // Accessibility Section
                    VerticalLayout {
                        spacing: ThemeChirho.spacing-sm-chirho;

                        Text {
                            text: "Accessibility";
                            font-size: ThemeChirho.font-size-sm-chirho;
                            font-weight: 600;
                            color: ThemeChirho.text-muted-chirho;
                        }

                        // Reduce Motion toggle
                        HorizontalLayout {
                            spacing: ThemeChirho.spacing-md-chirho;
                            height: 40px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                alignment: center;

                                Text {
                                    text: "Reduce Motion";
                                    font-size: ThemeChirho.font-size-md-chirho;
                                    color: ThemeChirho.text-primary-chirho;
                                }
                                Text {
                                    text: "Minimize animations for motion sensitivity";
                                    font-size: ThemeChirho.font-size-xs-chirho;
                                    color: ThemeChirho.text-muted-chirho;
                                }
                            }

                            Rectangle {
                                width: 50px;
                                height: 26px;
                                background: ThemeChirho.reduce-motion-chirho ? ThemeChirho.accent-chirho : ThemeChirho.background-tertiary-chirho;
                                border-radius: 13px;
                                border-width: 1px;
                                border-color: ThemeChirho.border-chirho;

                                Rectangle {
                                    x: ThemeChirho.reduce-motion-chirho ? 26px : 2px;
                                    y: 2px;
                                    width: 22px;
                                    height: 22px;
                                    background: white;
                                    border-radius: 11px;

                                    // Note: This animation respects its own setting
                                    animate x { duration: ThemeChirho.animation-normal-chirho; easing: ease-out; }
                                }

                                TouchArea {
                                    clicked => {
                                        ThemeChirho.reduce-motion-chirho = !ThemeChirho.reduce-motion-chirho;
                                    }
                                    mouse-cursor: pointer;
                                }
                            }
                        }

                        // Focus Indicators toggle
                        HorizontalLayout {
                            spacing: ThemeChirho.spacing-md-chirho;
                            height: 40px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                alignment: center;

                                Text {
                                    text: "Focus Indicators";
                                    font-size: ThemeChirho.font-size-md-chirho;
                                    color: ThemeChirho.text-primary-chirho;
                                }
                                Text {
                                    text: "Show visible focus ring for keyboard navigation";
                                    font-size: ThemeChirho.font-size-xs-chirho;
                                    color: ThemeChirho.text-muted-chirho;
                                }
                            }

                            Rectangle {
                                width: 50px;
                                height: 26px;
                                background: ThemeChirho.focus-visible-chirho ? ThemeChirho.accent-chirho : ThemeChirho.background-tertiary-chirho;
                                border-radius: 13px;
                                border-width: 1px;
                                border-color: ThemeChirho.border-chirho;

                                Rectangle {
                                    x: ThemeChirho.focus-visible-chirho ? 26px : 2px;
                                    y: 2px;
                                    width: 22px;
                                    height: 22px;
                                    background: white;
                                    border-radius: 11px;

                                    animate x { duration: ThemeChirho.animation-normal-chirho; easing: ease-out; }
                                }

                                TouchArea {
                                    clicked => {
                                        ThemeChirho.focus-visible-chirho = !ThemeChirho.focus-visible-chirho;
                                    }
                                    mouse-cursor: pointer;
                                }
                            }
                        }

                        // High contrast reminder
                        HorizontalLayout {
                            spacing: ThemeChirho.spacing-sm-chirho;
                            height: 32px;

                            Text {
                                text: "⬤";
                                font-size: 12px;
                                color: ThemeChirho.theme-index-chirho == 3 ? #ffff00 : ThemeChirho.text-muted-chirho;
                                vertical-alignment: center;
                            }
                            Text {
                                text: ThemeChirho.theme-index-chirho == 3 ? "High Contrast mode is enabled" : "Use Ctrl+T or Theme setting for High Contrast";
                                font-size: ThemeChirho.font-size-sm-chirho;
                                color: ThemeChirho.theme-index-chirho == 3 ? ThemeChirho.text-primary-chirho : ThemeChirho.text-muted-chirho;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: ThemeChirho.divider-chirho;
                    }

                    // About Section
                    VerticalLayout {
                        spacing: ThemeChirho.spacing-sm-chirho;

                        Text {
                            text: "About";
                            font-size: ThemeChirho.font-size-sm-chirho;
                            font-weight: 600;
                            color: ThemeChirho.text-muted-chirho;
                        }

                        Text {
                            text: "Codex Lux Chirho v0.1.4";
                            font-size: ThemeChirho.font-size-md-chirho;
                            color: ThemeChirho.text-primary-chirho;
                        }

                        Text {
                            text: "A cross-platform Bible study application";
                            font-size: ThemeChirho.font-size-sm-chirho;
                            color: ThemeChirho.text-secondary-chirho;
                        }

                        Text {
                            text: "Built with Rust + Slint + rsword_chirho";
                            font-size: ThemeChirho.font-size-sm-chirho;
                            color: ThemeChirho.text-muted-chirho;
                        }
                    }
                }
            }
        }
    }

    // Close when clicking outside
    TouchArea {
        enabled: visible-chirho;
        clicked => {
            root.visible-chirho = false;
        }
    }
}

// Goto verse dialog component
component GotoDialogChirho inherits Rectangle {
    in-out property <bool> visible-chirho: false;

    width: 100%;
    height: 100%;
    background: visible-chirho ? #00000080 : transparent;

    animate background { duration: ThemeChirho.animation-normal-chirho; }

    if visible-chirho: Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 360px;
        height: 140px;
        background: ThemeChirho.background-secondary-chirho;
        border-radius: ThemeChirho.radius-lg-chirho;
        border-width: 1px;
        border-color: ThemeChirho.border-chirho;
        drop-shadow-blur: 20px;
        drop-shadow-color: #00000040;

        VerticalLayout {
            padding: ThemeChirho.spacing-lg-chirho;
            spacing: ThemeChirho.spacing-md-chirho;

            HorizontalLayout {
                Text {
                    text: "Go to Verse";
                    font-size: ThemeChirho.font-size-lg-chirho;
                    font-weight: 600;
                    color: ThemeChirho.text-primary-chirho;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                IconButtonChirho {
                    icon-chirho: LabelsChirho.close-icon-chirho;
                    clicked-chirho => {
                        AppStateChirho.goto-dialog-visible-chirho = false;
                    }
                }
            }

            HorizontalLayout {
                spacing: ThemeChirho.spacing-sm-chirho;

                LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: "e.g., John 3:16 or Gen 1:1";
                    text <=> AppStateChirho.goto-reference-chirho;
                    accepted => {
                        AppStateChirho.goto-verse-chirho(AppStateChirho.goto-reference-chirho);
                        AppStateChirho.goto-dialog-visible-chirho = false;
                    }
                }

                Rectangle {
                    width: 60px;
                    height: 36px;
                    background: ThemeChirho.accent-chirho;
                    border-radius: ThemeChirho.radius-md-chirho;

                    Text {
                        text: "Go";
                        font-size: ThemeChirho.font-size-md-chirho;
                        font-weight: 500;
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => {
                            AppStateChirho.goto-verse-chirho(AppStateChirho.goto-reference-chirho);
                            AppStateChirho.goto-dialog-visible-chirho = false;
                        }
                        mouse-cursor: pointer;
                    }
                }
            }
        }
    }

    // Close when clicking outside
    TouchArea {
        enabled: visible-chirho;
        clicked => {
            root.visible-chirho = false;
        }
    }
}

// Chapter grid selector dialog
component ChapterSelectorChirho inherits Rectangle {
    in-out property <bool> visible-chirho: false;

    width: 100%;
    height: 100%;
    background: visible-chirho ? #00000080 : transparent;

    animate background { duration: ThemeChirho.animation-normal-chirho; }

    if visible-chirho: Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 400px;
        height: 360px;
        background: ThemeChirho.background-secondary-chirho;
        border-radius: ThemeChirho.radius-lg-chirho;
        border-width: 1px;
        border-color: ThemeChirho.border-chirho;
        drop-shadow-blur: 20px;
        drop-shadow-color: #00000040;

        VerticalLayout {
            padding: ThemeChirho.spacing-lg-chirho;
            spacing: ThemeChirho.spacing-md-chirho;

            HorizontalLayout {
                Text {
                    text: AppStateChirho.current-book-chirho + " - Select Chapter";
                    font-size: ThemeChirho.font-size-lg-chirho;
                    font-weight: 600;
                    color: ThemeChirho.text-primary-chirho;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                IconButtonChirho {
                    icon-chirho: LabelsChirho.close-icon-chirho;
                    clicked-chirho => {
                        AppStateChirho.chapter-selector-visible-chirho = false;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: ThemeChirho.divider-chirho;
            }

            ScrollView {
                vertical-stretch: 1;

                // Grid of chapter buttons (10 per row)
                VerticalLayout {
                    spacing: 6px;

                    for row-chirho in 16: HorizontalLayout {
                        spacing: 6px;

                        for col-chirho in 10: Rectangle {
                            property <int> chapter-num-chirho: row-chirho * 10 + col-chirho + 1;
                            property <bool> is-valid-chirho: chapter-num-chirho <= AppStateChirho.current-book-chapter-count-chirho;
                            property <bool> is-current-chirho: chapter-num-chirho == AppStateChirho.current-chapter-chirho;

                            width: 32px;
                            height: 32px;
                            background: !is-valid-chirho ? transparent :
                                (is-current-chirho ? ThemeChirho.accent-chirho :
                                (ch-touch-chirho.has-hover ? ThemeChirho.background-elevated-chirho : ThemeChirho.background-tertiary-chirho));
                            border-radius: ThemeChirho.radius-sm-chirho;
                            border-width: is-valid-chirho ? 1px : 0px;
                            border-color: is-current-chirho ? ThemeChirho.accent-chirho : ThemeChirho.border-subtle-chirho;

                            if is-valid-chirho: Text {
                                text: chapter-num-chirho;
                                font-size: ThemeChirho.font-size-sm-chirho;
                                font-weight: is-current-chirho ? 600 : 400;
                                color: is-current-chirho ? white : ThemeChirho.text-primary-chirho;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            ch-touch-chirho := TouchArea {
                                enabled: is-valid-chirho;
                                clicked => {
                                    AppStateChirho.navigate-to-chirho(
                                        AppStateChirho.current-book-chirho,
                                        chapter-num-chirho,
                                        1
                                    );
                                    AppStateChirho.chapter-selector-visible-chirho = false;
                                }
                                mouse-cursor: is-valid-chirho ? pointer : default;
                            }
                        }
                    }
                }
            }
        }
    }

    // Close when clicking outside
    TouchArea {
        enabled: visible-chirho;
        clicked => {
            root.visible-chirho = false;
        }
    }
}

// Note editor dialog component
component NoteDialogChirho inherits Rectangle {
    in-out property <bool> visible-chirho: false;

    width: 100%;
    height: 100%;
    background: visible-chirho ? #00000080 : transparent;

    animate background { duration: ThemeChirho.animation-normal-chirho; }

    if visible-chirho: Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 480px;
        height: 320px;
        background: ThemeChirho.background-secondary-chirho;
        border-radius: ThemeChirho.radius-lg-chirho;
        border-width: 1px;
        border-color: ThemeChirho.border-chirho;
        drop-shadow-blur: 20px;
        drop-shadow-color: #00000040;

        VerticalLayout {
            padding: ThemeChirho.spacing-lg-chirho;
            spacing: ThemeChirho.spacing-md-chirho;

            HorizontalLayout {
                Text {
                    text: "Note - " + AppStateChirho.note-verse-ref-chirho;
                    font-size: ThemeChirho.font-size-lg-chirho;
                    font-weight: 600;
                    color: ThemeChirho.text-primary-chirho;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                IconButtonChirho {
                    icon-chirho: LabelsChirho.close-icon-chirho;
                    clicked-chirho => {
                        AppStateChirho.note-dialog-visible-chirho = false;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: ThemeChirho.divider-chirho;
            }

            // Note text area
            Rectangle {
                vertical-stretch: 1;
                background: ThemeChirho.background-tertiary-chirho;
                border-radius: ThemeChirho.radius-md-chirho;
                border-width: 1px;
                border-color: ThemeChirho.border-subtle-chirho;

                VerticalLayout {
                    padding: ThemeChirho.spacing-md-chirho;

                    LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "Enter your note here...";
                        text <=> AppStateChirho.note-content-chirho;
                    }
                }
            }

            HorizontalLayout {
                spacing: ThemeChirho.spacing-md-chirho;
                alignment: end;

                // Delete button
                Rectangle {
                    width: 80px;
                    height: 36px;
                    background: delete-touch-chirho.has-hover ? ThemeChirho.error-chirho : ThemeChirho.background-tertiary-chirho;
                    border-radius: ThemeChirho.radius-md-chirho;
                    border-width: 1px;
                    border-color: ThemeChirho.error-chirho;

                    Text {
                        text: "Delete";
                        font-size: ThemeChirho.font-size-md-chirho;
                        font-weight: 500;
                        color: delete-touch-chirho.has-hover ? white : ThemeChirho.error-chirho;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    delete-touch-chirho := TouchArea {
                        clicked => {
                            AppStateChirho.note-content-chirho = "";
                            AppStateChirho.save-note-chirho(AppStateChirho.note-verse-ref-chirho, "");
                            AppStateChirho.note-dialog-visible-chirho = false;
                        }
                        mouse-cursor: pointer;
                    }
                }

                // Save button
                Rectangle {
                    width: 80px;
                    height: 36px;
                    background: ThemeChirho.accent-chirho;
                    border-radius: ThemeChirho.radius-md-chirho;

                    Text {
                        text: "Save";
                        font-size: ThemeChirho.font-size-md-chirho;
                        font-weight: 500;
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => {
                            AppStateChirho.save-note-chirho(AppStateChirho.note-verse-ref-chirho, AppStateChirho.note-content-chirho);
                            AppStateChirho.note-dialog-visible-chirho = false;
                        }
                        mouse-cursor: pointer;
                    }
                }
            }
        }
    }

    // Close when clicking outside
    TouchArea {
        enabled: visible-chirho;
        clicked => {
            root.visible-chirho = false;
        }
    }
}

// Import Dialog - select backup to restore
component ImportDialogChirho inherits Rectangle {
    in-out property <bool> visible-chirho <=> AppStateChirho.import-dialog-visible-chirho;

    width: 100%;
    height: 100%;
    background: visible-chirho ? #00000080 : transparent;

    animate background { duration: ThemeChirho.animation-normal-chirho; }

    if visible-chirho: Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 420px;
        height: min(400px, 100px + AppStateChirho.backup-files-chirho.length * 50px);
        background: ThemeChirho.background-secondary-chirho;
        border-radius: ThemeChirho.radius-lg-chirho;
        border-width: 1px;
        border-color: ThemeChirho.border-chirho;
        drop-shadow-blur: 20px;
        drop-shadow-color: #00000040;

        VerticalLayout {
            padding: ThemeChirho.spacing-lg-chirho;
            spacing: ThemeChirho.spacing-md-chirho;

            // Header
            HorizontalLayout {
                height: 32px;
                spacing: ThemeChirho.spacing-sm-chirho;

                Text {
                    text: "📥 Import from Backup";
                    font-size: ThemeChirho.font-size-lg-chirho;
                    font-weight: 700;
                    color: ThemeChirho.text-primary-chirho;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                IconButtonChirho {
                    icon-chirho: LabelsChirho.close-icon-chirho;
                    clicked-chirho => {
                        AppStateChirho.import-dialog-visible-chirho = false;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: ThemeChirho.divider-chirho;
            }

            // Backup files list
            if AppStateChirho.backup-files-chirho.length == 0: VerticalLayout {
                alignment: center;
                vertical-stretch: 1;
                spacing: ThemeChirho.spacing-md-chirho;

                Text {
                    text: "📂";
                    font-size: 48px;
                    horizontal-alignment: center;
                }
                Text {
                    text: "No backup files found";
                    font-size: ThemeChirho.font-size-md-chirho;
                    color: ThemeChirho.text-secondary-chirho;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Export your data first to create a backup";
                    font-size: ThemeChirho.font-size-sm-chirho;
                    color: ThemeChirho.text-muted-chirho;
                    horizontal-alignment: center;
                }
            }

            if AppStateChirho.backup-files-chirho.length > 0: ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: ThemeChirho.spacing-xs-chirho;

                    for backup-file-chirho in AppStateChirho.backup-files-chirho: Rectangle {
                        height: 44px;
                        background: backup-touch-chirho.has-hover ? ThemeChirho.background-elevated-chirho : ThemeChirho.background-tertiary-chirho;
                        border-radius: ThemeChirho.radius-md-chirho;

                        animate background { duration: ThemeChirho.animation-fast-chirho; }

                        HorizontalLayout {
                            padding: ThemeChirho.spacing-md-chirho;
                            spacing: ThemeChirho.spacing-sm-chirho;

                            Text {
                                text: "📄";
                                font-size: 16px;
                                vertical-alignment: center;
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: backup-file-chirho;
                                    font-size: ThemeChirho.font-size-sm-chirho;
                                    color: ThemeChirho.text-primary-chirho;
                                    overflow: elide;
                                }
                            }

                            Text {
                                text: "→";
                                font-size: 16px;
                                color: ThemeChirho.text-muted-chirho;
                                vertical-alignment: center;
                            }
                        }

                        backup-touch-chirho := TouchArea {
                            clicked => {
                                AppStateChirho.import-data-chirho(backup-file-chirho);
                                AppStateChirho.import-dialog-visible-chirho = false;
                            }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }
        }
    }

    // Close when clicking outside
    TouchArea {
        enabled: visible-chirho;
        clicked => {
            AppStateChirho.import-dialog-visible-chirho = false;
        }
    }
}

// Verse of the Day Dialog - Daily devotional display
component VotdDialogChirho inherits Rectangle {
    in-out property <bool> visible-chirho <=> AppStateChirho.votd-dialog-visible-chirho;

    width: 100%;
    height: 100%;
    background: visible-chirho ? #00000080 : transparent;

    animate background { duration: ThemeChirho.animation-normal-chirho; }

    if visible-chirho: Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 500px;
        height: 320px;
        background: ThemeChirho.background-secondary-chirho;
        border-radius: ThemeChirho.radius-lg-chirho;
        border-width: 1px;
        border-color: ThemeChirho.border-chirho;
        drop-shadow-blur: 20px;
        drop-shadow-color: #00000040;

        VerticalLayout {
            padding: ThemeChirho.spacing-xl-chirho;
            spacing: ThemeChirho.spacing-lg-chirho;
            alignment: center;

            // Header with sunrise icon
            HorizontalLayout {
                height: 40px;
                spacing: ThemeChirho.spacing-md-chirho;
                alignment: center;

                Text {
                    text: "Vd";
                    font-size: 32px;
                    vertical-alignment: center;
                }

                Text {
                    text: "Verse of the Day";
                    font-size: ThemeChirho.font-size-xl-chirho;
                    font-weight: 700;
                    color: ThemeChirho.text-primary-chirho;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                IconButtonChirho {
                    icon-chirho: LabelsChirho.close-icon-chirho;
                    clicked-chirho => {
                        AppStateChirho.votd-dialog-visible-chirho = false;
                    }
                }
            }

            // Date
            Text {
                text: AppStateChirho.votd-date-chirho;
                font-size: ThemeChirho.font-size-sm-chirho;
                color: ThemeChirho.text-muted-chirho;
                horizontal-alignment: center;
            }

            Rectangle {
                height: 1px;
                background: ThemeChirho.divider-chirho;
            }

            // Verse text with decorative quotes
            VerticalLayout {
                vertical-stretch: 1;
                alignment: center;
                spacing: ThemeChirho.spacing-md-chirho;

                Text {
                    text: "❝";
                    font-size: 24px;
                    color: ThemeChirho.accent-chirho;
                    horizontal-alignment: center;
                }

                Text {
                    text: AppStateChirho.votd-text-chirho;
                    font-size: ThemeChirho.font-size-lg-chirho * AppStateChirho.font-scale-chirho;
                    font-family: AppStateChirho.font-family-index-chirho == 1 ? "Georgia, Times New Roman, serif" :
                                 AppStateChirho.font-family-index-chirho == 2 ? "Helvetica, Arial, sans-serif" :
                                 "system-ui";
                    color: ThemeChirho.text-primary-chirho;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                Text {
                    text: "— " + AppStateChirho.votd-reference-chirho;
                    font-size: ThemeChirho.font-size-md-chirho;
                    font-weight: 600;
                    color: ThemeChirho.accent-chirho;
                    horizontal-alignment: center;
                }
            }

            // Action buttons
            HorizontalLayout {
                height: 40px;
                spacing: ThemeChirho.spacing-md-chirho;
                alignment: center;

                // Copy button
                Rectangle {
                    width: 100px;
                    height: 36px;
                    background: copy-touch-chirho.has-hover ? ThemeChirho.accent-hover-chirho : ThemeChirho.background-elevated-chirho;
                    border-radius: ThemeChirho.radius-md-chirho;
                    border-width: 1px;
                    border-color: ThemeChirho.border-chirho;

                    Text {
                        text: "Cp Copy";
                        font-size: ThemeChirho.font-size-sm-chirho;
                        color: ThemeChirho.text-secondary-chirho;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    copy-touch-chirho := TouchArea {
                        clicked => {
                            AppStateChirho.copy-verse-chirho(AppStateChirho.votd-reference-chirho, AppStateChirho.votd-text-chirho);
                        }
                        mouse-cursor: pointer;
                    }
                }

                // Go to verse button
                Rectangle {
                    width: 120px;
                    height: 36px;
                    background: goto-touch-chirho.has-hover ? ThemeChirho.accent-hover-chirho : ThemeChirho.accent-chirho;
                    border-radius: ThemeChirho.radius-md-chirho;

                    Text {
                        text: "Read in Context";
                        font-size: ThemeChirho.font-size-sm-chirho;
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    goto-touch-chirho := TouchArea {
                        clicked => {
                            AppStateChirho.goto-votd-chirho();
                            AppStateChirho.votd-dialog-visible-chirho = false;
                        }
                        mouse-cursor: pointer;
                    }
                }
            }
        }
    }

    // Close when clicking outside
    TouchArea {
        enabled: visible-chirho;
        clicked => {
            AppStateChirho.votd-dialog-visible-chirho = false;
        }
    }
}

